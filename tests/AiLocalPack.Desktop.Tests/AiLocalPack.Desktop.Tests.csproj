<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <!-- build/ThirdPartyNotices.cs without its MSBuild task: the notices writer only -->
        <DefineConstants>$(DefineConstants);NOTICES_WRITER_ONLY</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="..\..\build\ThirdPartyNotices.cs" Link="Build\ThirdPartyNotices.cs" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia.Headless" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\src\AiLocalPack.Desktop\Styles\Theme.axaml;..\..\src\AiLocalPack.Desktop\Styles\BrandIcons.axaml"
              LinkBase="styles" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\AiLocalPack.Desktop\AiLocalPack.Desktop.csproj" />
    </ItemGroup>
</Project>
