<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <AssemblyName>ailocalpack</AssemblyName>
        <Description>Command-line entry point: pack validation for registry CI, game discovery for manual checks.</Description>
    </PropertyGroup>

    <!-- Released as one self-contained file per OS (dotnet publish -r linux-x64 -c Release): registry CI downloads and runs it, no .NET needed. -->
    <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
        <SelfContained>true</SelfContained>
        <PublishSingleFile>true</PublishSingleFile>
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="System.CommandLine" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\AiLocalPack.Core\AiLocalPack.Core.csproj" />
        <ProjectReference Include="..\AiLocalPack.Toolkit\AiLocalPack.Toolkit.csproj" />
        <ProjectReference Include="..\AiLocalPack.Mcp\AiLocalPack.Mcp.csproj" />
    </ItemGroup>
</Project>
