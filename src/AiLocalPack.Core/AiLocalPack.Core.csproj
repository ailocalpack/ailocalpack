<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Description>Domain model: games, identity, packs, registry, install.</Description>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
        <!-- Linux keychain: the Secret Service over D-Bus (task 58), the library Avalonia uses on Linux. -->
        <PackageReference Include="Tmds.DBus.Protocol" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="AntiCheat/anti-cheat.json" LogicalName="AiLocalPack.Core.AntiCheat.anti-cheat.json" />
        <EmbeddedResource Include="Fonts/fonts.json" LogicalName="AiLocalPack.Core.Fonts.fonts.json" />
        <!-- Whitelisted OFL fonts shipped inside the app (task 31); the CJK ones are downloaded on demand. -->
        <EmbeddedResource Include="Fonts/Files/*.ttf;Fonts/Files/*.otf" LogicalName="AiLocalPack.Core.Fonts.Files.%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="AiLocalPack.Core.Tests" />
        <!-- The resumable verified download (VerifiedDownloader) for agent installs (task 43). -->
        <InternalsVisibleTo Include="AiLocalPack.Agents" />
        <!-- Install crash simulation hooks (PackInstaller) for the start-up recovery tests. -->
        <InternalsVisibleTo Include="AiLocalPack.Desktop.Tests" />
    </ItemGroup>
</Project>
