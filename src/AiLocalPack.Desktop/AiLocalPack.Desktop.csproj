<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <AssemblyName>AiLocalPack</AssemblyName>
        <Description>Avalonia desktop app.</Description>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
        <!-- OS notifications call the Objective-C runtime (macOS) and WinRT (Windows) through function pointers. -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <!-- English strings live in the main assembly (Strings.resx); other languages in satellite assemblies. -->
        <NeutralLanguage>en</NeutralLanguage>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" />
        <PackageReference Include="Avalonia.Desktop" />
        <PackageReference Include="Avalonia.Fonts.Inter" />
        <PackageReference Include="Avalonia.Themes.Fluent" />
        <PackageReference Include="CommunityToolkit.Mvvm" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
        <PackageReference Include="Microsoft.Extensions.Logging" />
        <PackageReference Include="Serilog" />
        <PackageReference Include="Serilog.Extensions.Logging" />
        <PackageReference Include="Serilog.Sinks.File" />
        <PackageReference Include="Tmds.DBus.Protocol" />
    </ItemGroup>

    <!-- UI strings: Strings.resx (English, neutral) + Strings.<lang>.resx. The build generates the typed Strings class. -->
    <ItemGroup>
        <EmbeddedResource Update="Resources\Strings.resx">
            <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
            <StronglyTypedNamespace>AiLocalPack.Desktop.Resources</StronglyTypedNamespace>
            <StronglyTypedClassName>Strings</StronglyTypedClassName>
            <StronglyTypedFileName>$(IntermediateOutputPath)Strings.Designer.cs</StronglyTypedFileName>
            <PublicClass>false</PublicClass>
        </EmbeddedResource>
    </ItemGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets\**" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="AiLocalPack.Desktop.Tests" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\AiLocalPack.Core\AiLocalPack.Core.csproj" />
        <ProjectReference Include="..\AiLocalPack.Toolkit\AiLocalPack.Toolkit.csproj" />
        <ProjectReference Include="..\AiLocalPack.Agents\AiLocalPack.Agents.csproj" />
        <ProjectReference Include="..\AiLocalPack.Mcp\AiLocalPack.Mcp.csproj" />
        <ProjectReference Include="..\AiLocalPack.Pipeline\AiLocalPack.Pipeline.csproj" />
    </ItemGroup>
</Project>
