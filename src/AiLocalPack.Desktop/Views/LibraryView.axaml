<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AiLocalPack.Desktop.ViewModels"
             xmlns:lib="using:AiLocalPack.Desktop.ViewModels.Library"
             xmlns:views="using:AiLocalPack.Desktop.Views"
             xmlns:l="using:AiLocalPack.Desktop.Localization"
             xmlns:set="using:AiLocalPack.Desktop.ViewModels.Settings"
             x:Class="AiLocalPack.Desktop.Views.LibraryView"
             x:DataType="vm:LibraryViewModel">
    <!-- Design §1: toolbar (translate-to language, search, sort, + Folder) and status filter chips over a responsive
         cover grid; scanning, registry offline, empty and no-results states.
         A folder dragged over the library shows a dashed drop zone; dropping it opens the add-folder dialog (design §2). -->
    <Panel x:Name="DropTarget" DragDrop.AllowDrop="True">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="24,16,24,12" Spacing="12">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
            <ComboBox x:Name="LanguageBox" Classes="toolbar" ItemsSource="{Binding LanguageOptions}" SelectedItem="{Binding SelectedLanguage}"
                      AutomationProperties.Name="{l:Loc Library_Language_Label}" ToolTip.Tip="{l:Loc Library_Language_Tip}">
                <ComboBox.SelectionBoxItemTemplate>
                    <DataTemplate x:DataType="set:ChoiceOption">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Viewbox Classes="icon" Width="16" Height="16">
                                <Path Classes="icon" Data="{StaticResource IconGlobe}" Stroke="{DynamicResource AppMutedBrush}" />
                            </Viewbox>
                            <TextBlock Text="{l:Loc Library_Language_Label}" Foreground="{DynamicResource AppMutedBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Display}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.SelectionBoxItemTemplate>
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="set:ChoiceOption">
                        <TextBlock Text="{Binding Display}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBox x:Name="SearchBox" Grid.Column="1" Classes="search" MaxWidth="520" HorizontalAlignment="Stretch"
                     Text="{Binding Query}" PlaceholderText="{l:Loc Library_Search_Placeholder}"
                     AutomationProperties.Name="{l:Loc Library_Search_Placeholder}">
                <TextBox.InnerLeftContent>
                    <Viewbox Classes="icon" Width="16" Height="16" Margin="10,0,0,0">
                        <Path Classes="icon" Data="{StaticResource IconSearch}" Stroke="{DynamicResource AppMutedBrush}" />
                    </Viewbox>
                </TextBox.InnerLeftContent>
                <TextBox.InnerRightContent>
                    <Border Classes="kbd"><TextBlock Text="{x:Static vm:LibraryViewModel.SearchShortcut}" /></Border>
                </TextBox.InnerRightContent>
            </TextBox>
            <ComboBox x:Name="SortBox" Grid.Column="2" Classes="toolbar" MinWidth="190"
                      ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}"
                      AutomationProperties.Name="{l:Loc Library_Sort_Label}" ToolTip.Tip="{l:Loc Library_Sort_Label}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="lib:LibrarySortOption">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Viewbox Classes="icon" Width="14" Height="14">
                                <Path Classes="icon" Data="{StaticResource IconSort}" Stroke="{DynamicResource AppMutedBrush}" />
                            </Viewbox>
                            <TextBlock Text="{Binding Display}" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button x:Name="AddFolderButton" Grid.Column="3" Classes="ghost" Command="{Binding AddFolderCommand}"
                    ToolTip.Tip="{l:Loc Library_AddFolder_Tip}" AutomationProperties.Name="{l:Loc Library_AddFolder_Tip}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Viewbox Classes="icon" Width="16" Height="16">
                        <Path Classes="icon" Data="{StaticResource IconFolderPlus}" Stroke="{Binding $parent[Button].Foreground}" />
                    </Viewbox>
                    <TextBlock Text="{l:Loc Library_AddFolder}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>
        <ItemsControl x:Name="FilterChips" ItemsSource="{Binding FilterChips}" IsVisible="{Binding ShowFilters}"
                      AutomationProperties.Name="{l:Loc Library_Filter_Label}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel ItemSpacing="6" LineSpacing="6" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="lib:LibraryFilterChip">
                    <Button Classes="chip" Classes.on="{Binding IsSelected}" Command="{Binding SelectCommand}"
                            AutomationProperties.Name="{Binding AccessibleName}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                            <TextBlock Classes="count" Text="{Binding CountText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        </StackPanel>

        <ScrollViewer x:Name="Scroller">
            <StackPanel Margin="24,0,24,32" Spacing="16">
                <Border x:Name="ScanBanner" Classes="banner" IsVisible="{Binding IsScanning}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Viewbox Classes="icon" Width="16" Height="16">
                            <Path Classes="icon" Data="{StaticResource IconLoader}" Stroke="{DynamicResource AppAccentBrush}" />
                        </Viewbox>
                        <TextBlock Text="{l:Loc Library_Scanning}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border x:Name="CatalogDamagedBanner" Classes="banner warn" IsVisible="{Binding ShowCatalogDamaged}">
                    <DockPanel>
                        <Viewbox DockPanel.Dock="Left" Classes="icon" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center">
                            <Path Classes="icon" Data="{StaticResource IconAlert}" Stroke="{DynamicResource AppWarnBrush}" />
                        </Viewbox>
                        <Button DockPanel.Dock="Right" Classes="icon sm" Command="{Binding DismissCatalogDamagedCommand}" Margin="4,0,0,0"
                                ToolTip.Tip="{l:Loc Library_Banner_Dismiss}" AutomationProperties.Name="{l:Loc Library_Banner_Dismiss}">
                            <Path Data="{StaticResource IconX}" />
                        </Button>
                        <Button DockPanel.Dock="Right" Classes="ghost sm" Command="{Binding AddFolderCommand}" Margin="12,0,0,0"
                                Content="{l:Loc Library_Empty_AddFolder}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding CatalogDamagedText}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </DockPanel>
                </Border>

                <Border x:Name="RegistryBanner" Classes="banner warn" IsVisible="{Binding ShowRegistryBanner}">
                    <DockPanel>
                        <Viewbox DockPanel.Dock="Left" Classes="icon" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center">
                            <Path Classes="icon" Data="{StaticResource IconWifiOff}" Stroke="{DynamicResource AppWarnBrush}" />
                        </Viewbox>
                        <Button x:Name="RetryRegistry" DockPanel.Dock="Right" Classes="ghost sm" Command="{Binding RetryRegistryCommand}"
                                IsEnabled="{Binding !IsRetrying}" Margin="12,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Viewbox Classes="icon" Width="14" Height="14">
                                    <Path Classes="icon" Data="{StaticResource IconRefresh}" Stroke="{Binding $parent[Button].Foreground}" />
                                </Viewbox>
                                <TextBlock Text="{l:Loc Library_Registry_Retry}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="RegistryBannerText" Text="{Binding RegistryBannerText}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </DockPanel>
                </Border>

                <ItemsControl x:Name="Skeletons" ItemsSource="{Binding Skeletons}" IsVisible="{Binding ShowSkeletons}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><views:CardGrid /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Spacing="10">
                                <views:AspectBox><Border Classes="skeleton" CornerRadius="12" /></views:AspectBox>
                                <Border Classes="skeleton" Height="14" Width="110" HorizontalAlignment="Left" />
                                <Border Classes="skeleton" Height="10" Width="70" HorizontalAlignment="Left" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl x:Name="Games" ItemsSource="{Binding VisibleCards}" IsVisible="{Binding ShowGrid}"
                              AutomationProperties.Name="{Binding GameCount}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><views:CardGrid /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="lib:GameCardViewModel">
                            <Button Classes="gameCard" Classes.blocked="{Binding IsBlocked}" Classes.dimmed="{Binding IsDimmed}"
                                    Command="{Binding OpenCommand}" AutomationProperties.Name="{Binding AccessibleName}">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{l:Loc Library_Menu_OpenPage}" Command="{Binding OpenCommand}" />
                                        <MenuItem Header="{l:Loc Library_Menu_OpenFolder}" Command="{Binding OpenFolderCommand}" />
                                        <MenuItem Header="{l:Loc Library_Menu_Remove}" Command="{Binding RemoveCommand}" IsVisible="{Binding IsManual}" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <StackPanel Spacing="10">
                                    <views:AspectBox>
                                        <Border Classes="cover" Background="{Binding PlaceholderBrush}">
                                            <Panel>
                                                <TextBlock Classes="coverName" Text="{Binding Name}" IsVisible="{Binding !HasCover}" />
                                                <Image Source="{Binding Cover}" Stretch="UniformToFill" IsVisible="{Binding HasCover}" />
                                                <Image Source="{Binding Icon}" Stretch="Uniform" IsVisible="{Binding HasIcon}"
                                                       Width="72" Height="72" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,40" />
                                                <Viewbox Classes="icon" Width="36" Height="36" IsVisible="{Binding IsBlocked}"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Path Classes="icon" Data="{StaticResource IconLock}" Stroke="#d9ffffff" />
                                                </Viewbox>
                                                <Border Classes="statusBadge" IsVisible="{Binding ShowBadge}" Classes.stale="{Binding IsStale}"
                                                        Classes.ok="{Binding IsToneOk}" Classes.accent="{Binding IsToneAccent}"
                                                        Classes.warn="{Binding IsToneWarn}" Classes.gen="{Binding IsToneGen}" Classes.bad="{Binding IsToneBad}">
                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                        <Viewbox Classes="icon" Width="13" Height="13">
                                                            <Path Classes="icon" Data="{Binding BadgeIcon, Converter={x:Static views:ResourceKeyConverter.Instance}}" />
                                                        </Viewbox>
                                                        <TextBlock Text="{Binding BadgeText}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                                <ProgressBar Classes="coverProgress" Classes.paused="{Binding IsPaused}" Classes.install="{Binding IsInstalling}" IsVisible="{Binding ShowProgress}"
                                                             Minimum="0" Maximum="100" Value="{Binding Percent}" />
                                                <Button Classes="quick" Classes.has="{Binding HasQuickAction}" Classes.primary="{Binding IsQuickPrimary}"
                                                        Classes.warn="{Binding IsQuickWarn}" Classes.gen="{Binding IsQuickGen}"
                                                        Command="{Binding QuickActionCommand}" AutomationProperties.Name="{Binding QuickActionText}">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <Viewbox Classes="icon" Width="14" Height="14">
                                                            <Path Classes="icon" Data="{Binding QuickActionIcon, Converter={x:Static views:ResourceKeyConverter.Instance}}"
                                                                  Stroke="{Binding $parent[Button].Foreground}" />
                                                        </Viewbox>
                                                        <TextBlock Text="{Binding QuickActionText}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                            </Panel>
                                        </Border>
                                    </views:AspectBox>
                                    <StackPanel Spacing="3">
                                        <TextBlock Classes="cardName" Text="{Binding Name}" />
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <StackPanel Orientation="Horizontal" Spacing="3" IsVisible="{Binding ShowLikes}">
                                                <Viewbox Classes="icon" Width="12" Height="12">
                                                    <Path Classes="icon" Data="{StaticResource IconThumbsUp}" Stroke="{DynamicResource AppWarnBrush}" />
                                                </Viewbox>
                                                <TextBlock Classes="cardMeta" Text="{Binding LikesText}" Foreground="{DynamicResource AppWarnBrush}" />
                                            </StackPanel>
                                            <TextBlock Classes="cardMeta" Text="·" Foreground="{DynamicResource AppFaintBrush}" IsVisible="{Binding ShowLikesSeparator}" />
                                            <TextBlock Classes="cardMeta" Text="{Binding ContextLine}" />
                                            <TextBlock Classes="cardMeta" Text="·" Foreground="{DynamicResource AppFaintBrush}" IsVisible="{Binding ShowManualSeparator}" />
                                            <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsManual}">
                                                <Viewbox Classes="icon" Width="12" Height="12">
                                                    <Path Classes="icon" Data="{StaticResource IconHardDrive}" Stroke="{DynamicResource AppMutedBrush}" />
                                                </Viewbox>
                                                <TextBlock Classes="cardMeta" Text="{Binding ManualText}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Steam not found / no games -->
                <StackPanel x:Name="EmptyState" IsVisible="{Binding IsEmpty}"
                            MaxWidth="480" Margin="0,64,0,0" Spacing="12" HorizontalAlignment="Center">
                    <Border Width="72" Height="72" CornerRadius="36" Background="{DynamicResource AppSurface2Brush}" HorizontalAlignment="Center">
                        <Viewbox Classes="icon" Width="32" Height="32">
                            <Path Classes="icon" Data="{StaticResource IconGamepad}" Stroke="{DynamicResource AppMutedBrush}" />
                        </Viewbox>
                    </Border>
                    <TextBlock Classes="h1" Text="{l:Loc Library_Empty_Title}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                    <TextBlock Classes="muted" Text="{l:Loc Library_Empty_Text}" TextAlignment="Center" TextWrapping="Wrap" />
                    <WrapPanel HorizontalAlignment="Center" Margin="0,8,0,0" ItemSpacing="10" LineSpacing="10">
                        <Button x:Name="EmptyAddFolder" Classes="accent" Command="{Binding AddFolderCommand}" Content="{l:Loc Library_Empty_AddFolder}" />
                        <Button x:Name="EmptyLibraries" Classes="ghost" Command="{Binding OpenLibrarySettingsCommand}" Content="{l:Loc Library_Empty_Libraries}" />
                    </WrapPanel>
                </StackPanel>

                <!-- Search hides every game -->
                <StackPanel x:Name="NoResults" IsVisible="{Binding HasNoResults}"
                            MaxWidth="480" Margin="0,64,0,0" Spacing="12" HorizontalAlignment="Center">
                    <Border Width="72" Height="72" CornerRadius="36" Background="{DynamicResource AppSurface2Brush}" HorizontalAlignment="Center">
                        <Viewbox Classes="icon" Width="32" Height="32">
                            <Path Classes="icon" Data="{StaticResource IconSearch}" Stroke="{DynamicResource AppMutedBrush}" />
                        </Viewbox>
                    </Border>
                    <TextBlock Classes="h1" Text="{l:Loc Library_NoResults_Title}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="NoResultsText" Classes="muted" Text="{Binding NoResultsText}" TextAlignment="Center" TextWrapping="Wrap" />
                    <WrapPanel HorizontalAlignment="Center" Margin="0,8,0,0" ItemSpacing="10" LineSpacing="10">
                        <Button x:Name="ResetSearch" Classes="ghost" Command="{Binding ClearSearchCommand}" Content="{l:Loc Library_NoResults_Reset}" />
                        <Button Classes="ghost" Command="{Binding AddFolderCommand}" Content="{l:Loc Library_NoResults_AddFolder}" />
                    </WrapPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>

    <Panel x:Name="DropOverlay" IsVisible="False" Margin="16" IsHitTestVisible="False">
        <Rectangle Classes="dropzone active" />
        <StackPanel Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border Width="72" Height="72" CornerRadius="36" Background="{DynamicResource AppSurfaceBrush}" HorizontalAlignment="Center">
                <Viewbox Classes="icon" Width="32" Height="32">
                    <Path Classes="icon" Data="{StaticResource IconFolderPlus}" Stroke="{DynamicResource AppAccentBrush}" />
                </Viewbox>
            </Border>
            <TextBlock Classes="h1" Text="{l:Loc Library_Drop_Title}" HorizontalAlignment="Center" />
            <TextBlock Classes="muted" Text="{l:Loc Library_Drop_Text}" HorizontalAlignment="Center" />
        </StackPanel>
    </Panel>
    </Panel>
</UserControl>
