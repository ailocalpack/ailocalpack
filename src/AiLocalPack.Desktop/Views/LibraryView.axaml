<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AiLocalPack.Desktop.ViewModels"
             xmlns:l="using:AiLocalPack.Desktop.Localization"
             x:Class="AiLocalPack.Desktop.Views.LibraryView"
             x:DataType="vm:LibraryViewModel">
    <!-- Stub: the cover grid comes in task 11. -->
    <StackPanel Margin="24" Spacing="12">
        <StackPanel Spacing="2">
            <TextBlock Classes="h1" Text="{l:Loc Library_Title}" />
            <TextBlock x:Name="GameCount" Classes="muted" Text="{Binding GameCount}" />
        </StackPanel>
        <ItemsControl x:Name="StubGames" ItemsSource="{Binding Games}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:StubGame">
                    <Button Margin="0,0,12,12" Width="180" Height="100"
                            Content="{Binding Name}"
                            Command="{Binding $parent[ItemsControl].((vm:LibraryViewModel)DataContext).OpenGameCommand}"
                            CommandParameter="{Binding}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
