<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:g="using:AiLocalPack.Desktop.Generation"
             xmlns:l="using:AiLocalPack.Desktop.Localization"
             x:Class="AiLocalPack.Desktop.Views.GenerationCancelDialogView"
             x:DataType="g:GenerationCancelDialogViewModel"
             Width="520">
    <!-- Design §6b: Cancel asks; Keep progress stops the job (resume later), Delete working copy frees the disk. -->
    <Border Classes="dialog">
        <StackPanel Margin="24,22,24,20" Spacing="12">
            <TextBlock x:Name="CancelTitle" Classes="dialogTitle" FontSize="18" Text="{Binding Title}" TextWrapping="Wrap" />
            <TextBlock x:Name="CancelMessage" Classes="muted" Text="{Binding Message}" TextWrapping="Wrap" />
            <WrapPanel HorizontalAlignment="Right" ItemSpacing="8" LineSpacing="8" Margin="0,6,0,0">
                <Button x:Name="BackButton" Classes="ghost" Command="{Binding BackCommand}" Content="{l:Loc Gen_Cancel_Back}" />
                <Button x:Name="DeleteButton" Classes="danger" Command="{Binding DeleteCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Viewbox Classes="icon" Width="16" Height="16">
                            <Path Classes="icon" Data="{StaticResource IconTrash}" Stroke="{Binding $parent[Button].Foreground}" />
                        </Viewbox>
                        <TextBlock Text="{l:Loc Gen_Cancel_Delete}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="KeepButton" Classes="accent" Command="{Binding KeepCommand}" Content="{l:Loc Gen_Cancel_Keep}" />
            </WrapPanel>
        </StackPanel>
    </Border>
</UserControl>
