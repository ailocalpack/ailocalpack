<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AiLocalPack.Desktop.ViewModels.AddGame"
             xmlns:l="using:AiLocalPack.Desktop.Localization"
             x:Class="AiLocalPack.Desktop.Views.AddGameDialogView"
             x:DataType="vm:AddGameDialogViewModel"
             Width="760" MaxHeight="740">
    <!-- Design §2: step 1 (drop zone), analyzing (checklist), one game's summary; several games: scanning, overview,
         one-at-a-time review (the same summary), result. -->
    <UserControl.Styles>
        <!-- Review progress: one segment per game -->
        <Style Selector="Border.segment">
            <Setter Property="Height" Value="5" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Background" Value="{DynamicResource AppSurface3Brush}" />
        </Style>
        <Style Selector="Border.segment.added">
            <Setter Property="Background" Value="{DynamicResource AppOkBrush}" />
        </Style>
        <Style Selector="Border.segment.skipped">
            <Setter Property="Background" Value="{DynamicResource AppFaintBrush}" />
        </Style>
        <Style Selector="Border.segment.current">
            <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
        </Style>
        <!-- Overview cover strip -->
        <Style Selector="StackPanel.stripItem">
            <Setter Property="Width" Value="100" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style Selector="StackPanel.stripItem.skipped">
            <Setter Property="Opacity" Value="0.55" />
        </Style>
        <Style Selector="Border.tally">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{DynamicResource AppSurface2Brush}" />
            <Setter Property="TextElement.FontSize" Value="12" />
            <Setter Property="TextElement.FontWeight" Value="Bold" />
        </Style>
        <Style Selector="Border.tally.bad">
            <Setter Property="Background" Value="{DynamicResource AppBadSoftBrush}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource AppBadBrush}" />
        </Style>
        <Style Selector="Border.tally.inLibrary">
            <Setter Property="Background" Value="{DynamicResource AppAccentSoftBrush}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource AppAccentBrush}" />
        </Style>
    </UserControl.Styles>

    <Border Classes="dialog">
        <DockPanel>
            <!-- Header -->
            <Grid DockPanel.Dock="Top" Margin="16,16,12,8" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                <Button x:Name="AllGamesButton" Classes="ghost" Command="{Binding AllGamesCommand}" IsVisible="{Binding IsReview}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Viewbox Classes="icon" Width="14" Height="14">
                            <Path Classes="icon" Data="{StaticResource IconChevronLeft}" Stroke="{Binding $parent[Button].Foreground}" />
                        </Viewbox>
                        <TextBlock Text="{l:Loc AddGame_Review_AllGames}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <TextBlock x:Name="DialogTitle" Grid.Column="1" Classes="dialogTitle" Text="{Binding Title}" VerticalAlignment="Center"
                           Margin="8,0,0,0" />
                <TextBlock x:Name="StepText" Grid.Column="2" Classes="hint" Text="{Binding StepText}" VerticalAlignment="Center" />
                <Button x:Name="CloseButton" Grid.Column="3" Classes="icon" Command="{Binding CloseCommand}"
                        ToolTip.Tip="{l:Loc AddGame_Close}" AutomationProperties.Name="{l:Loc AddGame_Close}">
                    <Path Data="{StaticResource IconX}" />
                </Button>
            </Grid>

            <!-- Review progress: one segment per game (added / skipped / current) -->
            <ItemsControl x:Name="ReviewProgress" DockPanel.Dock="Top" Margin="22,0,22,6" IsVisible="{Binding IsReview}"
                          ItemsSource="{Binding Queue}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:FolderGameViewModel">
                        <Border Classes="segment" Classes.added="{Binding IsAdded}" Classes.skipped="{Binding IsSkipped}"
                                Classes.current="{Binding IsCurrent}" ToolTip.Tip="{Binding Name}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Footers, one per step -->
            <Border DockPanel.Dock="Bottom" Classes="dialogFooter" IsVisible="{Binding IsPick}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <TextBlock Classes="hint" Text="{l:Loc AddGame_DropHint}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <Button Grid.Column="1" Classes="ghost" Command="{Binding CloseCommand}" Content="{l:Loc AddGame_Cancel}" />
                </Grid>
            </Border>
            <Border DockPanel.Dock="Bottom" Classes="dialogFooter" IsVisible="{Binding IsAnalyzing}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <TextBlock Classes="hint" Text="{l:Loc AddGame_Analyzing_Note}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <Button x:Name="CancelAnalysis" Grid.Column="1" Classes="ghost" Command="{Binding CancelCommand}" Content="{l:Loc AddGame_Cancel}" />
                </Grid>
            </Border>
            <Border DockPanel.Dock="Bottom" Classes="dialogFooter" IsVisible="{Binding IsScanning}">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                    <TextBlock Classes="hint" Text="{Binding ScanFoundText}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <Button x:Name="CancelScan" Grid.Column="1" Classes="ghost" Command="{Binding CancelCommand}" Content="{l:Loc AddGame_Cancel}" />
                    <Button x:Name="StopButton" Grid.Column="2" Classes="accent" Command="{Binding StopCommand}" Content="{l:Loc AddGame_Scanning_Stop}" />
                </Grid>
            </Border>
            <Border DockPanel.Dock="Bottom" Classes="dialogFooter" IsVisible="{Binding IsSummary}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Button x:Name="BackButton" Classes="ghost" Command="{Binding BackCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Viewbox Classes="icon" Width="14" Height="14">
                                <Path Classes="icon" Data="{StaticResource IconUndo}" Stroke="{Binding $parent[Button].Foreground}" />
                            </Viewbox>
                            <TextBlock Text="{l:Loc AddGame_Back}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="PrimaryButton" Grid.Column="2" Classes="accent" Classes.ghost="{Binding IsPrimaryQuiet}"
                            Command="{Binding PrimaryCommand}" Content="{Binding PrimaryText}" />
                </Grid>
            </Border>
            <Border DockPanel.Dock="Bottom" Classes="dialogFooter" IsVisible="{Binding IsOverview}">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                    <Button x:Name="OverviewBackButton" Classes="ghost" Command="{Binding BackCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Viewbox Classes="icon" Width="14" Height="14">
                                <Path Classes="icon" Data="{StaticResource IconUndo}" Stroke="{Binding $parent[Button].Foreground}" />
                            </Viewbox>
                            <TextBlock Text="{l:Loc AddGame_Back}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <TextBlock Grid.Column="2" Classes="hint" Text="{Binding QueueText}" VerticalAlignment="Center" />
                    <Button x:Name="StartButton" Grid.Column="3" Classes="accent" Command="{Binding StartCommand}" IsEnabled="{Binding CanStart}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{l:Loc AddGame_Overview_Start}" VerticalAlignment="Center" />
                            <Viewbox Classes="icon" Width="14" Height="14">
                                <Path Classes="icon" Data="{StaticResource IconChevronRight}" Stroke="{Binding $parent[Button].Foreground}" />
                            </Viewbox>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
            <Border DockPanel.Dock="Bottom" Classes="dialogFooter" IsVisible="{Binding IsReview}">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                    <Button x:Name="PreviousButton" Classes="ghost" Command="{Binding PreviousCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Viewbox Classes="icon" Width="14" Height="14">
                                <Path Classes="icon" Data="{StaticResource IconChevronLeft}" Stroke="{Binding $parent[Button].Foreground}" />
                            </Viewbox>
                            <TextBlock Text="{l:Loc AddGame_Review_Previous}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="SkipButton" Grid.Column="2" Classes="ghost" Command="{Binding SkipCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Viewbox Classes="icon" Width="14" Height="14">
                                <Path Classes="icon" Data="{StaticResource IconSkip}" Stroke="{Binding $parent[Button].Foreground}" />
                            </Viewbox>
                            <TextBlock Text="{l:Loc AddGame_Review_Skip}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ReviewPrimaryButton" Grid.Column="3" Classes="accent" Classes.ghost="{Binding IsPrimaryQuiet}"
                            Command="{Binding PrimaryCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding PrimaryText}" VerticalAlignment="Center" />
                            <Viewbox Classes="icon" Width="14" Height="14">
                                <Path Classes="icon" Data="{StaticResource IconChevronRight}" Stroke="{Binding $parent[Button].Foreground}" />
                            </Viewbox>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
            <Border DockPanel.Dock="Bottom" Classes="dialogFooter" IsVisible="{Binding IsResult}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <TextBlock Classes="hint" Text="{l:Loc AddGame_Result_Note}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <Button x:Name="ToLibraryButton" Grid.Column="1" Classes="accent" Command="{Binding ToLibraryCommand}" Content="{l:Loc AddGame_ToLibrary}" />
                </Grid>
            </Border>

            <ScrollViewer>
                <Panel Margin="24,8,24,20">
                    <!-- Step 1: pick a folder -->
                    <StackPanel x:Name="PickStep" Spacing="14" IsVisible="{Binding IsPick}">
                        <Panel x:Name="DropZone" MinHeight="230" DragDrop.AllowDrop="True">
                            <Rectangle x:Name="DropZoneFrame" Classes="dropzone" />
                            <StackPanel Spacing="10" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="56" Height="56" CornerRadius="28" Background="{DynamicResource AppAccentSoftBrush}" HorizontalAlignment="Center">
                                    <Viewbox Classes="icon" Width="26" Height="26">
                                        <Path Classes="icon" Data="{StaticResource IconFolderPlus}" Stroke="{DynamicResource AppAccentBrush}" />
                                    </Viewbox>
                                </Border>
                                <TextBlock Classes="h2" Text="{l:Loc AddGame_Drop_Title}" HorizontalAlignment="Center" />
                                <TextBlock Classes="muted" Text="{l:Loc AddGame_Drop_Text}" MaxWidth="440" TextAlignment="Center" TextWrapping="Wrap" />
                                <Button x:Name="ChooseFolderButton" Classes="accent" HorizontalAlignment="Center" Margin="0,6,0,0"
                                        Command="{Binding ChooseFolderCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Viewbox Classes="icon" Width="16" Height="16">
                                            <Path Classes="icon" Data="{StaticResource IconFolder}" Stroke="{Binding $parent[Button].Foreground}" />
                                        </Viewbox>
                                        <TextBlock Text="{l:Loc AddGame_ChooseFolder}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Panel>

                        <Border x:Name="PickError" Classes="notice bad" IsVisible="{Binding HasPickError}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Viewbox Classes="icon" VerticalAlignment="Top">
                                    <Path Classes="icon" Data="{StaticResource IconXCircle}" Stroke="{DynamicResource AppBadBrush}" />
                                </Viewbox>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Classes="title" Text="{Binding PickError}" />
                                    <TextBlock Classes="sub" Text="{Binding PickErrorDetail}" IsVisible="{Binding PickErrorDetail, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Expander x:Name="Hint" Header="{l:Loc AddGame_Hint_Title}" IsExpanded="{Binding IsHintOpen}" HorizontalAlignment="Stretch">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{Binding HintShortcut}" TextWrapping="Wrap" />
                                <TextBlock Text="{l:Loc AddGame_Hint_Launchers}" TextWrapping="Wrap" />
                                <TextBlock Text="{l:Loc AddGame_Hint_Steam}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>

                    <!-- Analyzing (one game so far) -->
                    <StackPanel x:Name="AnalyzingStep" Spacing="12" IsVisible="{Binding IsAnalyzing}" Margin="0,12">
                        <Viewbox Classes="icon spin" Width="40" Height="40" HorizontalAlignment="Center">
                            <Viewbox.RenderTransform><RotateTransform /></Viewbox.RenderTransform>
                            <Path Classes="icon" Data="{StaticResource IconLoader}" Stroke="{DynamicResource AppAccentBrush}" />
                        </Viewbox>
                        <TextBlock Classes="h2" Text="{Binding AnalyzingTitle}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                        <TextBlock Classes="hint" Text="{Binding FolderPath}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                        <ItemsControl x:Name="Checklist" ItemsSource="{Binding Steps}" MaxWidth="440" Margin="0,8,0,0" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:AnalysisStepViewModel">
                                    <Border Classes="notice" Margin="0,3">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                            <Panel Width="16" Height="16">
                                                <Viewbox Classes="icon" Width="16" Height="16" IsVisible="{Binding IsDone}">
                                                    <Path Classes="icon" Data="{StaticResource IconCheck}" Stroke="{DynamicResource AppOkBrush}" />
                                                </Viewbox>
                                                <Viewbox Classes="icon spin" Width="16" Height="16" IsVisible="{Binding IsRunning}">
                                                    <Viewbox.RenderTransform><RotateTransform /></Viewbox.RenderTransform>
                                                    <Path Classes="icon" Data="{StaticResource IconLoader}" Stroke="{DynamicResource AppAccentBrush}" />
                                                </Viewbox>
                                                <Viewbox Classes="icon" Width="16" Height="16" IsVisible="{Binding IsWaiting}">
                                                    <Path Classes="icon" Data="{StaticResource IconCircle}" Stroke="{DynamicResource AppFaintBrush}" />
                                                </Viewbox>
                                            </Panel>
                                            <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Classes="sub" Text="{Binding Detail}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Several games: scanning, games stream in -->
                    <StackPanel x:Name="ScanningStep" Spacing="12" IsVisible="{Binding IsScanning}" Margin="0,12">
                        <Viewbox Classes="icon spin" Width="40" Height="40" HorizontalAlignment="Center">
                            <Viewbox.RenderTransform><RotateTransform /></Viewbox.RenderTransform>
                            <Path Classes="icon" Data="{StaticResource IconLoader}" Stroke="{DynamicResource AppAccentBrush}" />
                        </Viewbox>
                        <TextBlock Classes="h2" Text="{Binding ScanningTitle}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                        <TextBlock Classes="hint" Text="{Binding FolderPath}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                        <Border Classes="notice" MaxWidth="520" HorizontalAlignment="Stretch">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <TextBlock x:Name="ScanProgress" Text="{Binding ScanProgressText}" IsVisible="{Binding !IsCheckingGames}" />
                                <TextBlock Grid.Column="1" Classes="sub" Text="{l:Loc AddGame_Scanning_Depth}" IsVisible="{Binding !IsCheckingGames}" />
                                <TextBlock x:Name="CheckingText" Grid.ColumnSpan="2" Text="{Binding CheckingText}" IsVisible="{Binding IsCheckingGames}" />
                            </Grid>
                        </Border>
                        <ItemsControl x:Name="FoundGames" ItemsSource="{Binding FoundGames}" MaxWidth="520" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ScannedGameViewModel">
                                    <Border Classes="notice" Margin="0,3" Padding="14,8">
                                        <Grid ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="10">
                                            <Viewbox Classes="icon" Width="14" Height="14">
                                                <Path Classes="icon" Data="{StaticResource IconCheck}" Stroke="{DynamicResource AppOkBrush}" />
                                            </Viewbox>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="Bold" />
                                            <TextBlock Grid.Column="2" Classes="sub" Text="{Binding Engine}" />
                                            <TextBlock Grid.Column="3" Classes="sub" Text="{Binding Path}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Several games: overview -->
                    <StackPanel x:Name="OverviewStep" Spacing="14" IsVisible="{Binding IsOverview}">
                        <StackPanel Spacing="2">
                            <TextBlock x:Name="OverviewTitle" Classes="h2" Text="{Binding OverviewTitle}" TextWrapping="Wrap" />
                            <TextBlock Classes="hint" Text="{Binding FolderPath}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ItemsControl x:Name="Tally" ItemsSource="{Binding Tally}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel ItemSpacing="6" LineSpacing="6" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:TallyItem">
                                    <Border Classes="tally" Classes.bad="{Binding IsBad}" Classes.inLibrary="{Binding IsInLibrary}">
                                        <TextBlock Text="{Binding Text}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Classes="notice info" IsVisible="{Binding IsSteamLibrary}">
                            <TextBlock Text="{l:Loc AddGame_Overview_Steam}" />
                        </Border>
                        <Border Classes="notice warn" IsVisible="{Binding WasLimitReached}">
                            <TextBlock Text="{l:Loc AddGame_Overview_TooLarge}" />
                        </Border>
                        <Border x:Name="StoppedNotice" Classes="notice" IsVisible="{Binding WasStopped}">
                            <TextBlock Text="{l:Loc AddGame_Overview_Stopped}" />
                        </Border>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="CoverStrip" ItemsSource="{Binding Games}" Margin="0,0,0,10" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="12" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:FolderGameViewModel">
                                        <StackPanel Classes="stripItem" Classes.skipped="{Binding !IsReviewable}" Spacing="5"
                                                    AutomationProperties.Name="{Binding Name}">
                                            <Border Width="100" Height="150" CornerRadius="10" ClipToBounds="True">
                                                <Panel>
                                                    <Border Background="{StaticResource AppLogoBrush}" Opacity="0.85" />
                                                    <Image Source="{Binding CoverArt}" Stretch="UniformToFill" IsVisible="{Binding HasCoverArt}" />
                                                    <Image Source="{Binding CoverIcon}" Stretch="Uniform" Width="48" Height="48" IsVisible="{Binding HasCoverIcon}" />
                                                    <Border Margin="6" MinWidth="22" Height="22" CornerRadius="11" Padding="7,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                            Background="{DynamicResource AppAccentBrush}" IsVisible="{Binding HasNumber}">
                                                        <TextBlock Text="{Binding Number}" Foreground="White" FontSize="12" FontWeight="ExtraBold"
                                                                   VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                    </Border>
                                                </Panel>
                                            </Border>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Classes="hint" Text="{Binding StatusText}" FontSize="11"
                                                       Foreground="{DynamicResource AppBadBrush}" IsVisible="{Binding IsBlocked}" />
                                            <TextBlock Classes="hint" Text="{Binding StatusText}" FontSize="11" IsVisible="{Binding !IsBlocked}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <Border Classes="notice info">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Viewbox Classes="icon" VerticalAlignment="Top"><Path Classes="icon" Data="{StaticResource IconInfo}" Stroke="{DynamicResource AppAccentBrush}" /></Viewbox>
                                <TextBlock Grid.Column="1" Text="{l:Loc AddGame_Overview_Next}" />
                            </Grid>
                        </Border>
                        <Expander x:Name="SkippedFolders" Header="{Binding SkippedTitle}" IsVisible="{Binding HasSkippedFolders}" HorizontalAlignment="Stretch">
                            <ItemsControl ItemsSource="{Binding SkippedFolders}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SkippedFolderViewModel">
                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                                            <TextBlock Text="{Binding Path}" FontSize="12" />
                                            <TextBlock Classes="muted" Text="—" FontSize="12" />
                                            <TextBlock Classes="muted" Text="{Binding Reason}" FontSize="12" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                    </StackPanel>

                    <!-- Several games: result -->
                    <StackPanel x:Name="ResultStep" Spacing="14" IsVisible="{Binding IsResult}" Margin="0,8">
                        <Border Width="56" Height="56" CornerRadius="28" Background="{DynamicResource AppAccentSoftBrush}" HorizontalAlignment="Center">
                            <Viewbox Classes="icon" Width="26" Height="26">
                                <Path Classes="icon" Data="{StaticResource IconCheckCircle}" Stroke="{DynamicResource AppAccentBrush}" />
                            </Viewbox>
                        </Border>
                        <TextBlock x:Name="ResultTitle" Classes="h2" Text="{Binding ResultTitle}" HorizontalAlignment="Center" />
                        <ItemsControl x:Name="ResultList" ItemsSource="{Binding Games}" MaxWidth="520" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:FolderGameViewModel">
                                    <Border Classes="notice" Margin="0,3" Padding="14,8">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                            <Panel Width="14" Height="14">
                                                <Viewbox Classes="icon" Width="14" Height="14" IsVisible="{Binding IsAdded}">
                                                    <Path Classes="icon" Data="{StaticResource IconCheck}" Stroke="{DynamicResource AppOkBrush}" />
                                                </Viewbox>
                                                <Viewbox Classes="icon" Width="14" Height="14" IsVisible="{Binding !IsAdded}">
                                                    <Path Classes="icon" Data="{StaticResource IconSkip}" Stroke="{DynamicResource AppMutedBrush}" />
                                                </Viewbox>
                                            </Panel>
                                            <TextBlock Grid.Column="1">
                                                <Run Text="{Binding Name}" FontWeight="Bold" />
                                                <Run Text=" — " Foreground="{DynamicResource AppMutedBrush}" />
                                                <Run Text="{Binding ResultText}" Foreground="{DynamicResource AppMutedBrush}" />
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- One game's summary: the folder's only game, or the game under review -->
                    <StackPanel x:Name="SummaryStep" Spacing="14" IsVisible="{Binding ShowSummary}">
                        <Border x:Name="SubfolderNotice" Classes="notice info" IsVisible="{Binding Summary.HasSubfolderNotice, FallbackValue=False}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Viewbox Classes="icon"><Path Classes="icon" Data="{StaticResource IconScan}" Stroke="{DynamicResource AppAccentBrush}" /></Viewbox>
                                <TextBlock Grid.Column="1" Text="{Binding Summary.SubfolderNotice}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="18">
                            <!-- Cover (2:3) with a button to change it -->
                            <Panel Width="120" Height="180" VerticalAlignment="Top">
                                <Border CornerRadius="12" ClipToBounds="True" Background="{StaticResource AppLogoBrush}" Opacity="0.85" />
                                <Border CornerRadius="12" ClipToBounds="True">
                                    <Panel>
                                        <Image Source="{Binding Summary.CoverArt}" Stretch="UniformToFill" IsVisible="{Binding Summary.HasCoverArt, FallbackValue=False}" />
                                        <Image Source="{Binding Summary.CoverIcon}" Stretch="Uniform" Width="64" Height="64" IsVisible="{Binding Summary.HasCoverIcon, FallbackValue=False}" />
                                        <Viewbox Classes="icon" Width="32" Height="32" IsVisible="{Binding !Summary.HasCoverIcon, FallbackValue=True}">
                                            <Path Classes="icon" Data="{StaticResource IconImage}" Stroke="#b3ffffff" IsVisible="{Binding !Summary.HasCoverArt, FallbackValue=True}" />
                                        </Viewbox>
                                    </Panel>
                                </Border>
                                <Button x:Name="CoverButton" Classes="icon sm overlay" Margin="6"
                                        HorizontalAlignment="Right" VerticalAlignment="Bottom" IsVisible="{Binding Summary.CanEdit, FallbackValue=False}"
                                        Command="{Binding Summary.ChooseCoverCommand}"
                                        ToolTip.Tip="{l:Loc AddGame_ChangeCover}" AutomationProperties.Name="{l:Loc AddGame_ChangeCover}">
                                    <Path Data="{StaticResource IconImage}" Width="14" Height="14" />
                                </Button>
                            </Panel>

                            <StackPanel Grid.Column="1" Spacing="10">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                    <TextBlock x:Name="GameName" Classes="h1" Text="{Binding Summary.Name}" TextWrapping="Wrap" IsVisible="{Binding !Summary.IsRenaming, FallbackValue=True}" />
                                    <TextBox x:Name="NameBox" Text="{Binding Summary.Name}" IsVisible="{Binding Summary.IsRenaming, FallbackValue=False}" FontSize="18"
                                             AutomationProperties.Name="{l:Loc AddGame_Details_Name}" />
                                    <Button x:Name="RenameButton" Grid.Column="1" Classes="icon" Width="34" Height="34" VerticalAlignment="Top"
                                            Command="{Binding Summary.RenameCommand}" IsVisible="{Binding Summary.CanEdit, FallbackValue=False}"
                                            ToolTip.Tip="{l:Loc AddGame_Rename}" AutomationProperties.Name="{l:Loc AddGame_Rename}">
                                        <Path Data="{StaticResource IconPencil}" Width="14" Height="14" />
                                    </Button>
                                </Grid>
                                <WrapPanel ItemSpacing="6" LineSpacing="6">
                                    <Border Classes="fact" Classes.warn="{Binding Summary.IsEngineUnknown, FallbackValue=False}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Viewbox Classes="icon" Width="13" Height="13">
                                                <Path Classes="icon" Data="{StaticResource IconCpu}" Stroke="{DynamicResource AppMutedBrush}" />
                                            </Viewbox>
                                            <TextBlock x:Name="EngineFact" Text="{Binding Summary.EngineText}" FontWeight="Bold" />
                                        </StackPanel>
                                    </Border>
                                    <Border Classes="fact">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Viewbox Classes="icon" Width="13" Height="13">
                                                <Path Classes="icon" Data="{StaticResource IconFile}" Stroke="{DynamicResource AppMutedBrush}" />
                                            </Viewbox>
                                            <TextBlock Text="{Binding Summary.ExecutableText}" FontWeight="Bold" />
                                        </StackPanel>
                                    </Border>
                                    <Border Classes="fact">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Viewbox Classes="icon" Width="13" Height="13">
                                                <Path Classes="icon" Data="{StaticResource IconHardDrive}" Stroke="{DynamicResource AppMutedBrush}" />
                                            </Viewbox>
                                            <TextBlock Text="{Binding Summary.SizeText}" />
                                        </StackPanel>
                                    </Border>
                                </WrapPanel>
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                                    <Viewbox Classes="icon" Width="14" Height="14">
                                        <Path Classes="icon" Data="{StaticResource IconFolder}" Stroke="{DynamicResource AppMutedBrush}" />
                                    </Viewbox>
                                    <SelectableTextBlock Grid.Column="1" Classes="muted" Text="{Binding Summary.GamePath}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    <Button x:Name="OtherFolderButton" Grid.Column="2" Classes="link" Command="{Binding ChooseFolderCommand}"
                                            Content="{l:Loc AddGame_OtherFolder}" IsVisible="{Binding IsSummary}" />
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <!-- Answer block and notices -->
                        <Border x:Name="DuplicateNotice" Classes="notice info" IsVisible="{Binding Summary.IsDuplicate, FallbackValue=False}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Viewbox Classes="icon"><Path Classes="icon" Data="{StaticResource IconCheckCircle}" Stroke="{DynamicResource AppAccentBrush}" /></Viewbox>
                                <TextBlock Grid.Column="1" Classes="title" Text="{Binding Summary.DuplicateText}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <Border x:Name="AntiCheatNotice" Classes="notice bad" IsVisible="{Binding Summary.IsBlocked, FallbackValue=False}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Viewbox Classes="icon" VerticalAlignment="Top"><Path Classes="icon" Data="{StaticResource IconShield}" Stroke="{DynamicResource AppBadBrush}" /></Viewbox>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Classes="title" Text="{Binding Summary.AntiCheatTitle}" />
                                    <TextBlock Classes="sub" Text="{l:Loc AddGame_AntiCheat_Text}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border x:Name="EngineWarning" Classes="notice warn" IsVisible="{Binding Summary.ShowEngineWarning, FallbackValue=False}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Viewbox Classes="icon" VerticalAlignment="Top"><Path Classes="icon" Data="{StaticResource IconCpu}" Stroke="{DynamicResource AppWarnBrush}" /></Viewbox>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Classes="title" Text="{l:Loc AddGame_EngineWarning_Title}" />
                                    <TextBlock Classes="sub" Text="{l:Loc AddGame_EngineWarning_Text}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border x:Name="RegistryNote" Classes="notice neutral" IsVisible="{Binding Summary.ShowRegistryNote, FallbackValue=False}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Viewbox Classes="icon" VerticalAlignment="Top"><Path Classes="icon" Data="{StaticResource IconCloud}" Stroke="{DynamicResource AppMutedBrush}" /></Viewbox>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Classes="title" Text="{l:Loc AddGame_Registry_Title}" />
                                    <TextBlock Classes="sub" Text="{l:Loc AddGame_Registry_Text}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <TextBlock Foreground="{DynamicResource AppBadBrush}" Text="{Binding Summary.Error}" TextWrapping="Wrap"
                                   IsVisible="{Binding Summary.Error, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}" />

                        <!-- Edit game details -->
                        <Expander x:Name="Details" Header="{l:Loc AddGame_Details}" IsExpanded="{Binding Summary.IsDetailsOpen}"
                                  IsVisible="{Binding Summary.CanEdit, FallbackValue=False}" HorizontalAlignment="Stretch">
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="hint" Text="{l:Loc AddGame_Details_Name}" />
                                    <TextBox x:Name="DetailsName" Text="{Binding Summary.Name}" AutomationProperties.Name="{l:Loc AddGame_Details_Name}" />
                                </StackPanel>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                    <StackPanel Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Classes="hint" Text="{l:Loc AddGame_Details_Engine}" />
                                            <TextBlock Classes="hint" Foreground="{DynamicResource AppOkBrush}" Text="{l:Loc AddGame_Details_Detected}" IsVisible="{Binding Summary.IsEngineDetected, FallbackValue=False}" />
                                            <TextBlock Classes="hint" Foreground="{DynamicResource AppWarnBrush}" Text="{l:Loc AddGame_Details_NotDetected}" IsVisible="{Binding !Summary.IsEngineDetected, FallbackValue=False}" />
                                        </StackPanel>
                                        <ComboBox x:Name="EngineBox" HorizontalAlignment="Stretch" ItemsSource="{Binding Summary.EngineOptions}" SelectedItem="{Binding Summary.SelectedEngine}"
                                                  AutomationProperties.Name="{l:Loc AddGame_Details_Engine}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Classes="hint" Text="{l:Loc AddGame_Details_Executable}" />
                                        <ComboBox x:Name="ExecutableBox" HorizontalAlignment="Stretch" ItemsSource="{Binding Summary.ExecutableOptions}" SelectedItem="{Binding Summary.SelectedExecutable}" AutomationProperties.Name="{l:Loc AddGame_Details_Executable}" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="hint" Text="{l:Loc AddGame_Details_Cover}" />
                                    <WrapPanel ItemSpacing="8" LineSpacing="8">
                                        <Button Classes="ghost" Command="{Binding Summary.ChooseCoverCommand}" Content="{l:Loc AddGame_Details_ChooseImage}" />
                                        <Button Classes="ghost" Command="{Binding Summary.UseIconCommand}" Content="{l:Loc AddGame_Details_UseIcon}" />
                                    </WrapPanel>
                                    <TextBlock Foreground="{DynamicResource AppBadBrush}" FontSize="12" Text="{Binding Summary.CoverError}" TextWrapping="Wrap"
                                               IsVisible="{Binding Summary.CoverError, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}" />
                                </StackPanel>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Panel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
