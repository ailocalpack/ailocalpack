<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:gp="using:AiLocalPack.Desktop.ViewModels.GamePage"
             xmlns:views="using:AiLocalPack.Desktop.Views"
             xmlns:l="using:AiLocalPack.Desktop.Localization"
             x:Class="AiLocalPack.Desktop.Views.GenerationTabView"
             x:DataType="gp:GenerationTabViewModel">
    <!-- Design §6, "one conversation" (decided 2026-11-14): the start form; then the whole job is one thread: a slim bar
         (the steps in small and the % while it runs; the translation, Publish and Drafts once built), the start request
         and a line per finished stage, the running stage's card (banner, glossary review, progress), the result and the
         Fix with AI conversation. The composer is docked at the bottom of the game page (GamePageView). -->
    <StackPanel MaxWidth="860" Spacing="14" HorizontalAlignment="Stretch">
        <!-- Five-step header over the start form: Setup + the four pipeline stages -->
        <!-- Five-step header: Setup + the four pipeline stages -->
        <ItemsControl x:Name="GenerationSteps" ItemsSource="{Binding Steps}" IsVisible="{Binding ShowForm}" AutomationProperties.Name="{l:Loc Gen_Steps_Label}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="gp:GenerationStepViewModel">
                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,30,*" RowSpacing="6"
                          AutomationProperties.Name="{Binding Name}">
                        <Border Grid.Column="2" Classes="genStepLine" Classes.done="{Binding IsDone}" Margin="8,0,-8,0"
                                VerticalAlignment="Center" IsVisible="{Binding HasLine}" />
                        <Border Grid.Column="1" Classes="genStepIcon" Classes.done="{Binding IsDone}" Classes.running="{Binding IsRunning}"
                                Classes.current="{Binding IsCurrent}" Classes.paused="{Binding IsPaused}" Classes.failed="{Binding IsFailed}">
                            <Viewbox Classes="icon" Width="15" Height="15" Classes.spin="{Binding IsRunning}">
                                <Viewbox.RenderTransform><RotateTransform /></Viewbox.RenderTransform>
                                <Path Classes="icon" Data="{Binding Icon, Converter={x:Static views:ResourceKeyConverter.Instance}}" />
                            </Viewbox>
                        </Border>
                        <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Classes="genStepName" Classes.reached="{Binding IsReached}" Text="{Binding Name}" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Start form (§6a) -->
        <Border x:Name="StartForm" Classes="genCard" IsVisible="{Binding ShowForm}">
            <StackPanel Spacing="18">
                <Border x:Name="GenRequestStrip" Classes="banner" IsVisible="{Binding ShowRequest}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Viewbox Classes="icon" Width="16" Height="16" VerticalAlignment="Top">
                            <Path Classes="icon" Data="{StaticResource IconMessage}" Stroke="{DynamicResource AppAccentBrush}" />
                        </Viewbox>
                        <TextBlock FontSize="13" Text="{Binding RequestStripText}" TextWrapping="Wrap" MaxWidth="720" />
                    </StackPanel>
                </Border>
                <!-- Title as a sentence: "Create a [Balanced ▾] translation into [Русский ▾] [with Unity toolkit ▾]" (quality modes, decided 2026-11-13; reader 2026-11-14) -->
                <StackPanel Spacing="4">
                <WrapPanel ItemSpacing="10" LineSpacing="6">
                    <TextBlock x:Name="GenFormTitle" Classes="genTitle" Text="{Binding FormTitle}" VerticalAlignment="Center" IsVisible="{Binding HasFormTitle}" />
                    <Button x:Name="GenQualityButton" Classes="qualityPicker" ToolTip.Tip="{l:Loc Gen_Quality_Button_Tip}"
                            AutomationProperties.Name="{l:Loc Gen_Quality_Button_Tip}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Viewbox Classes="icon" Width="16" Height="16">
                                <Path Classes="icon qualityIcon" Data="{Binding QualityIcon, Converter={x:Static views:ResourceKeyConverter.Instance}}" />
                            </Viewbox>
                            <TextBlock x:Name="GenQualityName" FontWeight="Bold" Text="{Binding QualityName}" VerticalAlignment="Center" />
                            <Viewbox Classes="icon" Width="14" Height="14"><Path Classes="icon" Data="{StaticResource IconChevronDown}" /></Viewbox>
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedLeft">
                                <StackPanel Width="440" Spacing="2">
                                    <ItemsControl x:Name="GenQualityList" ItemsSource="{Binding QualityOptions}" AutomationProperties.Name="{l:Loc Gen_Quality_Button_Tip}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="gp:GenerationQualityOption">
                                                <Button Classes="qualityItem" Classes.on="{Binding IsSelected}" Command="{Binding SelectCommand}"
                                                        Click="OnQualityPicked" AutomationProperties.Name="{Binding Name}">
                                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                        <Border Classes="qualityItemIcon" VerticalAlignment="Top">
                                                            <Viewbox Classes="icon" Width="16" Height="16">
                                                                <Path Classes="icon" Data="{Binding Icon, Converter={x:Static views:ResourceKeyConverter.Instance}}" />
                                                            </Viewbox>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Spacing="2">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <TextBlock FontWeight="Bold" Text="{Binding Name}" VerticalAlignment="Center" />
                                                                <Border Classes="qualityDefault" IsVisible="{Binding IsDefault}">
                                                                    <TextBlock Text="{l:Loc Gen_Quality_Default}" />
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBlock Classes="muted" FontSize="12" Text="{Binding Blurb}" TextWrapping="Wrap" />
                                                            <TextBlock Classes="faint" FontSize="12" Text="{Binding Model}" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" Spacing="6" HorizontalAlignment="Right">
                                                            <TextBlock Classes="faint" FontSize="12" Text="{Binding Time}" HorizontalAlignment="Right" />
                                                            <StackPanel Orientation="Horizontal" Spacing="3" HorizontalAlignment="Right">
                                                                <Border Classes="qualityBar on" />
                                                                <Border Classes="qualityBar" Classes.on="{Binding HasSecondBar}" />
                                                                <Border Classes="qualityBar" Classes.on="{Binding HasThirdBar}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Border Classes="qualityFoot">
                                        <DockPanel>
                                            <Button x:Name="GenQualityCompare" DockPanel.Dock="Right" Classes="link" Command="{Binding CompareQualitiesCommand}"
                                                    Click="OnQualityPicked" Content="{l:Loc Gen_Quality_Compare}" VerticalAlignment="Center" />
                                            <TextBlock Classes="faint" FontSize="12" Text="{l:Loc Gen_Quality_Footer}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        </DockPanel>
                                    </Border>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <TextBlock x:Name="GenFormTitleAfter" Classes="genTitle" Text="{Binding FormTitleAfter}" VerticalAlignment="Center" IsVisible="{Binding HasFormTitleAfter}" />
                    <Button x:Name="GenLanguageButton" Classes="langPicker" ToolTip.Tip="{l:Loc Gen_Language_Tip}" IsEnabled="{Binding CanPickLanguage}"
                            AutomationProperties.Name="{l:Loc Gen_Language_Tip}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="muted" Text="{l:Loc Gen_Language_Into}" VerticalAlignment="Center" />
                            <TextBlock x:Name="GenLanguageName" FontWeight="SemiBold" Text="{Binding LanguageName}" VerticalAlignment="Center" />
                            <Viewbox Classes="icon" Width="14" Height="14"><Path Classes="icon" Data="{StaticResource IconChevronDown}" /></Viewbox>
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedLeft">
                                <StackPanel Width="280" Spacing="6">
                                    <TextBox x:Name="GenLanguageSearch" Classes="search" Text="{Binding LanguageQuery}"
                                             PlaceholderText="{l:Loc Packs_Language_Search}" AutomationProperties.Name="{l:Loc Packs_Language_Search}">
                                        <TextBox.InnerLeftContent>
                                            <Viewbox Classes="icon" Width="16" Height="16" Margin="10,0,0,0">
                                                <Path Classes="icon" Data="{StaticResource IconSearch}" Stroke="{DynamicResource AppMutedBrush}" />
                                            </Viewbox>
                                        </TextBox.InnerLeftContent>
                                    </TextBox>
                                    <ScrollViewer MaxHeight="320">
                                        <ItemsControl x:Name="GenLanguageList" ItemsSource="{Binding LanguageOptions}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="gp:PackLanguageOption">
                                                    <Button Classes="langItem" Classes.on="{Binding IsCurrent}" Command="{Binding SelectCommand}"
                                                            Click="OnLanguagePicked" AutomationProperties.Name="{Binding Name}">
                                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <TextBlock Classes="muted" FontSize="13" Margin="10,4" Text="{l:Loc Packs_Language_NoMatch}" IsVisible="{Binding HasNoLanguageMatch}" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <!-- What reads the game: the detected engine's toolkit by default, any other engine's, or the AI's own code (binary patch) -->
                    <Button x:Name="GenReaderButton" Classes="langPicker" ToolTip.Tip="{l:Loc Gen_Reader_Tip}" IsEnabled="{Binding CanPickReader}"
                            IsVisible="{Binding ReaderName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                            AutomationProperties.Name="{l:Loc Gen_Reader_Tip}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="muted" Text="{l:Loc Gen_Reader_With}" VerticalAlignment="Center" />
                            <Viewbox Classes="icon" Width="15" Height="15" IsVisible="{Binding HasReaderBrand}">
                                <Path Classes="brand" Data="{Binding ReaderBrandKey, Converter={x:Static views:ResourceKeyConverter.Instance}}" />
                            </Viewbox>
                            <Viewbox Classes="icon" Width="15" Height="15" IsVisible="{Binding !HasReaderBrand}">
                                <Path Classes="icon" Data="{Binding ReaderIcon, Converter={x:Static views:ResourceKeyConverter.Instance}}" />
                            </Viewbox>
                            <TextBlock x:Name="GenReaderName" FontWeight="SemiBold" Text="{Binding ReaderName}" VerticalAlignment="Center" />
                            <Viewbox Classes="icon" Width="14" Height="14"><Path Classes="icon" Data="{StaticResource IconChevronDown}" /></Viewbox>
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedLeft">
                                <StackPanel Width="400" Spacing="2">
                                    <ItemsControl x:Name="GenReaderList" ItemsSource="{Binding ReaderOptions}" AutomationProperties.Name="{l:Loc Gen_Reader_Tip}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="gp:GenerationReaderOption">
                                                <Button Classes="qualityItem" Classes.on="{Binding IsSelected}" Command="{Binding SelectCommand}"
                                                        Click="OnReaderPicked" AutomationProperties.Name="{Binding Name}">
                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                        <Border Classes="qualityItemIcon" VerticalAlignment="Top">
                                                            <Panel>
                                                                <Viewbox Classes="icon" Width="16" Height="16" IsVisible="{Binding HasBrand}">
                                                                    <Path Classes="brand" Data="{Binding BrandKey, Converter={x:Static views:ResourceKeyConverter.Instance}}" />
                                                                </Viewbox>
                                                                <Viewbox Classes="icon" Width="16" Height="16" IsVisible="{Binding !HasBrand}">
                                                                    <Path Classes="icon" Data="{Binding Icon, Converter={x:Static views:ResourceKeyConverter.Instance}}" />
                                                                </Viewbox>
                                                            </Panel>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Spacing="2">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <TextBlock FontWeight="Bold" Text="{Binding Name}" VerticalAlignment="Center" />
                                                                <Border Classes="qualityDefault" IsVisible="{Binding IsDetected}">
                                                                    <TextBlock Text="{l:Loc Gen_Reader_Detected}" />
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBlock Classes="muted" FontSize="12" Text="{Binding Blurb}" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Border Classes="qualityFoot">
                                        <TextBlock Classes="faint" FontSize="12" Text="{l:Loc Gen_Reader_Footer}" TextWrapping="Wrap" />
                                    </Border>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </WrapPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Viewbox Classes="icon" Width="13" Height="13"><Path Classes="icon" Data="{StaticResource IconBot}" Stroke="{DynamicResource AppFaintBrush}" /></Viewbox>
                    <TextBlock x:Name="GenQualityModel" Classes="muted" FontSize="12" Text="{Binding QualityModelLine}" VerticalAlignment="Center" />
                </StackPanel>
                </StackPanel>

                <!-- Thorough only: web lookup while studying the game -->
                <Border x:Name="GenWebLookup" Classes="genBanner" IsVisible="{Binding ShowWebLookup}">
                    <CheckBox IsChecked="{Binding WebLookup}" VerticalAlignment="Top" AutomationProperties.Name="{l:Loc Gen_Quality_Web}">
                        <StackPanel Spacing="3">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Viewbox Classes="icon" Width="14" Height="14"><Path Classes="icon bannerIcon" Data="{StaticResource IconGlobe}" /></Viewbox>
                                <TextBlock FontWeight="SemiBold" Text="{l:Loc Gen_Quality_Web}" TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock Classes="muted" FontSize="12" Text="{l:Loc Gen_Quality_Web_Detail}" TextWrapping="Wrap" />
                        </StackPanel>
                    </CheckBox>
                </Border>

                <!-- Update mode (task 56): the base pack and what the game update changed -->
                <Border x:Name="GenUpdateBanner" Classes="genBanner" IsVisible="{Binding IsUpdateMode}">
                    <DockPanel>
                        <Viewbox DockPanel.Dock="Left" Classes="icon" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Top">
                            <Path Classes="icon bannerIcon" Data="{StaticResource IconInfo}" />
                        </Viewbox>
                        <StackPanel Spacing="2">
                            <TextBlock x:Name="GenUpdateBannerText" FontSize="13" Text="{Binding UpdateBannerText}" TextWrapping="Wrap" />
                            <TextBlock x:Name="GenUpdateDiff" Classes="muted" FontSize="12" Text="{Binding UpdateDiffText}" TextWrapping="Wrap"
                                       IsVisible="{Binding HasUpdateDiff}" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Estimate tiles: skeletons with "Estimating…" until the size is known -->
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                        <Border x:Name="StringsTile" Classes="genTile">
                            <StackPanel Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Viewbox Classes="icon" Width="13" Height="13"><Path Classes="icon" Data="{StaticResource IconFile}" Stroke="{DynamicResource AppMutedBrush}" /></Viewbox>
                                    <TextBlock Classes="muted" FontSize="12" Text="{l:Loc Gen_Tile_Strings}" />
                                </StackPanel>
                                <TextBlock x:Name="StringsValue" Classes="genTileValue" Text="{Binding StringsValue}" IsVisible="{Binding !IsEstimating}" />
                                <TextBlock Classes="faint" FontSize="12" Text="{Binding StringsDetail}" IsVisible="{Binding IsEstimated}" TextTrimming="CharacterEllipsis" />
                                <Border Classes="skeleton" Height="26" Width="120" HorizontalAlignment="Left" Margin="0,2" IsVisible="{Binding IsEstimating}" />
                                <TextBlock Classes="faint" FontSize="12" Text="{l:Loc Gen_Estimating}" IsVisible="{Binding IsEstimating}" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="TimeTile" Grid.Column="1" Classes="genTile">
                            <StackPanel Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Viewbox Classes="icon" Width="13" Height="13"><Path Classes="icon" Data="{StaticResource IconClock}" Stroke="{DynamicResource AppMutedBrush}" /></Viewbox>
                                    <TextBlock Classes="muted" FontSize="12" Text="{l:Loc Gen_Tile_Time}" />
                                </StackPanel>
                                <TextBlock x:Name="TimeValue" Classes="genTileValue" Text="{Binding TimeValue}" IsVisible="{Binding !IsEstimating}" />
                                <TextBlock Classes="faint" FontSize="12" Text="{l:Loc Gen_Tile_TimeDetail}" IsVisible="{Binding IsEstimated}" TextTrimming="CharacterEllipsis" />
                                <Border Classes="skeleton" Height="26" Width="120" HorizontalAlignment="Left" Margin="0,2" IsVisible="{Binding IsEstimating}" />
                                <TextBlock Classes="faint" FontSize="12" Text="{l:Loc Gen_Estimating}" IsVisible="{Binding IsEstimating}" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="LimitsTile" Grid.Column="2" Classes="genTile" ToolTip.Tip="{l:Loc Gen_Tile_LimitsTip}">
                            <StackPanel Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Viewbox Classes="icon" Width="13" Height="13"><Path Classes="icon" Data="{StaticResource IconCpu}" Stroke="{DynamicResource AppMutedBrush}" /></Viewbox>
                                    <TextBlock Classes="muted" FontSize="12" Text="{l:Loc Gen_Tile_Limits}" />
                                </StackPanel>
                                <TextBlock x:Name="LimitsValue" Classes="genTileValue" Text="{Binding LimitsValue}" IsVisible="{Binding !IsEstimating}" />
                                <TextBlock Classes="faint" FontSize="12" Text="{l:Loc Gen_Tile_LimitsDetail}" IsVisible="{Binding IsEstimated}" TextTrimming="CharacterEllipsis" />
                                <Border Classes="skeleton" Height="26" Width="120" HorizontalAlignment="Left" Margin="0,2" IsVisible="{Binding IsEstimating}" />
                                <TextBlock Classes="faint" FontSize="12" Text="{l:Loc Gen_Estimating}" IsVisible="{Binding IsEstimating}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <DockPanel x:Name="EstimateError" IsVisible="{Binding IsEstimateFailed}">
                        <Button DockPanel.Dock="Right" Classes="ghost sm" Margin="12,0,0,0" VerticalAlignment="Center"
                                Command="{Binding RetryEstimateCommand}" Content="{l:Loc Gen_Estimate_Retry}" />
                        <TextBlock Classes="error" Text="{Binding EstimateErrorText}" VerticalAlignment="Center" />
                    </DockPanel>
                </StackPanel>

                <!-- Agent cards: radio choice with the inline fix -->
                <StackPanel Spacing="8">
                    <TextBlock Classes="capsLabel" Text="{l:Loc Gen_Agents_Label}" />
                    <ItemsControl x:Name="AgentCards" ItemsSource="{Binding Agents}" AutomationProperties.Name="{l:Loc Gen_Agents_Label}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="2" ColumnSpacing="10" RowSpacing="10" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="gp:GenerationAgentCard">
                                <Border Classes="genAgent" Classes.on="{Binding IsSelected}" Tapped="OnAgentCardTapped">
                                    <StackPanel Spacing="6">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                <RadioButton GroupName="GenerationAgent" FontWeight="Bold" Content="{Binding Name}"
                                                             IsChecked="{Binding IsSelected, Mode=OneWay}" Command="{Binding SelectCommand}"
                                                             AutomationProperties.Name="{Binding Name}" VerticalAlignment="Center" />
                                                <views:AgentLogo Grid.Column="1" DataContext="{Binding Info}" IsSmall="True" VerticalAlignment="Center" />
                                            </Grid>
                                            <WrapPanel ItemSpacing="10" LineSpacing="6">
                                                <StackPanel Classes="genStatus" Classes.ok="{Binding IsStatusOk}" Classes.bad="{Binding IsStatusBad}"
                                                            Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <Viewbox Classes="icon" Width="14" Height="14" Classes.spin="{Binding IsStatusBusy}">
                                                        <Viewbox.RenderTransform><RotateTransform /></Viewbox.RenderTransform>
                                                        <Panel>
                                                            <Path Classes="icon" Data="{StaticResource IconCheck}" IsVisible="{Binding IsStatusOk}" />
                                                            <Path Classes="icon" Data="{StaticResource IconX}" IsVisible="{Binding IsStatusBad}" />
                                                            <Path Classes="icon" Data="{StaticResource IconLoader}" IsVisible="{Binding IsStatusBusy}" />
                                                        </Panel>
                                                    </Viewbox>
                                                    <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <TextBlock Classes="faint mono" FontSize="12" Text="{Binding SourceText}" IsVisible="{Binding HasSource}" VerticalAlignment="Center" />
                                                <Button Classes="accent sm" Command="{Binding Row.InstallCommand}" IsVisible="{Binding Row.CanInstall}">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <Viewbox Classes="icon" Width="14" Height="14">
                                                            <Path Classes="icon" Data="{StaticResource IconDownload}" Stroke="{Binding $parent[Button].Foreground}" />
                                                        </Viewbox>
                                                        <TextBlock Text="{Binding Row.InstallText}" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Classes="accent sm" Command="{Binding Row.SignInCommand}" IsVisible="{Binding Row.CanSignIn}">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <Viewbox Classes="icon" Width="14" Height="14">
                                                            <Path Classes="icon" Data="{StaticResource IconLock}" Stroke="{Binding $parent[Button].Foreground}" />
                                                        </Viewbox>
                                                        <TextBlock Text="{Binding Row.SignInText}" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Classes="ghost sm" Command="{Binding Row.UpdateCommand}" IsVisible="{Binding Row.CanUpdate}" Content="{Binding Row.UpdateText}" />
                                                <Button Classes="ghost sm" Command="{Binding Row.CheckAgainCommand}" IsVisible="{Binding Row.CanCheckAgain}" Content="{Binding Row.CheckAgainText}" />
                                                <Button Classes="bare sm" Command="{Binding Row.CancelCommand}" IsVisible="{Binding Row.CanCancel}" Content="{Binding Row.CancelText}" />
                                            </WrapPanel>
                                            <ProgressBar Classes="installProgress" Maximum="100" Value="{Binding Percent}" IsVisible="{Binding HasProgress}" />
                                            <TextBlock Classes="faint" FontSize="12" Text="{Binding Hint}" IsVisible="{Binding HasHint}" TextWrapping="Wrap" />
                                            <TextBlock Classes="error" Text="{Binding Row.Error}" IsVisible="{Binding Row.HasError}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Checks -->
                <StackPanel Spacing="8">
                    <TextBlock Classes="capsLabel" Text="{l:Loc Gen_Checks_Label}" />
                    <ItemsControl x:Name="GenerationChecks" ItemsSource="{Binding Checks}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="2" ColumnSpacing="16" RowSpacing="6" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="gp:GenerationCheckViewModel">
                                <StackPanel Classes="genCheck" Classes.ok="{Binding IsOk}" Classes.bad="{Binding IsBad}" Classes.warning="{Binding IsWarning}" Orientation="Horizontal" Spacing="8">
                                    <Viewbox Classes="icon" Width="14" Height="14" VerticalAlignment="Top" Margin="0,2,0,0" Classes.spin="{Binding IsPending}">
                                        <Viewbox.RenderTransform><RotateTransform /></Viewbox.RenderTransform>
                                        <Panel>
                                            <Path Classes="icon" Data="{StaticResource IconCheck}" IsVisible="{Binding IsOk}" />
                                            <Path Classes="icon" Data="{StaticResource IconX}" IsVisible="{Binding IsBad}" />
                                            <Path Classes="icon" Data="{StaticResource IconLoader}" IsVisible="{Binding IsPending}" />
                                            <Path Classes="icon" Data="{StaticResource IconAlert}" IsVisible="{Binding IsWarning}" />
                                        </Panel>
                                    </Viewbox>
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" MaxWidth="380" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <CheckBox x:Name="ReviewGlossary" IsChecked="{Binding ReviewGlossary}" Content="{l:Loc Gen_ReviewGlossary}" />

                <!-- Task 74: players asked for this translation; taking the request tells them -->
                <StackPanel x:Name="GenRequest" Spacing="6" IsVisible="{Binding ShowRequest}">
                    <CheckBox x:Name="TakeRequest" IsChecked="{Binding TakeRequest}" Content="{Binding TakeRequestText}" />
                    <TextBlock Classes="muted" FontSize="12" Margin="28,0,0,0" Text="{Binding RequestOtherClaimText}" IsVisible="{Binding HasRequestOtherClaim}" TextWrapping="Wrap" />
                </StackPanel>

                <!-- Footer: the copy note and Start (with the reason when it is off) -->
                <Border Classes="genFoot">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Viewbox Classes="icon" Width="14" Height="14">
                                <Path Classes="icon" Data="{StaticResource IconShield}" Stroke="{DynamicResource AppOkBrush}" />
                            </Viewbox>
                            <TextBlock Classes="muted" FontSize="13" Text="{l:Loc Gen_CopyNote}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4" HorizontalAlignment="Right">
                            <Button x:Name="StartGeneration" Classes="accent" HorizontalAlignment="Right" Command="{Binding StartCommand}"
                                    AutomationProperties.Name="{Binding StartText}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Viewbox Classes="icon" Width="16" Height="16">
                                        <Path Classes="icon" Data="{StaticResource IconSparkles}" Stroke="{Binding $parent[Button].Foreground}" />
                                    </Viewbox>
                                    <TextBlock Text="{Binding StartText}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <TextBlock x:Name="StartBlockText" Classes="muted" FontSize="12" HorizontalAlignment="Right" TextAlignment="Right"
                                       MaxWidth="300" TextWrapping="Wrap" Text="{Binding StartBlockText}" IsVisible="{Binding HasStartBlock}" />
                            <TextBlock x:Name="StartError" Classes="error" FontSize="12" HorizontalAlignment="Right" TextAlignment="Right"
                                       MaxWidth="300" Text="{Binding StartError}" IsVisible="{Binding HasStartError}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>
        <TextBlock x:Name="GenFormHint" Classes="fixSystem" FontSize="12" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                   Text="{l:Loc Gen_Story_FormHint}" IsVisible="{Binding ShowForm}" />

        <!-- Fix with AI (task 75, design §6e): the installed draft made the game close right after it started -->
        <Border x:Name="FixCrashBanner" Classes="genBanner bad" IsVisible="{Binding Fix.ShowCrashBanner, FallbackValue=False}">
            <DockPanel>
                <Viewbox DockPanel.Dock="Left" Classes="icon" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Top">
                    <Path Classes="icon bannerIcon" Data="{StaticResource IconAlert}" />
                </Viewbox>
                <Button x:Name="FixRestore" DockPanel.Dock="Right" Classes="ghost sm" Margin="12,0,0,0" VerticalAlignment="Center"
                        Command="{Binding Fix.RestoreCommand, FallbackValue={x:Null}}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Viewbox Classes="icon" Width="14" Height="14">
                            <Path Classes="icon" Data="{StaticResource IconUndo}" Stroke="{Binding $parent[Button].Foreground}" />
                        </Viewbox>
                        <TextBlock Text="{l:Loc Fix_Crash_Restore}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="FixBannerNotCrash" DockPanel.Dock="Right" Classes="ghost sm" Margin="12,0,0,0" VerticalAlignment="Center"
                        Command="{Binding Fix.NotCrashCommand, FallbackValue={x:Null}}" Content="{l:Loc Fix_NotCrash}" />
                <TextBlock FontSize="13" Text="{Binding Fix.CrashBannerText, FallbackValue={x:Null}}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- The slim bar over the thread -->
        <Border x:Name="GenJobBar" Classes="genJobBar" IsVisible="{Binding ShowThread}">
            <Panel>
                <!-- While the job runs: the steps in small and the overall % -->
                <DockPanel IsVisible="{Binding ShowRunBar}">
                    <TextBlock x:Name="JobBarPercent" DockPanel.Dock="Right" FontWeight="Bold" Text="{Binding PercentText}" VerticalAlignment="Center" Margin="12,0,0,0" />
                    <ItemsControl x:Name="GenerationStepsMini" ItemsSource="{Binding Steps}" AutomationProperties.Name="{l:Loc Gen_Steps_Label}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel ItemSpacing="4" LineSpacing="6" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="gp:GenerationStepViewModel">
                                <StackPanel Orientation="Horizontal" Spacing="6" AutomationProperties.Name="{Binding Name}">
                                    <Border Classes="genStepIcon mini" Classes.done="{Binding IsDone}" Classes.running="{Binding IsRunning}"
                                            Classes.current="{Binding IsCurrent}" Classes.paused="{Binding IsPaused}" Classes.failed="{Binding IsFailed}">
                                        <Viewbox Classes="icon" Width="11" Height="11" Classes.spin="{Binding IsRunning}">
                                            <Viewbox.RenderTransform><RotateTransform /></Viewbox.RenderTransform>
                                            <Path Classes="icon" Data="{Binding Icon, Converter={x:Static views:ResourceKeyConverter.Instance}}" />
                                        </Viewbox>
                                    </Border>
                                    <TextBlock Classes="genStepName mini" Classes.reached="{Binding IsReached}" Text="{Binding Name}" VerticalAlignment="Center" />
                                    <Border Classes="genStepLine mini" Classes.done="{Binding IsDone}" IsVisible="{Binding HasLine}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
                <!-- Once built: the translation, Publish (after playing), Drafts -->
                <DockPanel IsVisible="{Binding ShowResultBar}">
                    <WrapPanel DockPanel.Dock="Right" ItemSpacing="8" LineSpacing="6" VerticalAlignment="Center" Margin="12,0,0,0">
                        <StackPanel x:Name="ShareStrip" Orientation="Horizontal" Spacing="8" IsVisible="{Binding Result.ShowShare, FallbackValue=False}">
                            <TextBlock Classes="muted" FontSize="12" Text="{l:Loc Gen_Result_Share_Title}" VerticalAlignment="Center" MaxWidth="220" TextWrapping="Wrap"
                                       ToolTip.Tip="{l:Loc Gen_Result_Share_Text}" />
                            <Button x:Name="SharePublish" Classes="accent sm" Command="{Binding Result.Publish.PublishCommand, FallbackValue={x:Null}}"
                                    ToolTip.Tip="{l:Loc Gen_Result_Share_Text}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Viewbox Classes="icon" Width="14" Height="14">
                                        <Path Classes="icon" Data="{StaticResource IconUpload}" Stroke="{Binding $parent[Button].Foreground}" />
                                    </Viewbox>
                                    <TextBlock Text="{l:Loc Gen_Result_Publish}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="ShareNotNow" Classes="bare sm" Command="{Binding Result.NotNowCommand, FallbackValue={x:Null}}" Content="{l:Loc Gen_Result_NotNow}" />
                        </StackPanel>
            <Button x:Name="FixDraftsButton" Classes="ghost sm" IsVisible="{Binding HasDrafts}" VerticalAlignment="Center" DataContext="{Binding Fix}" x:DataType="gp:FixViewModel"
                    AutomationProperties.Name="{l:Loc Fix_Drafts}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Viewbox Classes="icon" Width="14" Height="14">
                        <Path Classes="icon" Data="{StaticResource IconClock}" Stroke="{Binding $parent[Button].Foreground}" />
                    </Viewbox>
                    <TextBlock Text="{l:Loc Fix_Drafts}" VerticalAlignment="Center" />
                </StackPanel>
                <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedRight">
                        <StackPanel Width="520" Spacing="4">
                            <ItemsControl x:Name="FixDraftList" ItemsSource="{Binding Drafts}" AutomationProperties.Name="{l:Loc Fix_Drafts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="gp:FixDraftRow">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="6,6" AutomationProperties.Name="{Binding Name}">
                                            <StackPanel Spacing="2">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock FontWeight="Bold" Text="{Binding Name}" VerticalAlignment="Center" />
                                                    <Border Classes="packTag" Classes.muted="{Binding IsMuted}" Classes.bad="{Binding IsBad}">
                                                        <TextBlock Text="{Binding Pill}" VerticalAlignment="Center" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Classes="muted" FontSize="12" Text="{Binding Status}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <Button Classes="ghost sm" Command="{Binding PublishCommand}" IsVisible="{Binding CanPublish}" Content="{l:Loc Fix_Draft_Publish}" />
                                                <Button Classes="bare sm" Command="{Binding GoBackCommand}" IsVisible="{Binding CanGoBack}" Content="{l:Loc Fix_Draft_GoBack}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Classes="faint" FontSize="12" Margin="6,4" Text="{l:Loc Fix_Drafts_Note}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
                    </WrapPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Classes="genBarIcon">
                            <Viewbox Classes="icon" Width="16" Height="16">
                                <Path Classes="icon" Data="{StaticResource IconCheck}" Stroke="{DynamicResource AppOkBrush}" />
                            </Viewbox>
                        </Border>
                        <StackPanel Spacing="1" VerticalAlignment="Center">
                            <TextBlock x:Name="ResultBarTitle" FontWeight="Bold" Text="{Binding ResultBarTitle}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Classes="faint" FontSize="12" Text="{Binding Result.PackLine, FallbackValue={x:Null}}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Panel>
        </Border>
        <!-- Once sent (task 61, design §7): sending, CI running, failed, published -->
        <views:PublishStatusView x:Name="ResultPublish" DataContext="{Binding Result.Publish, FallbackValue={x:Null}}" />

        <!-- The job's story: the start request, a line per finished stage -->
        <ItemsControl x:Name="GenStory" ItemsSource="{Binding Story}" IsVisible="{Binding ShowThread}" AutomationProperties.Name="{l:Loc Gen_Thread_Label}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Spacing="12" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.DataTemplates>
                <DataTemplate DataType="gp:GenerationStoryRequest">
                    <Border Classes="fixPlayer">
                        <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="14" />
                    </Border>
                </DataTemplate>
                <DataTemplate DataType="gp:GenerationStoryLine">
                    <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="10">
                        <Border Classes="fixRule" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <Viewbox Classes="icon" Width="12" Height="12" VerticalAlignment="Center">
                                <Path Classes="icon" Data="{StaticResource IconCheck}" Stroke="{DynamicResource AppOkBrush}" />
                            </Viewbox>
                            <TextBlock Classes="fixSystem" FontSize="12" Text="{Binding Text}" TextWrapping="Wrap" MaxWidth="600" VerticalAlignment="Center" />
                        </StackPanel>
                        <Border Grid.Column="2" Classes="fixRule" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.DataTemplates>
        </ItemsControl>

        <!-- State banner (§6b): paused (limit / player), interrupted, failed stage, glossary waiting -->
        <Border x:Name="GenBanner" Classes="genBanner" Classes.warn="{Binding IsBannerWarn}" Classes.bad="{Binding IsBannerBad}"
                IsVisible="{Binding HasBanner}">
            <DockPanel>
                <Viewbox DockPanel.Dock="Left" Classes="icon" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Top">
                    <Path Classes="icon bannerIcon" Data="{Binding BannerIcon, Converter={x:Static views:ResourceKeyConverter.Instance}}" />
                </Viewbox>
                <WrapPanel DockPanel.Dock="Right" ItemSpacing="8" LineSpacing="6" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Button x:Name="GenBannerDetails" Classes="ghost sm" Command="{Binding DetailsCommand}" IsVisible="{Binding ShowBannerDetails}"
                            Content="{l:Loc Gen_Action_Details}" />
                    <Button x:Name="GenBannerAction" Classes="accent sm" Classes.genAction="{Binding IsBannerGen}" Command="{Binding ResumeCommand}"
                            IsVisible="{Binding ShowBannerAction}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Viewbox Classes="icon" Width="14" Height="14">
                                <Path Classes="icon" Data="{Binding BannerActionIcon, Converter={x:Static views:ResourceKeyConverter.Instance}}"
                                      Stroke="{Binding $parent[Button].Foreground}" />
                            </Viewbox>
                            <TextBlock Text="{Binding BannerActionText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock x:Name="GenBannerTitle" FontWeight="Bold" Text="{Binding BannerTitle}" TextWrapping="Wrap" />
                    <TextBlock x:Name="GenBannerText" FontSize="13" Text="{Binding BannerText}" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Glossary review (§6c, task 54): the terms with editable translations, the tone, Regenerate / Cancel / Continue -->
        <Border x:Name="ReviewCard" Classes="genCard" IsVisible="{Binding ShowReview}">
            <StackPanel Spacing="16">
                <StackPanel Spacing="14" DataContext="{Binding Review}" x:DataType="gp:GlossaryReviewViewModel">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top" Margin="12,0,0,0"
                                    IsVisible="{Binding IsLoaded}">
                            <TextBlock Classes="muted" FontSize="13" Text="{l:Loc Gen_Review_Tone}" VerticalAlignment="Center" />
                            <ComboBox x:Name="ReviewTone" Classes="toolbar" MinWidth="200" ItemsSource="{Binding ToneOptions}"
                                      SelectedItem="{Binding SelectedTone}" AutomationProperties.Name="{l:Loc Gen_Review_Tone}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="gp:GlossaryToneOption">
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <WrapPanel ItemSpacing="10">
                                <TextBlock Classes="genTitle" Text="{l:Loc Gen_Review_Title}" VerticalAlignment="Center" />
                                <TextBlock x:Name="ReviewCount" Classes="muted" Text="{Binding CountText}" VerticalAlignment="Center" IsVisible="{Binding IsLoaded}" />
                            </WrapPanel>
                            <TextBlock Classes="muted" FontSize="13" Text="{l:Loc Gen_Review_Subtitle}" TextWrapping="Wrap" />
                            <TextBlock x:Name="ReviewAgentTone" Classes="faint" FontSize="12" Text="{Binding AgentTone}" TextWrapping="Wrap"
                                       IsVisible="{Binding HasAgentTone}" />
                        </StackPanel>
                    </DockPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsLoading}">
                        <Viewbox Classes="icon spin" Width="16" Height="16">
                            <Viewbox.RenderTransform><RotateTransform /></Viewbox.RenderTransform>
                            <Path Classes="icon" Data="{StaticResource IconLoader}" />
                        </Viewbox>
                        <TextBlock Classes="muted" FontSize="13" Text="{l:Loc Gen_Review_Loading}" />
                    </StackPanel>
                    <TextBlock x:Name="ReviewError" Classes="error" FontSize="13" TextWrapping="Wrap" Text="{Binding Error}" IsVisible="{Binding HasError}" />

                    <StackPanel Spacing="8" IsVisible="{Binding IsLoaded}">
                        <TextBox x:Name="ReviewSearch" Classes="search" Text="{Binding Query}" PlaceholderText="{l:Loc Gen_Review_Search}"
                                 AutomationProperties.Name="{l:Loc Gen_Review_Search}">
                            <TextBox.InnerLeftContent>
                                <Viewbox Classes="icon" Width="16" Height="16" Margin="10,0,0,0">
                                    <Path Classes="icon" Data="{StaticResource IconSearch}" Stroke="{DynamicResource AppMutedBrush}" />
                                </Viewbox>
                            </TextBox.InnerLeftContent>
                        </TextBox>
                        <Border Classes="genBox" Padding="0">
                            <StackPanel>
                                <Grid ColumnDefinitions="2*,3*,2*" ColumnSpacing="12" Margin="14,10,14,6">
                                    <TextBlock Classes="faint" FontSize="11" FontWeight="SemiBold" Text="{l:Loc Gen_Review_Column_Term}" />
                                    <TextBlock Grid.Column="1" Classes="faint" FontSize="11" FontWeight="SemiBold" Text="{l:Loc Gen_Review_Column_Translation}" />
                                    <TextBlock Grid.Column="2" Classes="faint" FontSize="11" FontWeight="SemiBold" Text="{l:Loc Gen_Review_Column_Note}" />
                                </Grid>
                                <ScrollViewer MaxHeight="440">
                                    <ItemsControl x:Name="ReviewRows" ItemsSource="{Binding Rows}" Margin="14,0,14,10">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="gp:GlossaryRowViewModel">
                                                <Grid ColumnDefinitions="2*,3*,2*" ColumnSpacing="12" Margin="0,3">
                                                    <TextBlock FontWeight="SemiBold" Text="{Binding Term}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" Spacing="2">
                                                        <TextBox Text="{Binding Translation}" Classes.invalid="{Binding IsBlank}"
                                                                 AutomationProperties.Name="{Binding Term}" />
                                                        <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsEdited}">
                                                            <Viewbox Classes="icon" Width="11" Height="11">
                                                                <Path Classes="icon" Data="{StaticResource IconPencil}" Stroke="{DynamicResource AppAccentBrush}" />
                                                            </Viewbox>
                                                            <TextBlock FontSize="11" Foreground="{DynamicResource AppAccentBrush}" Text="{l:Loc Gen_Review_Edited}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Classes="muted" FontSize="12" Text="{Binding Note}" TextWrapping="Wrap"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <TextBlock Classes="muted" FontSize="13" Margin="14,0,14,12" Text="{Binding NoRowsText}" IsVisible="{Binding HasNoRows}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <TextBlock x:Name="ReviewActionError" Foreground="{DynamicResource AppWarnBrush}" FontSize="13" TextWrapping="Wrap"
                           Text="{Binding ActionError}" IsVisible="{Binding HasActionError}" />

                <Border Classes="genFoot">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Button x:Name="ReviewRegenerate" Classes="ghost" Command="{Binding RegenerateCommand}" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Viewbox Classes="icon" Width="16" Height="16">
                                    <Path Classes="icon" Data="{StaticResource IconRefresh}" Stroke="{Binding $parent[Button].Foreground}" />
                                </Viewbox>
                                <TextBlock Text="{l:Loc Gen_Action_Regenerate}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <StackPanel Grid.Column="2" Spacing="4" HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                                <Button x:Name="ReviewCancel" Classes="link" Command="{Binding CancelCommand}" Content="{l:Loc Gen_Action_Cancel}"
                                        Foreground="{DynamicResource AppMutedBrush}" VerticalAlignment="Center" />
                                <Button x:Name="ReviewContinue" Classes="accent" Command="{Binding ContinueCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{l:Loc Gen_Action_ContinueTranslation}" VerticalAlignment="Center" />
                                        <Viewbox Classes="icon" Width="16" Height="16">
                                            <Path Classes="icon" Data="{StaticResource IconChevronRight}" Stroke="{Binding $parent[Button].Foreground}" />
                                        </Viewbox>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <TextBlock x:Name="ReviewBlank" Classes="muted" FontSize="12" HorizontalAlignment="Right" Text="{l:Loc Gen_Review_Blank}"
                                       IsVisible="{Binding Review.HasBlank, FallbackValue=False}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <Border x:Name="ResultCard" Classes="genCard" IsVisible="{Binding ShowResult}">
            <StackPanel Spacing="16" DataContext="{Binding Result}" x:DataType="gp:GenerationResultViewModel">
                <StackPanel Orientation="Horizontal" Spacing="14">
                    <Border Classes="genDoneIcon">
                        <Viewbox Classes="icon" Width="28" Height="28">
                            <Path Classes="icon" Data="{StaticResource IconCheckCircle}" Stroke="{DynamicResource AppOkBrush}" />
                        </Viewbox>
                    </Border>
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock x:Name="ResultTitle" Classes="genTitle" FontSize="22" Text="{l:Loc Gen_Result_Title}" />
                        <TextBlock x:Name="ResultSubtitle" Classes="muted" FontSize="13" Text="{Binding Subtitle}" TextWrapping="Wrap" />
                        <TextBlock x:Name="ResultPackLine" Classes="faint" FontSize="12" Text="{Binding PackLine}" TextWrapping="Wrap" />
                        <TextBlock x:Name="ResultUpdateLine" Classes="faint" FontSize="12" Text="{Binding UpdateLine}" TextWrapping="Wrap"
                                   IsVisible="{Binding HasUpdateLine}" />
                    </StackPanel>
                </StackPanel>

                <ItemsControl x:Name="ResultTiles" ItemsSource="{Binding Tiles}" IsVisible="{Binding ShowDetails}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Rows="1" ColumnSpacing="10" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="gp:ResultTile">
                            <Border Classes="genTile" AutomationProperties.Name="{Binding Title}">
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="muted" FontSize="12" Text="{Binding Title}" />
                                    <DockPanel>
                                        <Viewbox DockPanel.Dock="Left" Classes="icon" Width="16" Height="16" Margin="0,2,6,0" VerticalAlignment="Top">
                                            <Path Classes="icon resultIcon" Classes.ok="{Binding IsOk}" Classes.warn="{Binding IsWarn}"
                                                  Data="{Binding Icon, Converter={x:Static views:ResourceKeyConverter.Instance}}" />
                                        </Viewbox>
                                        <TextBlock Classes="resultValue" Text="{Binding Value}" />
                                    </DockPanel>
                                    <TextBlock Classes="faint" FontSize="12" Text="{Binding Detail}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="ResultInGame" Foreground="{DynamicResource AppWarnBrush}" FontSize="13" TextWrapping="Wrap"
                           Text="{Binding InGameNote}" IsVisible="{Binding HasInGameNote}" />

                <!-- The test run's screenshots: the original and the translation once loaded, and the player's answer -->
                <Border x:Name="ResultShots" Classes="genBox" IsVisible="{Binding ShowShots}">
                    <StackPanel Spacing="10">
                        <StackPanel Spacing="2">
                            <TextBlock FontWeight="SemiBold" Text="{Binding ShotsQuestion}" TextWrapping="Wrap" />
                            <TextBlock Classes="faint" FontSize="12" Text="{Binding ShotsDetail}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <StackPanel Spacing="4" IsVisible="{Binding HasOriginalShot}">
                                <TextBlock Classes="muted" FontSize="12" Text="{l:Loc Gen_Result_Shots_Original}" />
                                <Image x:Name="ResultShotOriginal" Stretch="Uniform" MaxHeight="260" HorizontalAlignment="Left"
                                       Source="{Binding OriginalShot, Converter={x:Static views:FileBitmapConverter.Instance}}"
                                       AutomationProperties.Name="{l:Loc Gen_Result_Shots_Original}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Classes="muted" FontSize="12" Text="{l:Loc Gen_Result_Shots_Translated}" />
                                <Image x:Name="ResultShotTranslated" Stretch="Uniform" MaxHeight="260" HorizontalAlignment="Left"
                                       Source="{Binding TranslatedShot, Converter={x:Static views:FileBitmapConverter.Instance}}"
                                       AutomationProperties.Name="{l:Loc Gen_Result_Shots_Translated}" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding ShowConfirm}">
                            <Button x:Name="ResultShotsShows" Classes="ghost sm" Command="{Binding ConfirmShowsCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Viewbox Classes="icon" Width="14" Height="14">
                                        <Path Classes="icon" Data="{StaticResource IconCheck}" Stroke="{Binding $parent[Button].Foreground}" />
                                    </Viewbox>
                                    <TextBlock Text="{l:Loc Gen_Result_Shots_Yes}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="ResultShotsMissing" Classes="ghost sm" Command="{Binding ConfirmMissingCommand}" Content="{l:Loc Gen_Result_Shots_No}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Button x:Name="ResultWarningsToggle" Classes="link" HorizontalAlignment="Left" Margin="-4,0,0,0" Command="{Binding ToggleWarningsCommand}"
                        Content="{Binding WarningsToggleText}" IsVisible="{Binding ShowWarningsToggle}" />
                <ItemsControl x:Name="ResultWarningList" ItemsSource="{Binding Warnings}" IsVisible="{Binding ShowWarnings}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="gp:GenerationWarningRow">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="0,4">
                                <Border Classes="genWarnTag" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding Rule}" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Classes="genKey" Text="{Binding Key}" />
                                    <TextBlock FontSize="13" TextWrapping="Wrap">
                                        <Run Text="{Binding Original}" Foreground="{DynamicResource AppMutedBrush}" FontStyle="Italic" />
                                        <Run Text=" → " Foreground="{DynamicResource AppFaintBrush}" />
                                        <Run Text="{Binding Translation}" />
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Classes="genFoot">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel Spacing="6" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding ShowCopyNote}">
                                <Viewbox Classes="icon" Width="14" Height="14">
                                    <Path Classes="icon" Data="{StaticResource IconUndo}" Stroke="{DynamicResource AppMutedBrush}" />
                                </Viewbox>
                                <TextBlock Classes="muted" FontSize="13" Text="{l:Loc Gen_Result_CopyNote}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button x:Name="ResultNewTranslation" Classes="link" HorizontalAlignment="Left" Margin="-4,0,0,0"
                                    Command="{Binding NewTranslationCommand}" ToolTip.Tip="{l:Loc Gen_Result_NewTranslationTip}"
                                    Foreground="{DynamicResource AppMutedBrush}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Viewbox Classes="icon" Width="14" Height="14">
                                        <Path Classes="icon" Data="{StaticResource IconPlus}" Stroke="{DynamicResource AppMutedBrush}" />
                                    </Viewbox>
                                    <TextBlock Text="{l:Loc Gen_Result_NewTranslation}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <WrapPanel Grid.Column="1" ItemSpacing="8" LineSpacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="ResultPlay" Classes.ghost="{Binding !IsPlayPrimary}" Classes.accent="{Binding IsPlayPrimary}"
                                    Command="{Binding PlayCommand}" AutomationProperties.Name="{Binding PlayText}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Viewbox Classes="icon" Width="16" Height="16">
                                        <Path Classes="icon" Data="{Binding PlayIcon, Converter={x:Static views:ResourceKeyConverter.Instance}}"
                                              Stroke="{Binding $parent[Button].Foreground}" />
                                    </Viewbox>
                                    <TextBlock Text="{Binding PlayText}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="ResultShowInPacks" Classes="ghost" Command="{Binding ShowInPacksCommand}" IsVisible="{Binding ShowInPacksAction}"
                                    Content="{l:Loc Gen_Result_ShowInPacks}" />
                            <Button x:Name="ResultDiscard" Classes="ghost" Command="{Binding DiscardCommand}" IsVisible="{Binding ShowDiscard}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Viewbox Classes="icon" Width="14" Height="14">
                                        <Path Classes="icon" Data="{StaticResource IconTrash}" Stroke="{Binding $parent[Button].Foreground}" />
                                    </Viewbox>
                                    <TextBlock Text="{l:Loc Gen_Result_Discard}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>
        <TextBlock x:Name="ResultError" Foreground="{DynamicResource AppWarnBrush}" FontSize="13" TextWrapping="Wrap"
                   Text="{Binding ActionError}" IsVisible="{Binding ShowResultError}" />

        <!-- Fix with AI (task 75, design §6e): the conversation with the job's agent, after the result; its composer is docked at the bottom of the page -->
        <StackPanel x:Name="FixCard" Spacing="14" IsVisible="{Binding ShowFix}">
            <StackPanel Spacing="14" DataContext="{Binding Fix}" x:DataType="gp:FixViewModel">
                <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="10">
                    <Border Classes="fixRule" />
                    <TextBlock x:Name="FixIntro" Grid.Column="1" Classes="fixSystem" FontSize="12" Text="{Binding Intro}" TextWrapping="Wrap" MaxWidth="600" TextAlignment="Center" />
                    <Border Grid.Column="2" Classes="fixRule" />
                </Grid>
                <Button x:Name="FixEarlier" Classes="ghost sm" HorizontalAlignment="Center" Command="{Binding ShowEarlierCommand}" IsVisible="{Binding HasEarlier}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Viewbox Classes="icon" Width="14" Height="14">
                            <Path Classes="icon" Data="{StaticResource IconChevronUp}" Stroke="{Binding $parent[Button].Foreground}" />
                        </Viewbox>
                        <TextBlock Text="{Binding EarlierText}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
        <ItemsControl x:Name="FixThread" ItemsSource="{Binding ShownItems}" IsVisible="{Binding HasItems}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Spacing="14" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.DataTemplates>
                <DataTemplate DataType="gp:FixSystemItem">
                    <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="10">
                        <Border Classes="fixRule" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="fixSystem" Classes.bad="{Binding IsBad}" FontSize="12" Text="{Binding Text}" TextWrapping="Wrap" MaxWidth="600"
                                       VerticalAlignment="Center" />
                            <Button x:Name="FixNotCrash" Classes="link" FontSize="12" VerticalAlignment="Center" IsVisible="{Binding HasNotCrash}"
                                    Command="{Binding NotCrashCommand}" Content="{l:Loc Fix_NotCrash}" />
                        </StackPanel>
                        <Border Grid.Column="2" Classes="fixRule" />
                    </Grid>
                </DataTemplate>
                <DataTemplate DataType="gp:FixPlayerItem">
                    <Border Classes="fixPlayer">
                        <StackPanel Spacing="8">
                            <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="14" />
                            <ItemsControl ItemsSource="{Binding Attachments}" IsVisible="{Binding HasAttachments}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel ItemSpacing="6" LineSpacing="6" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="gp:FixAttachmentChip">
                                        <Border Classes="fixAttach" Classes.bad="{Binding IsBad}" Padding="10,0">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Viewbox Classes="icon" Width="14" Height="14">
                                                    <Path Classes="icon" Data="{Binding Icon, Converter={x:Static views:ResourceKeyConverter.Instance}}" />
                                                </Viewbox>
                                                <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding Name}" VerticalAlignment="Center" />
                                                <TextBlock Classes="faint" FontSize="12" Text="{Binding Detail}" IsVisible="{Binding HasDetail}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </DataTemplate>
                <DataTemplate DataType="gp:FixAgentItem">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" MaxWidth="780" HorizontalAlignment="Left">
                        <Border Classes="fixAvatar">
                            <Viewbox Classes="icon" Width="16" Height="16"><Path Classes="icon" Data="{StaticResource IconBot}" /></Viewbox>
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="10" Margin="0,5,0,0">
                            <TextBlock Classes="faint" FontSize="12" FontWeight="Bold" Text="{Binding Who}" />
                            <StackPanel IsVisible="{Binding HasSteps}">
                                <ItemsControl ItemsSource="{Binding HeadSteps}">
                                    <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="gp:FixStepRow">
                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                                            <Viewbox Classes="icon" Width="14" Height="14" Classes.spin="{Binding IsRunning}" IsVisible="{Binding IsRunning}">
                                                <Viewbox.RenderTransform><RotateTransform /></Viewbox.RenderTransform>
                                                <Path Classes="icon fixStep running" Data="{StaticResource IconLoader}" />
                                            </Viewbox>
                                            <Viewbox Classes="icon" Width="14" Height="14" IsVisible="{Binding !IsRunning}">
                                                <Path Classes="icon fixStep" Data="{StaticResource IconCheck}" />
                                            </Viewbox>
                                            <TextBlock Classes="muted" FontSize="13" Text="{Binding Text}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ToggleButton x:Name="MoreStepsToggle" Classes="stepsToggle" HorizontalAlignment="Left" Margin="-4,2,0,0" IsVisible="{Binding FoldsSteps}"
                                              Content="{Binding MoreStepsText}" />
                                <ItemsControl ItemsSource="{Binding MoreSteps}" IsVisible="{Binding #MoreStepsToggle.IsChecked}">
                                    <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="gp:FixStepRow">
                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                                            <Viewbox Classes="icon" Width="14" Height="14" Classes.spin="{Binding IsRunning}" IsVisible="{Binding IsRunning}">
                                                <Viewbox.RenderTransform><RotateTransform /></Viewbox.RenderTransform>
                                                <Path Classes="icon fixStep running" Data="{StaticResource IconLoader}" />
                                            </Viewbox>
                                            <Viewbox Classes="icon" Width="14" Height="14" IsVisible="{Binding !IsRunning}">
                                                <Path Classes="icon fixStep" Data="{StaticResource IconCheck}" />
                                            </Viewbox>
                                            <TextBlock Classes="muted" FontSize="13" Text="{Binding Text}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsWorking}">
                                <Viewbox Classes="icon spin" Width="14" Height="14">
                                    <Viewbox.RenderTransform><RotateTransform /></Viewbox.RenderTransform>
                                    <Path Classes="icon fixStep running" Data="{StaticResource IconLoader}" />
                                </Viewbox>
                                <TextBlock Classes="muted" FontSize="13" Text="{l:Loc Fix_Working_Short}" />
                            </StackPanel>
                            <views:MarkdownView x:Name="FixAgentText" Markdown="{Binding Text}" TextElement.FontSize="14" IsVisible="{Binding HasText}" />
                            <ItemsControl ItemsSource="{Binding Choices}" IsVisible="{Binding HasChoices}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel ItemSpacing="6" LineSpacing="6" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="gp:FixChoice">
                                        <Button Classes="chip" Command="{Binding Command}" Content="{Binding Text}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- Change card: a new draft -->
                            <Border Classes="fixCard" IsVisible="{Binding HasChange}">
                                <StackPanel Spacing="12" DataContext="{Binding Change}" x:DataType="gp:FixChangeCard">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock FontWeight="Bold" FontSize="15" Text="{Binding Title}" VerticalAlignment="Center" />
                                        <Border Classes="packTag" Classes.muted="{Binding PillIsMuted}" Classes.gen="{Binding PillIsNew}" Classes.bad="{Binding PillIsBad}">
                                            <TextBlock Text="{Binding Pill}" VerticalAlignment="Center" />
                                        </Border>
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding Tiles}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><UniformGrid Rows="1" ColumnSpacing="8" /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="gp:FixTile">
                                                <Border Classes="fixTile" AutomationProperties.Name="{Binding Title}">
                                                    <StackPanel Spacing="2">
                                                        <TextBlock Classes="muted" FontSize="12" Text="{Binding Title}" TextWrapping="Wrap" />
                                                        <TextBlock Classes="fixValue" FontWeight="Bold" FontSize="14" Text="{Binding Value}" TextWrapping="Wrap"
                                                                   Classes.ok="{Binding IsOk}" Classes.bad="{Binding IsBad}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel Spacing="6" IsVisible="{Binding HasSamples}">
                                        <Grid ColumnDefinitions="150,*,*" ColumnSpacing="10" Margin="10,0">
                                            <TextBlock Classes="faint" FontSize="11" FontWeight="Bold" Text="{l:Loc Fix_Samples_Key}" />
                                            <TextBlock Grid.Column="1" Classes="faint" FontSize="11" FontWeight="Bold" Text="{l:Loc Fix_Samples_Was}" />
                                            <TextBlock Grid.Column="2" Classes="faint" FontSize="11" FontWeight="Bold" Text="{l:Loc Fix_Samples_Now}" />
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding Samples}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="gp:FixSampleRow">
                                                    <Border Classes="fixSample">
                                                        <Grid ColumnDefinitions="150,*,*" ColumnSpacing="10">
                                                            <TextBlock Classes="genKey" Text="{Binding Key}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Key}" />
                                                            <TextBlock Grid.Column="1" Classes="muted" FontSize="13" Text="{Binding Before}" TextWrapping="Wrap" TextDecorations="Strikethrough" />
                                                            <Border Grid.Column="2" Classes="fixIns">
                                                                <TextBlock FontSize="13" Text="{Binding After}" TextWrapping="Wrap" />
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    <WrapPanel ItemSpacing="8" LineSpacing="6">
                                        <Button Classes="accent" Command="{Binding InstallCommand}" IsVisible="{Binding CanInstall}" AutomationProperties.Name="{Binding InstallText}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Viewbox Classes="icon" Width="16" Height="16">
                                                    <Path Classes="icon" Data="{StaticResource IconPlay}" Stroke="{Binding $parent[Button].Foreground}" />
                                                </Viewbox>
                                                <TextBlock Text="{Binding InstallText}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="bare" Command="{Binding UndoCommand}" IsVisible="{Binding CanUndo}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Viewbox Classes="icon" Width="14" Height="14">
                                                    <Path Classes="icon" Data="{StaticResource IconUndo}" Stroke="{Binding $parent[Button].Foreground}" />
                                                </Viewbox>
                                                <TextBlock Text="{l:Loc Fix_Undo}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                            <!-- Plan card: a change of more than 50 strings waits for the player -->
                            <Border Classes="fixCard" IsVisible="{Binding HasPlan}">
                                <StackPanel Spacing="10" DataContext="{Binding Plan}" x:DataType="gp:FixPlanCard">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock FontWeight="Bold" FontSize="15" Text="{Binding Title}" VerticalAlignment="Center" />
                                        <Border Classes="packTag" Classes.muted="{Binding !IsWaiting}" Classes.warn="{Binding IsWaiting}">
                                            <TextBlock Text="{Binding Pill}" VerticalAlignment="Center" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Classes="muted" FontSize="13" Text="{l:Loc Fix_Plan_Intro}" TextWrapping="Wrap" />
                                    <ItemsControl ItemsSource="{Binding Lines}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Border Classes="fixSample" Margin="0,0,0,6">
                                                    <TextBlock FontSize="13" Text="{Binding}" TextWrapping="Wrap" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ItemsControl ItemsSource="{Binding Samples}" IsVisible="{Binding HasSamples}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="gp:FixSampleRow">
                                                <Border Classes="fixSample">
                                                    <Grid ColumnDefinitions="150,*,*" ColumnSpacing="10">
                                                        <TextBlock Classes="genKey" Text="{Binding Key}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Key}" />
                                                        <TextBlock Grid.Column="1" Classes="muted" FontSize="13" Text="{Binding Before}" TextWrapping="Wrap" TextDecorations="Strikethrough" />
                                                        <Border Grid.Column="2" Classes="fixIns">
                                                            <TextBlock FontSize="13" Text="{Binding After}" TextWrapping="Wrap" />
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <WrapPanel ItemSpacing="8" LineSpacing="6" IsVisible="{Binding IsWaiting}">
                                        <Button Classes="genAction" Command="{Binding ApplyCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Viewbox Classes="icon" Width="16" Height="16">
                                                    <Path Classes="icon" Data="{StaticResource IconSparkles}" Stroke="{Binding $parent[Button].Foreground}" />
                                                </Viewbox>
                                                <TextBlock Text="{l:Loc Fix_Plan_Apply}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="bare" Command="{Binding ChangeCommand}" Content="{l:Loc Fix_Plan_Change}" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                            <StackPanel Spacing="2" IsVisible="{Binding HasFailure}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Viewbox Classes="icon" Width="14" Height="14">
                                        <Path Classes="icon" Data="{StaticResource IconXCircle}" Stroke="{DynamicResource AppBadBrush}" />
                                    </Viewbox>
                                    <TextBlock FontSize="13" Foreground="{DynamicResource AppBadBrush}" Text="{Binding Failure}" TextWrapping="Wrap" />
                                </StackPanel>
                                <SelectableTextBlock Classes="faint" FontSize="12" Text="{Binding FailureDetail}" TextWrapping="Wrap" IsVisible="{Binding HasFailureDetail}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ItemsControl.DataTemplates>
        </ItemsControl>
            </StackPanel>
        </StackPanel>

        <!-- Progress card (§6b) -->
        <Border x:Name="ProgressCard" Classes="genCard" IsVisible="{Binding ShowProgress}">
            <StackPanel Spacing="16">
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Right" ItemSpacing="8" LineSpacing="6" VerticalAlignment="Bottom" Margin="12,0,0,4">
                        <Button x:Name="GenPause" Classes="ghost" Command="{Binding PauseCommand}" IsVisible="{Binding ShowPause}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Viewbox Classes="icon" Width="16" Height="16">
                                    <Path Classes="icon" Data="{StaticResource IconPause}" Stroke="{Binding $parent[Button].Foreground}" />
                                </Viewbox>
                                <TextBlock Text="{l:Loc Gen_Action_Pause}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="GenResume" Classes="accent genAction" Command="{Binding ResumeCommand}" IsVisible="{Binding ShowResume}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Viewbox Classes="icon" Width="16" Height="16">
                                    <Path Classes="icon" Data="{StaticResource IconPlay}" Stroke="{Binding $parent[Button].Foreground}" />
                                </Viewbox>
                                <TextBlock Text="{l:Loc Gen_Action_Resume}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="GenRetry" Classes="accent" Command="{Binding ResumeCommand}" IsVisible="{Binding ShowRetry}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Viewbox Classes="icon" Width="16" Height="16">
                                    <Path Classes="icon" Data="{StaticResource IconRefresh}" Stroke="{Binding $parent[Button].Foreground}" />
                                </Viewbox>
                                <TextBlock Text="{Binding RetryText}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="GenCancel" Classes="link" Command="{Binding CancelCommand}" Content="{l:Loc Gen_Action_Cancel}"
                                Foreground="{DynamicResource AppMutedBrush}" VerticalAlignment="Center" />
                    </WrapPanel>
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <TextBlock x:Name="ProgressPercent" Classes="genPercent" Text="{Binding PercentText}" VerticalAlignment="Bottom" />
                        <StackPanel Spacing="2" VerticalAlignment="Bottom" Margin="0,0,0,6">
                            <WrapPanel ItemSpacing="10" LineSpacing="4">
                                <TextBlock x:Name="ProgressTitle" FontWeight="Bold" Text="{Binding ProgressTitle}" VerticalAlignment="Center" />
                                <Border x:Name="ProgressQuality" Classes="qualityChip">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <Viewbox Classes="icon" Width="12" Height="12">
                                            <Path Classes="icon" Data="{Binding QualityChipIcon, Converter={x:Static views:ResourceKeyConverter.Instance}}" />
                                        </Viewbox>
                                        <TextBlock Text="{Binding QualityChip}" />
                                    </StackPanel>
                                </Border>
                            </WrapPanel>
                            <TextBlock x:Name="ProgressDetail" Classes="muted" FontSize="13" Text="{Binding ProgressDetail}" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
                <ProgressBar x:Name="ProgressBar" Classes="genProgress" Classes.paused="{Binding IsBarPaused}" Minimum="0" Maximum="100" Value="{Binding Percent}"
                             AutomationProperties.Name="{Binding PercentText}" />
                <TextBlock x:Name="ActionError" Foreground="{DynamicResource AppWarnBrush}" FontSize="13" TextWrapping="Wrap"
                           Text="{Binding ActionError}" IsVisible="{Binding HasActionError}" />

                <!-- Just translated (Translate stage): key · original · translation, ⚠ with a validator warning -->
                <Border x:Name="RecentBox" Classes="genBox" IsVisible="{Binding ShowRecent}">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse Classes="genLiveDot" IsVisible="{Binding IsRunning}" VerticalAlignment="Center" />
                            <TextBlock Classes="capsLabel" Text="{Binding RecentTitle}" />
                        </StackPanel>
                        <ItemsControl x:Name="RecentList" ItemsSource="{Binding Recent}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="gp:GenerationRecentRow">
                                    <Grid ColumnDefinitions="2*,3*,3*" ColumnSpacing="12" Margin="0,3">
                                        <TextBlock Classes="genKey" Text="{Binding Key}" VerticalAlignment="Top" ToolTip.Tip="{Binding Key}" />
                                        <TextBlock Grid.Column="1" Classes="muted" FontSize="13" Text="{Binding Original}" TextWrapping="Wrap" />
                                        <StackPanel Grid.Column="2" Spacing="4">
                                            <TextBlock FontSize="13" Text="{Binding Translation}" TextWrapping="Wrap" />
                                            <Border Classes="genWarnTag" HorizontalAlignment="Left" IsVisible="{Binding HasWarning}">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <Viewbox Classes="icon" Width="11" Height="11"><Path Classes="icon" Data="{StaticResource IconAlert}" Stroke="{DynamicResource AppWarnBrush}" /></Viewbox>
                                                    <TextBlock Text="{Binding Warning}" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Build & test: the current step with the font swap -->
                <Border x:Name="BuildBox" Classes="genBox" IsVisible="{Binding ShowBuild}">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Viewbox Classes="icon spin" Width="16" Height="16" IsVisible="{Binding IsRunning}">
                                <Viewbox.RenderTransform><RotateTransform /></Viewbox.RenderTransform>
                                <Path Classes="icon" Data="{StaticResource IconLoader}" Stroke="{DynamicResource AppGenBrush}" />
                            </Viewbox>
                            <TextBlock x:Name="BuildStep" FontWeight="SemiBold" Text="{Binding BuildStepText}" />
                        </StackPanel>
                        <TextBlock x:Name="BuildFonts" Classes="muted" FontSize="13" Text="{Binding BuildFontNote}" TextWrapping="Wrap"
                                   IsVisible="{Binding HasBuildFontNote}" />
                        <TextBlock x:Name="BuildTestRunNote" Classes="muted" FontSize="13" Text="{l:Loc Gen_Build_TestRunNote}" TextWrapping="Wrap"
                                   IsVisible="{Binding ShowTestRunNote}" />
                    </StackPanel>
                </Border>

                <!-- Validator and the agent's limit -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                    <Border Classes="genBox">
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Viewbox Classes="icon" Width="16" Height="16" IsVisible="{Binding HasWarnings}">
                                    <Path Classes="icon genWarnIcon" Data="{StaticResource IconAlert}" />
                                </Viewbox>
                                <Viewbox Classes="icon" Width="16" Height="16" IsVisible="{Binding !HasWarnings}">
                                    <Path Classes="icon" Data="{StaticResource IconCheck}" Stroke="{DynamicResource AppOkBrush}" />
                                </Viewbox>
                                <TextBlock x:Name="WarningCount" FontWeight="SemiBold" Text="{Binding WarningCountText}" />
                            </StackPanel>
                            <TextBlock Classes="muted" FontSize="13" Text="{l:Loc Gen_Validator_Hint}" TextWrapping="Wrap" />
                            <Button x:Name="WarningsToggle" Classes="link" HorizontalAlignment="Left" Margin="-4,0,0,0" Command="{Binding ToggleWarningsCommand}"
                                    Content="{Binding WarningsToggleText}" IsVisible="{Binding HasWarnings}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Classes="genBox">
                        <StackPanel Spacing="6">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" x:Name="LimitValue" FontWeight="Bold" Text="{Binding LimitValue}" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Viewbox Classes="icon" Width="16" Height="16"><Path Classes="icon" Data="{StaticResource IconClock}" Stroke="{DynamicResource AppMutedBrush}" /></Viewbox>
                                    <TextBlock x:Name="LimitTitle" FontWeight="SemiBold" Text="{Binding LimitTitle}" />
                                </StackPanel>
                            </DockPanel>
                            <ProgressBar Classes="genLimit" Classes.reached="{Binding IsLimitReached}" Minimum="0" Maximum="100"
                                         Value="{Binding LimitPercent}" IsVisible="{Binding HasLimit}" AutomationProperties.Name="{Binding LimitValue}" />
                            <TextBlock x:Name="LimitNote" Classes="muted" FontSize="12" Text="{Binding LimitNote}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- The validator's list, expanded inline -->
                <ItemsControl x:Name="WarningList" ItemsSource="{Binding Warnings}" IsVisible="{Binding ShowWarnings}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="gp:GenerationWarningRow">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="0,4">
                                <Border Classes="genWarnTag" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding Rule}" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Classes="genKey" Text="{Binding Key}" />
                                    <TextBlock FontSize="13" TextWrapping="Wrap">
                                        <Run Text="{Binding Original}" Foreground="{DynamicResource AppMutedBrush}" FontStyle="Italic" />
                                        <Run Text=" → " Foreground="{DynamicResource AppFaintBrush}" />
                                        <Run Text="{Binding Translation}" />
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Agent activity: the job's log, collapsed -->
                <StackPanel Spacing="8">
                    <Button x:Name="LogToggle" Classes="link" HorizontalAlignment="Left" Margin="-4,0,0,0" Command="{Binding ToggleLogCommand}"
                            Foreground="{DynamicResource AppMutedBrush}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Viewbox Classes="icon" Width="14" Height="14" IsVisible="{Binding !IsLogOpen}">
                                <Path Classes="icon" Data="{StaticResource IconChevronRight}" Stroke="{DynamicResource AppMutedBrush}" />
                            </Viewbox>
                            <Viewbox Classes="icon" Width="14" Height="14" IsVisible="{Binding IsLogOpen}">
                                <Path Classes="icon" Data="{StaticResource IconChevronDown}" Stroke="{DynamicResource AppMutedBrush}" />
                            </Viewbox>
                            <TextBlock Text="{l:Loc Gen_Log_Title}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <TextBox x:Name="AgentLog" Classes="log" Text="{Binding LogText, Mode=OneWay}" IsVisible="{Binding IsLogOpen}"
                             AutomationProperties.Name="{l:Loc Gen_Log_Title}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
