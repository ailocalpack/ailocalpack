<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AiLocalPack.Desktop.ViewModels"
        xmlns:views="using:AiLocalPack.Desktop.Views"
        x:Class="AiLocalPack.Desktop.Views.SplashWindow"
        x:DataType="vm:SplashViewModel"
        Title="ailocalpack"
        Icon="/Assets/app-icon.ico"
        Width="480" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="None"
        Background="Transparent" TransparencyLevelHint="Transparent">
    <!-- Design §9: a small borderless window while the blocking startup steps run; the main window replaces it. -->
    <Border x:Name="Card" CornerRadius="16" Padding="32,32,32,20"
            Background="{DynamicResource AppSurfaceBrush}"
            BorderBrush="{DynamicResource AppBorderStrongBrush}" BorderThickness="1">
        <StackPanel Spacing="18">
            <StackPanel Spacing="10" HorizontalAlignment="Center">
                <Panel Width="64" Height="64" HorizontalAlignment="Center">
                    <Border Classes="breathe" Margin="-6" CornerRadius="22" BorderThickness="2"
                            BorderBrush="{DynamicResource AppAccentBrush}" RenderTransform="scale(1)" />
                    <Border CornerRadius="18" Background="{StaticResource AppLogoBrush}" BoxShadow="0 12 40 0 #595566f0">
                        <TextBlock Text="al" Foreground="White" FontSize="26" FontWeight="ExtraBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Panel>
                <TextBlock Text="ailocalpack" FontSize="20" FontWeight="ExtraBold" HorizontalAlignment="Center" />
                <TextBlock x:Name="Version" Text="{Binding Version}" FontSize="12" Margin="0,-6,0,0"
                           Foreground="{DynamicResource AppFaintBrush}" HorizontalAlignment="Center" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock x:Name="Current" Text="{Binding CurrentText}" FontSize="14" FontWeight="SemiBold"
                           HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MinHeight="20" />
                <ProgressBar x:Name="Bar" Classes="splashBar" Minimum="0" Maximum="100" Value="{Binding Percent}"
                             AutomationProperties.Name="{Binding CurrentText}" />
            </StackPanel>

            <Border x:Name="WarningNote" Classes="notice warn" IsVisible="{Binding HasWarning}">
                <DockPanel>
                    <Viewbox DockPanel.Dock="Left" Classes="icon" Width="16" Height="16" Margin="0,1,10,0" VerticalAlignment="Top">
                        <Path Classes="icon" Data="{StaticResource IconAlert}" Stroke="{DynamicResource AppWarnBrush}" />
                    </Viewbox>
                    <TextBlock Text="{Binding Warning}" />
                </DockPanel>
            </Border>
            <Border x:Name="SlowNote" Classes="notice info" IsVisible="{Binding IsSlow}">
                <DockPanel>
                    <Viewbox DockPanel.Dock="Left" Classes="icon spin" Width="16" Height="16" Margin="0,1,10,0" VerticalAlignment="Top">
                        <Path Classes="icon" Data="{StaticResource IconLoader}" Stroke="{DynamicResource AppAccentBrush}" />
                    </Viewbox>
                    <TextBlock Text="{Binding SlowText}" />
                </DockPanel>
            </Border>

            <ItemsControl x:Name="Steps" ItemsSource="{Binding Steps}" IsVisible="{Binding IsDetailsOpen}" Focusable="False" />

            <Button x:Name="DetailsToggle" Classes="splashToggle" HorizontalAlignment="Center" Margin="0,-6,0,0"
                    Command="{Binding ToggleDetailsCommand}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="{Binding ToggleText}" VerticalAlignment="Center" />
                    <Viewbox Classes="icon" Width="14" Height="14" RenderTransform="{Binding IsDetailsOpen, Converter={x:Static views:SplashWindow.ChevronTurn}}">
                        <Path Classes="icon" Data="{StaticResource IconChevronDown}" Stroke="{Binding $parent[Button].Foreground}" />
                    </Viewbox>
                </StackPanel>
            </Button>
        </StackPanel>
    </Border>
</Window>
