<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AiLocalPack.Desktop.ViewModels"
             xmlns:s="using:AiLocalPack.Desktop.ViewModels.Settings"
             xmlns:lib="using:AiLocalPack.Desktop.ViewModels.Settings.Libraries"
             xmlns:ag="using:AiLocalPack.Desktop.ViewModels.Settings.Agents"
             xmlns:gh="using:AiLocalPack.Desktop.ViewModels.Settings.GitHub"
             xmlns:st="using:AiLocalPack.Desktop.ViewModels.Settings.Storage"
             xmlns:ab="using:AiLocalPack.Desktop.ViewModels.Settings.About"
             xmlns:views="using:AiLocalPack.Desktop.Views"
             xmlns:l="using:AiLocalPack.Desktop.Localization"
             x:Class="AiLocalPack.Desktop.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
    <!-- Design §8: 272 px section list with search, the selected section (or search results) on the right. -->
    <UserControl.Resources>
        <!-- Left half of every row: label (search match highlighted), explanation, optional link. -->
        <DataTemplate x:Key="RowLabel" x:DataType="s:SettingRow">
            <StackPanel Spacing="3" Margin="0,0,16,0" VerticalAlignment="Center">
                <views:HighlightTextBlock Classes="rowLabel" Source="{Binding Label}"
                                          Highlight="{Binding $parent[views:SettingsView].((vm:SettingsViewModel)DataContext).Query}" />
                <TextBlock Classes="rowHelp" Text="{Binding Help}" IsVisible="{Binding Help, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <HyperlinkButton Classes="inline" Content="{Binding HelpLinkText}" NavigateUri="{Binding HelpLinkUri}" IsVisible="{Binding HasHelpLink}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.DataTemplates>
        <DataTemplate DataType="s:DropdownSettingRow">
            <Border Classes="settingRow">
                <Grid ColumnDefinitions="*,Auto">
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource RowLabel}" />
                    <ComboBox Grid.Column="1" MinWidth="240" VerticalAlignment="Center"
                              ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}"
                              AutomationProperties.Name="{Binding Label}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="s:ChoiceOption"><TextBlock Text="{Binding Display}" /></DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate DataType="s:SegmentedSettingRow">
            <Border Classes="settingRow">
                <Grid ColumnDefinitions="*,Auto">
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource RowLabel}" />
                    <ListBox Grid.Column="1" Classes="segmented" VerticalAlignment="Center"
                             ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}"
                             AutomationProperties.Name="{Binding Label}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="s:ChoiceOption"><TextBlock Text="{Binding Display}" /></DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate DataType="s:ToggleSettingRow">
            <Border Classes="settingRow">
                <Grid ColumnDefinitions="*,Auto">
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource RowLabel}" />
                    <ToggleSwitch Grid.Column="1" Classes="bare" VerticalAlignment="Center"
                                  IsChecked="{Binding IsOn}" AutomationProperties.Name="{Binding Label}" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="s:NumberSettingRow">
            <Border Classes="settingRow">
                <Grid ColumnDefinitions="*,Auto">
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource RowLabel}" />
                    <NumericUpDown Grid.Column="1" MinWidth="120" VerticalAlignment="Center"
                                   Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" Increment="1" FormatString="0"
                                   ParsingNumberStyle="Integer" ClipValueToMinMax="True"
                                   Value="{Binding Value}" AutomationProperties.Name="{Binding Label}" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Settings → AI agents -->
        <DataTemplate DataType="ag:AgentRow">
            <Border Classes="settingRow">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                    <views:AgentLogo DataContext="{Binding Info}" VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1" Spacing="4" Margin="0,0,16,0" VerticalAlignment="Center">
                        <WrapPanel>
                            <views:HighlightTextBlock Classes="rowLabel" Source="{Binding Label}" Margin="0,0,10,0" VerticalAlignment="Center"
                                                      Highlight="{Binding $parent[views:SettingsView].((vm:SettingsViewModel)DataContext).Query}" />
                            <Border x:Name="AgentStatus" Classes="agentStatus" Classes.ok="{Binding IsStatusOk}" Classes.warn="{Binding IsStatusWarn}"
                                    Classes.accent="{Binding IsStatusTinted}" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <Viewbox Classes="icon" Width="12" Height="12" Classes.spin="{Binding IsStatusBusy}">
                                        <Viewbox.RenderTransform><RotateTransform /></Viewbox.RenderTransform>
                                        <Panel>
                                            <Path Classes="icon" Data="{StaticResource IconCheckCircle}" IsVisible="{Binding IsStatusOk}" />
                                            <Path Classes="icon" Data="{StaticResource IconAlert}" IsVisible="{Binding IsStatusWarn}" />
                                            <Path Classes="icon" Data="{StaticResource IconLoader}" IsVisible="{Binding IsStatusBusy}" />
                                            <Path Classes="icon" Data="{StaticResource IconLock}" IsVisible="{Binding IsStatusAccent}" />
                                            <Path Classes="icon" Data="{StaticResource IconCircleDashed}" IsVisible="{Binding CanInstall}" />
                                        </Panel>
                                    </Viewbox>
                                    <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                        <TextBlock Classes="rowHelp mono" Text="{Binding SourceText}" IsVisible="{Binding HasSource}" TextWrapping="Wrap" />
                        <ProgressBar Classes="installProgress" Maximum="100" Value="{Binding Percent}" IsVisible="{Binding HasProgress}" MaxWidth="360" HorizontalAlignment="Left" Width="360" />
                        <TextBlock Classes="rowHelp" Text="{Binding Help}" TextWrapping="Wrap"
                                   IsVisible="{Binding Help, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        <TextBlock x:Name="AgentError" Classes="error" Text="{Binding Error}" IsVisible="{Binding HasError}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Button Classes="accent sm" Command="{Binding InstallCommand}" IsVisible="{Binding CanInstall}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Viewbox Classes="icon" Width="14" Height="14">
                                    <Path Classes="icon" Data="{StaticResource IconDownload}" Stroke="{Binding $parent[Button].Foreground}" />
                                </Viewbox>
                                <TextBlock Text="{Binding InstallText}" />
                            </StackPanel>
                        </Button>
                        <Button Classes="accent sm" Command="{Binding SignInCommand}" IsVisible="{Binding CanSignIn}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Viewbox Classes="icon" Width="14" Height="14">
                                    <Path Classes="icon" Data="{StaticResource IconLock}" Stroke="{Binding $parent[Button].Foreground}" />
                                </Viewbox>
                                <TextBlock Text="{Binding SignInText}" />
                            </StackPanel>
                        </Button>
                        <Button Classes="ghost sm" Command="{Binding UpdateCommand}" IsVisible="{Binding CanUpdate}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Viewbox Classes="icon" Width="14" Height="14">
                                    <Path Classes="icon" Data="{StaticResource IconRefresh}" Stroke="{Binding $parent[Button].Foreground}" />
                                </Viewbox>
                                <TextBlock Text="{Binding UpdateText}" />
                            </StackPanel>
                        </Button>
                        <Button Classes="ghost sm" Command="{Binding CheckAgainCommand}" IsVisible="{Binding CanCheckAgain}" Content="{Binding CheckAgainText}" />
                        <Button Classes="bare sm" Command="{Binding SignOutCommand}" IsVisible="{Binding CanSignOut}" Content="{Binding SignOutText}" />
                        <Button Classes="bare sm" Command="{Binding CancelCommand}" IsVisible="{Binding CanCancel}" Content="{Binding CancelText}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate DataType="ag:DefaultAgentRow">
            <Border Classes="settingRow">
                <Grid ColumnDefinitions="*,Auto">
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource RowLabel}" />
                    <ListBox Grid.Column="1" Classes="segmented" VerticalAlignment="Center" IsVisible="{Binding HasReadyAgent}"
                             ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedChoice}"
                             AutomationProperties.Name="{Binding Label}">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem" x:DataType="ag:AgentChoice">
                                <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="ag:AgentChoice"><TextBlock Text="{Binding Display}" /></DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Grid.Column="1" Classes="hint" VerticalAlignment="Center" Text="{Binding NoAgentText}" IsVisible="{Binding !HasReadyAgent}" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Settings → Libraries -->
        <DataTemplate DataType="lib:SteamSummaryRow">
            <Border Classes="settingRow">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                    <Border Classes="rowPic">
                        <Viewbox Classes="icon" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Classes="brand" Data="{StaticResource BrandSteam}" />
                        </Viewbox>
                    </Border>
                    <ContentControl Grid.Column="1" Content="{Binding}" ContentTemplate="{StaticResource RowLabel}" />
                    <Button x:Name="RescanButton" Grid.Column="2" Classes="ghost sm" VerticalAlignment="Center"
                            Command="{Binding RescanCommand}" AutomationProperties.Name="{Binding RescanText}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Viewbox Classes="icon" Width="14" Height="14" Classes.spin="{Binding IsScanning}">
                                <Viewbox.RenderTransform><RotateTransform /></Viewbox.RenderTransform>
                                <Panel>
                                    <Path Classes="icon" Stroke="{Binding $parent[Button].Foreground}" Data="{StaticResource IconLoader}" IsVisible="{Binding IsScanning}" />
                                    <Path Classes="icon" Stroke="{Binding $parent[Button].Foreground}" Data="{StaticResource IconRefresh}" IsVisible="{Binding !IsScanning}" />
                                </Panel>
                            </Viewbox>
                            <TextBlock Text="{Binding RescanText}" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate DataType="lib:LibraryFolderRow">
            <Border Classes="settingRow">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                    <Border Classes="rowPic" Classes.warn="{Binding !IsAvailable}">
                        <Viewbox Classes="icon" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Panel>
                                <Path Classes="icon" Data="{StaticResource IconHardDrive}" Stroke="{DynamicResource AppMutedBrush}" IsVisible="{Binding IsAvailable}" />
                                <Path Classes="icon" Data="{StaticResource IconHardDrive}" Stroke="{DynamicResource AppWarnBrush}" IsVisible="{Binding !IsAvailable}" />
                            </Panel>
                        </Viewbox>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="3" Margin="0,0,16,0" VerticalAlignment="Center">
                        <views:HighlightTextBlock x:Name="FolderPath" Classes="mono" Classes.struck="{Binding !IsAvailable}" Source="{Binding Label}" TextWrapping="Wrap"
                                                  Highlight="{Binding $parent[views:SettingsView].((vm:SettingsViewModel)DataContext).Query}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Classes="fact warn" IsVisible="{Binding !IsAvailable}">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <Viewbox Classes="icon" Width="12" Height="12">
                                        <Path Classes="icon" Data="{StaticResource IconAlert}" Stroke="{DynamicResource AppWarnBrush}" />
                                    </Viewbox>
                                    <TextBlock Text="{Binding NotAvailableText}" />
                                </StackPanel>
                            </Border>
                            <TextBlock Classes="rowHelp" Text="{Binding Help}" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Button Classes="ghost sm" Command="{Binding RescanCommand}" IsVisible="{Binding !IsAvailable}" Content="{Binding RescanText}" />
                        <Button Classes="bare sm" Command="{Binding OpenCommand}" IsVisible="{Binding IsAvailable}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Viewbox Classes="icon" Width="14" Height="14">
                                    <Path Classes="icon" Data="{StaticResource IconExternal}" Stroke="{Binding $parent[Button].Foreground}" />
                                </Viewbox>
                                <TextBlock Text="{Binding OpenText}" />
                            </StackPanel>
                        </Button>
                        <Button Classes="bare sm" Command="{Binding RemoveCommand}" IsVisible="{Binding CanRemove}" Content="{Binding RemoveText}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate DataType="lib:ManualGameRow">
            <Border Classes="settingRow">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                    <Border Classes="rowPic" Classes.warn="{Binding !IsAvailable}">
                        <Viewbox Classes="icon" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Panel>
                                <Path Classes="icon" Data="{StaticResource IconFolder}" Stroke="{DynamicResource AppMutedBrush}" IsVisible="{Binding IsAvailable}" />
                                <Path Classes="icon" Data="{StaticResource IconFolder}" Stroke="{DynamicResource AppWarnBrush}" IsVisible="{Binding !IsAvailable}" />
                            </Panel>
                        </Viewbox>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="3" Margin="0,0,16,0" VerticalAlignment="Center">
                        <views:HighlightTextBlock Classes="rowLabel" Source="{Binding Label}"
                                                  Highlight="{Binding $parent[views:SettingsView].((vm:SettingsViewModel)DataContext).Query}" />
                        <WrapPanel>
                            <TextBlock Classes="mono" Foreground="{DynamicResource AppMutedBrush}" Text="{Binding Path}" TextWrapping="Wrap" />
                            <TextBlock Classes="rowHelp" Text=" · " IsVisible="{Binding HasEngine}" />
                            <TextBlock Classes="rowHelp" Text="{Binding Engine}" IsVisible="{Binding HasEngine}" />
                        </WrapPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Button Classes="bare sm" Command="{Binding OpenCommand}" IsVisible="{Binding IsAvailable}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Viewbox Classes="icon" Width="14" Height="14">
                                    <Path Classes="icon" Data="{StaticResource IconExternal}" Stroke="{Binding $parent[Button].Foreground}" />
                                </Viewbox>
                                <TextBlock Text="{Binding OpenText}" />
                            </StackPanel>
                        </Button>
                        <Button Classes="bare sm" Command="{Binding RemoveCommand}" Content="{Binding RemoveText}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate DataType="lib:ActionSettingRow">
            <Border Classes="settingRow" MinHeight="52" Padding="10,6">
                <StackPanel Spacing="4" VerticalAlignment="Center">
                    <WrapPanel>
                        <Button Classes="bare sm" Command="{Binding Command}" AutomationProperties.Name="{Binding Label}" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Viewbox Classes="icon" Width="14" Height="14">
                                    <Path Classes="icon" Stroke="{Binding $parent[Button].Foreground}"
                                          Data="{Binding IconKey, Converter={x:Static views:ResourceKeyConverter.Instance}}" />
                                </Viewbox>
                                <views:HighlightTextBlock Source="{Binding Label}"
                                                          Highlight="{Binding $parent[views:SettingsView].((vm:SettingsViewModel)DataContext).Query}" />
                            </StackPanel>
                        </Button>
                        <TextBlock Classes="hint" Text="{Binding Help}" VerticalAlignment="Center"
                                   IsVisible="{Binding Help, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </WrapPanel>
                    <TextBlock Classes="error" Margin="10,0" Text="{Binding Error}" IsVisible="{Binding HasError}" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate DataType="lib:TextSettingRow">
            <Border Classes="settingRow">
                <TextBlock Classes="rowHelp" VerticalAlignment="Center" Text="{Binding Label}" />
            </Border>
        </DataTemplate>
        <DataTemplate DataType="lib:ComingSoonSettingRow">
            <Border Classes="settingRow">
                <Grid ColumnDefinitions="*,Auto">
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource RowLabel}" Opacity="0.75" />
                    <Border Grid.Column="1" Classes="soonPill" VerticalAlignment="Center">
                        <TextBlock Text="{Binding PillText}" />
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Settings → Storage -->
        <DataTemplate DataType="st:StorageSummaryRow">
            <Border Classes="settingRow">
                <StackPanel Spacing="10" VerticalAlignment="Center">
                    <views:HighlightTextBlock x:Name="StorageTotal" Classes="rowLabel" Source="{Binding Label}"
                                              Highlight="{Binding $parent[views:SettingsView].((vm:SettingsViewModel)DataContext).Query}" />
                    <views:StackedBar Height="12" First="{Binding BackupsShare}" Second="{Binding WorkingCopiesShare}" Third="{Binding CacheShare}"
                                      FirstBrush="{DynamicResource AppAccentFillBrush}" SecondBrush="{DynamicResource AppGenBrush}" ThirdBrush="{DynamicResource AppWarnBrush}"
                                      Track="{DynamicResource AppBorderBrush}" IsVisible="{Binding IsMeasured}" />
                    <WrapPanel IsVisible="{Binding IsMeasured}">
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,16,4">
                            <Border Width="10" Height="10" CornerRadius="3" Background="{DynamicResource AppAccentFillBrush}" />
                            <TextBlock Classes="rowHelp" Text="{Binding BackupsLegend}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,16,4">
                            <Border Width="10" Height="10" CornerRadius="3" Background="{DynamicResource AppGenBrush}" />
                            <TextBlock Classes="rowHelp" Text="{Binding WorkingCopiesLegend}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,16,4">
                            <Border Width="10" Height="10" CornerRadius="3" Background="{DynamicResource AppWarnBrush}" />
                            <TextBlock Classes="rowHelp" Text="{Binding CacheLegend}" />
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate DataType="st:BackupsRow">
            <Border Classes="settingRow">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                    <Border Classes="rowPic">
                        <Viewbox Classes="icon" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Classes="icon" Data="{StaticResource IconHardDrive}" Stroke="{DynamicResource AppMutedBrush}" />
                        </Viewbox>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="3" Margin="0,0,16,0" VerticalAlignment="Center">
                        <views:HighlightTextBlock Classes="rowLabel" Source="{Binding Label}"
                                                  Highlight="{Binding $parent[views:SettingsView].((vm:SettingsViewModel)DataContext).Query}" />
                        <TextBlock x:Name="BackupsHelp" Classes="rowHelp" Text="{Binding Help}" />
                        <TextBlock x:Name="BackupsFolder" Classes="mono" Foreground="{DynamicResource AppMutedBrush}" Text="{Binding Folder}" TextWrapping="Wrap" />
                        <TextBlock x:Name="BackupsError" Classes="error" Text="{Binding Error}" IsVisible="{Binding HasError}" TextWrapping="Wrap" />
                        <TextBlock Classes="rowHelp" Text="{Binding Note}" IsVisible="{Binding HasNote}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Button Classes="bare sm" Command="{Binding OpenCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Viewbox Classes="icon" Width="14" Height="14">
                                    <Path Classes="icon" Data="{StaticResource IconExternal}" Stroke="{Binding $parent[Button].Foreground}" />
                                </Viewbox>
                                <TextBlock Text="{Binding OpenText}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ChangeBackups" Classes="ghost sm" Command="{Binding ChangeCommand}" Content="{Binding ChangeText}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate DataType="st:WorkingCopyRow">
            <Border Classes="settingRow">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                    <Border Classes="rowPic" Classes.warn="{Binding LosesProgress}">
                        <Viewbox Classes="icon" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Panel>
                                <Path Classes="icon" Data="{StaticResource IconFolder}" Stroke="{DynamicResource AppMutedBrush}" IsVisible="{Binding !LosesProgress}" />
                                <Path Classes="icon" Data="{StaticResource IconFolder}" Stroke="{DynamicResource AppWarnBrush}" IsVisible="{Binding LosesProgress}" />
                            </Panel>
                        </Viewbox>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="3" Margin="0,0,16,0" VerticalAlignment="Center">
                        <views:HighlightTextBlock Classes="rowLabel" Source="{Binding Label}"
                                                  Highlight="{Binding $parent[views:SettingsView].((vm:SettingsViewModel)DataContext).Query}" />
                        <TextBlock Classes="rowHelp" Text="{Binding Help}" />
                        <TextBlock Classes="error" Text="{Binding Error}" IsVisible="{Binding HasError}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Panel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Classes="hint" Text="{Binding RunningText}" IsVisible="{Binding IsRunning}" VerticalAlignment="Center" />
                        <Button Classes="bare sm" Command="{Binding DeleteCommand}" IsVisible="{Binding !IsRunning}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Viewbox Classes="icon" Width="14" Height="14">
                                    <Path Classes="icon" Data="{StaticResource IconTrash}" Stroke="{Binding $parent[Button].Foreground}" />
                                </Viewbox>
                                <TextBlock Text="{Binding DeleteText}" />
                            </StackPanel>
                        </Button>
                    </Panel>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate DataType="st:CacheRow">
            <Border Classes="settingRow">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="3" Margin="0,0,16,0" VerticalAlignment="Center">
                        <views:HighlightTextBlock Classes="rowLabel" Source="{Binding Label}"
                                                  Highlight="{Binding $parent[views:SettingsView].((vm:SettingsViewModel)DataContext).Query}" />
                        <TextBlock x:Name="CacheHelp" Classes="rowHelp" Text="{Binding Help}" />
                        <TextBlock Classes="rowHelp" Classes.error="{Binding ResultIsError}" Text="{Binding Result}" IsVisible="{Binding HasResult}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button x:Name="ClearCache" Grid.Column="1" Classes="ghost sm" VerticalAlignment="Center"
                            Command="{Binding ClearCommand}" Content="{Binding ClearText}" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Settings → About (task 67) -->
        <DataTemplate DataType="ab:AboutHeader">
            <StackPanel Orientation="Horizontal" Spacing="16">
                <Image Source="/Assets/logo.png" Width="56" Height="56" RenderOptions.BitmapInterpolationMode="HighQuality" />
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <SelectableTextBlock x:Name="AboutVersion" Classes="h1" FontSize="22" Text="{Binding Title}" />
                    <SelectableTextBlock x:Name="AboutMeta" Classes="muted" FontSize="13" Text="{Binding Meta}" TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="ab:AppUpdateRow">
            <Border Classes="settingRow">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="3" Margin="0,0,16,0" VerticalAlignment="Center">
                        <views:HighlightTextBlock Classes="rowLabel" Source="{Binding Label}"
                                                  Highlight="{Binding $parent[views:SettingsView].((vm:SettingsViewModel)DataContext).Query}" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Viewbox Classes="icon" Width="14" Height="14" VerticalAlignment="Top" Margin="0,2,0,0" IsVisible="{Binding IsLatest}">
                                <Path Classes="icon" Data="{StaticResource IconCheckCircle}" Stroke="{DynamicResource AppOkBrush}" />
                            </Viewbox>
                            <TextBlock x:Name="UpdateHelp" Classes="rowHelp" Classes.bad="{Binding IsFailed}" Text="{Binding Help}" />
                        </StackPanel>
                        <HyperlinkButton x:Name="WhatsNew" Classes="inline" Content="{Binding WhatsNewText}" Command="{Binding WhatsNewCommand}" IsVisible="{Binding IsReady}" />
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding Percent}"
                                     IsVisible="{Binding IsDownloading}" Height="4" MinHeight="4" Margin="0,4,0,0" />
                        <TextBlock x:Name="UpdateError" Classes="error" Text="{Binding Error}" IsVisible="{Binding HasError}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Panel Grid.Column="1" VerticalAlignment="Center">
                        <Button x:Name="CheckUpdates" Classes="ghost sm" Command="{Binding CheckCommand}" IsVisible="{Binding CanCheck}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Viewbox Classes="icon" Width="14" Height="14">
                                    <Path Classes="icon" Data="{StaticResource IconRefresh}" Stroke="{Binding $parent[Button].Foreground}" />
                                </Viewbox>
                                <TextBlock Text="{Binding CheckText}" />
                            </StackPanel>
                        </Button>
                        <Button Classes="ghost sm" IsEnabled="False" IsVisible="{Binding IsChecking}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Viewbox Classes="icon spin" Width="14" Height="14">
                                    <Viewbox.RenderTransform><RotateTransform /></Viewbox.RenderTransform>
                                    <Path Classes="icon" Data="{StaticResource IconLoader}" Stroke="{Binding $parent[Button].Foreground}" />
                                </Viewbox>
                                <TextBlock Text="{Binding CheckingText}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="RestartToUpdate" Classes="accent sm" Command="{Binding RestartCommand}" IsVisible="{Binding IsReady}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Viewbox Classes="icon" Width="14" Height="14">
                                    <Path Classes="icon" Data="{StaticResource IconDownload}" Stroke="{Binding $parent[Button].Foreground}" />
                                </Viewbox>
                                <TextBlock Text="{Binding RestartText}" />
                            </StackPanel>
                        </Button>
                        <Button Classes="accent sm" IsEnabled="False" IsVisible="{Binding IsRestarting}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Viewbox Classes="icon spin" Width="14" Height="14">
                                    <Viewbox.RenderTransform><RotateTransform /></Viewbox.RenderTransform>
                                    <Path Classes="icon" Data="{StaticResource IconLoader}" Stroke="{Binding $parent[Button].Foreground}" />
                                </Viewbox>
                                <TextBlock Text="{Binding RestartingText}" />
                            </StackPanel>
                        </Button>
                    </Panel>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate DataType="ab:LinkSettingRow">
            <Border Classes="settingRow" Padding="0">
                <Button Classes="bare rowLink" Command="{Binding OpenCommand}" AutomationProperties.Name="{Binding Label}" ToolTip.Tip="{Binding Uri}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <Border Classes="rowPic">
                            <Viewbox Classes="icon" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Panel>
                                    <Path Classes="brand" Data="{Binding IconKey, Converter={x:Static views:ResourceKeyConverter.Instance}}" IsVisible="{Binding IsBrand}" />
                                    <Path Classes="icon" Data="{Binding IconKey, Converter={x:Static views:ResourceKeyConverter.Instance}}"
                                          Stroke="{DynamicResource AppMutedBrush}" IsVisible="{Binding !IsBrand}" />
                                </Panel>
                            </Viewbox>
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                            <views:HighlightTextBlock Classes="rowLabel" Source="{Binding Label}"
                                                      Highlight="{Binding $parent[views:SettingsView].((vm:SettingsViewModel)DataContext).Query}" />
                            <TextBlock Classes="rowHelp" Text="{Binding Help}" />
                        </StackPanel>
                        <Viewbox Grid.Column="2" Classes="icon" Width="14" Height="14" VerticalAlignment="Center">
                            <Path Classes="icon" Data="{StaticResource IconExternal}" Stroke="{DynamicResource AppMutedBrush}" />
                        </Viewbox>
                    </Grid>
                </Button>
            </Border>
        </DataTemplate>
        <DataTemplate DataType="ab:WelcomeTourRow">
            <Border Classes="settingRow">
                <Grid ColumnDefinitions="*,Auto">
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource RowLabel}" />
                    <Button x:Name="ShowWelcomeTour" Grid.Column="1" Classes="ghost sm" VerticalAlignment="Center" Command="{Binding ShowCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Viewbox Classes="icon" Width="14" Height="14">
                                <Path Classes="icon" Data="{StaticResource IconHelp}" Stroke="{Binding $parent[Button].Foreground}" />
                            </Viewbox>
                            <TextBlock Text="{Binding ShowText}" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate DataType="ab:LicensesRow">
            <Border Classes="settingRow">
                <Grid ColumnDefinitions="*,Auto">
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource RowLabel}" />
                    <Button x:Name="ThirdPartyNotices" Grid.Column="1" Classes="bare sm" VerticalAlignment="Center" Command="{Binding NoticesCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Viewbox Classes="icon" Width="14" Height="14">
                                <Path Classes="icon" Data="{StaticResource IconFile}" Stroke="{Binding $parent[Button].Foreground}" />
                            </Viewbox>
                            <TextBlock Text="{Binding NoticesText}" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate DataType="ab:InfoSettingRow">
            <Border Classes="settingRow">
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource RowLabel}" />
            </Border>
        </DataTemplate>

        <!-- Settings → GitHub -->
        <DataTemplate DataType="gh:GitHubAccountRow">
            <Border Classes="settingRow">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                    <Border Classes="avatar" IsVisible="{Binding IsSignedIn}">
                        <Panel>
                            <TextBlock Text="{Binding AvatarLetter}" IsVisible="{Binding !HasAvatar}" />
                            <Image x:Name="GitHubAvatar" Source="{Binding Avatar}" Stretch="UniformToFill" IsVisible="{Binding HasAvatar}" />
                        </Panel>
                    </Border>
                    <Border Classes="rowPic" IsVisible="{Binding IsSignedOut}" VerticalAlignment="Top">
                        <Viewbox Classes="icon" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Classes="brand" Data="{StaticResource BrandGitHub}" />
                        </Viewbox>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="4" Margin="0,0,16,0" VerticalAlignment="Center">
                        <WrapPanel>
                            <views:HighlightTextBlock x:Name="GitHubLogin" Classes="rowLabel" Source="{Binding Title}" Margin="0,0,8,0" VerticalAlignment="Center"
                                                      Highlight="{Binding $parent[views:SettingsView].((vm:SettingsViewModel)DataContext).Query}" />
                            <TextBlock Classes="rowHelp" Text="{Binding FullName}" IsVisible="{Binding HasFullName}" VerticalAlignment="Center" />
                        </WrapPanel>
                        <TextBlock x:Name="GitHubHelp" Classes="rowHelp" Text="{Binding Help}" TextWrapping="Wrap"
                                   IsVisible="{Binding Help, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        <HyperlinkButton Classes="inline" Content="{Binding HelpLinkText}" NavigateUri="{Binding HelpLinkUri}" IsVisible="{Binding HasHelpLink}" />
                        <TextBlock x:Name="GitHubWarning" Classes="rowHelp" Foreground="{DynamicResource AppWarnBrush}" Text="{Binding Warning}"
                                   IsVisible="{Binding HasWarning}" TextWrapping="Wrap" />
                        <TextBlock Classes="error" Text="{Binding Error}" IsVisible="{Binding HasError}" TextWrapping="Wrap" />
                        <views:GitHubSignInView x:Name="GitHubDeviceFlow" DataContext="{Binding SignIn}" Margin="0,6,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top">
                        <Button x:Name="GitHubSignIn" Classes="accent sm" Command="{Binding SignInCommand}" IsVisible="{Binding CanSignIn}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Viewbox Classes="icon" Width="14" Height="14">
                                    <Path Classes="brand" Data="{StaticResource BrandGitHub}" Fill="{Binding $parent[Button].Foreground}" />
                                </Viewbox>
                                <TextBlock Text="{Binding SignInText}" />
                            </StackPanel>
                        </Button>
                        <Button Classes="ghost sm" Command="{Binding CheckAgainCommand}" IsVisible="{Binding CanCheckAgain}" Content="{Binding CheckAgainText}" />
                        <Button x:Name="GitHubProfile" Classes="bare sm" Command="{Binding OpenProfileCommand}" IsVisible="{Binding IsSignedIn}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Viewbox Classes="icon" Width="14" Height="14">
                                    <Path Classes="icon" Data="{StaticResource IconExternal}" Stroke="{Binding $parent[Button].Foreground}" />
                                </Viewbox>
                                <TextBlock Text="{Binding ProfileText}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="GitHubSignOut" Classes="bare sm" Command="{Binding SignOutCommand}" IsVisible="{Binding IsSignedIn}" Content="{Binding SignOutText}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate DataType="gh:PublishedPacksRow">
            <StackPanel>
                <Border Classes="settingRow" IsVisible="{Binding IsEmpty}">
                    <TextBlock x:Name="PublishedPacksEmpty" Classes="rowHelp" VerticalAlignment="Center" Text="{Binding Text}" TextWrapping="Wrap" />
                </Border>
                <!-- Task 62: name, game · language · rev, status, 👍, Discussion / PR / Fix and resubmit -->
                <ItemsControl x:Name="PublishedPacksList" ItemsSource="{Binding Packs}" IsVisible="{Binding HasPacks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="gh:PublishedPackItem">
                            <Border Classes="settingRow">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="4" Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Classes="rowLabel" Text="{Binding Title}" TextWrapping="Wrap" />
                                        <TextBlock Classes="rowHelp" Text="{Binding Meta}" TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <TextBlock x:Name="PublishedPackStatus" Classes="rowHelp" Text="{Binding StatusText}"
                                                       Classes.bad="{Binding IsBad}" Classes.ok="{Binding IsOk}" VerticalAlignment="Center" />
                                            <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding HasLikes}"
                                                        ToolTip.Tip="{Binding LikesName}" AutomationProperties.Name="{Binding LikesName}">
                                                <Viewbox Classes="icon" Width="13" Height="13" VerticalAlignment="Center">
                                                    <Path Classes="icon" Data="{StaticResource IconThumbsUp}" Stroke="{DynamicResource AppMutedBrush}" />
                                                </Viewbox>
                                                <TextBlock Classes="rowHelp" Text="{Binding Likes}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Button x:Name="PublishedPackResubmit" Classes="accent sm" Command="{Binding ResubmitCommand}" IsVisible="{Binding CanResubmit}"
                                                Content="{l:Loc Publish_Resubmit}" />
                                        <Button Classes="bare sm" Command="{Binding DiscussionCommand}" IsVisible="{Binding HasDiscussion}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Viewbox Classes="icon" Width="14" Height="14">
                                                    <Path Classes="icon" Data="{StaticResource IconExternal}" Stroke="{Binding $parent[Button].Foreground}" />
                                                </Viewbox>
                                                <TextBlock Text="{l:Loc Publish_Discussion}" />
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="PublishedPackPr" Classes="bare sm" Command="{Binding OpenPrCommand}" IsVisible="{Binding HasPr}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Viewbox Classes="icon" Width="14" Height="14">
                                                    <Path Classes="icon" Data="{StaticResource IconExternal}" Stroke="{Binding $parent[Button].Foreground}" />
                                                </Viewbox>
                                                <TextBlock Text="{l:Loc Settings_PublishedPack_Pr}" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>
    </UserControl.DataTemplates>

    <Grid ColumnDefinitions="272,*">
        <!-- Section list -->
        <Border Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="0,0,1,0" Padding="12,18">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Classes="h1" FontSize="20" Margin="8,0,8,10" Text="{l:Loc Settings_Title}" />
                <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Classes="search" Margin="0,0,0,10"
                         Text="{Binding Query}" PlaceholderText="{l:Loc Settings_Search_Placeholder}"
                         AutomationProperties.Name="{l:Loc Settings_Search_Placeholder}">
                    <TextBox.InnerLeftContent>
                        <Viewbox Classes="icon" Width="16" Height="16" Margin="10,0,0,0">
                            <Path Classes="icon" Data="{StaticResource IconSearch}" Stroke="{DynamicResource AppMutedBrush}" />
                        </Viewbox>
                    </TextBox.InnerLeftContent>
                </TextBox>
                <TextBlock x:Name="AppVersion" DockPanel.Dock="Bottom" Classes="hint" Margin="8,12,8,0" Text="{Binding Version}" />
                <ListBox x:Name="SectionList" Classes="sectionNav" ItemsSource="{Binding Sections}" SelectedItem="{Binding NavSelection}"
                         AutomationProperties.Name="{l:Loc Settings_Title}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="s:SettingsSection">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Viewbox Classes="icon">
                                    <Path Classes="icon" Data="{Binding IconKey, Converter={x:Static views:ResourceKeyConverter.Instance}}"
                                          Stroke="{Binding $parent[ListBoxItem].Foreground}" />
                                </Viewbox>
                                <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <Border Grid.Column="2" Classes="badge" Classes.bad="{Binding BadgeIsError}" IsVisible="{Binding HasBadge}">
                                    <TextBlock Text="{Binding BadgeCount}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="2" Classes="hint" Text="{Binding Hint}" IsVisible="{Binding HasHint}" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Column="1">
            <!-- Content column: fills the pane up to 860 px, left-aligned. -->
            <Grid Margin="32,26,32,56">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="860" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- Selected section -->
                <StackPanel x:Name="SectionPage" Spacing="24" IsVisible="{Binding !IsSearching}">
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="SectionTitle" Classes="h1" FontSize="26" Text="{Binding SelectedSection.Title}" />
                        <TextBlock Classes="muted" Text="{Binding SelectedSection.Description}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ContentControl x:Name="SectionHeader" Content="{Binding SelectedSection.Header}"
                                    IsVisible="{Binding SelectedSection.Header, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <TextBlock x:Name="SectionLead" Classes="lead" Text="{Binding SelectedSection.Lead}"
                               IsVisible="{Binding SelectedSection.Lead, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <!-- The section's own alerts: tone card, the reason, the fixing button -->
                    <ItemsControl x:Name="Alerts" ItemsSource="{Binding SelectedSection.Alerts}"
                                  IsVisible="{Binding SelectedSection.Alerts.Count}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Spacing="10" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="s:SettingsAlert">
                                <Border Classes="notice warn" Classes.bad="{Binding IsError}">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <Viewbox Classes="icon" Width="18" Height="18" VerticalAlignment="Top" Margin="0,1,0,0">
                                            <Path Classes="icon" Data="{StaticResource IconAlert}" Stroke="{DynamicResource AppWarnBrush}" />
                                        </Viewbox>
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Classes="title" Text="{Binding Title}" />
                                            <TextBlock Classes="sub" Text="{Binding Text}" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Classes="ghost sm" VerticalAlignment="Center"
                                                Content="{Binding ActionText}" Command="{Binding Action}" IsVisible="{Binding HasAction}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Classes="card" Padding="16,20" IsVisible="{Binding SelectedSection.IsComingSoon}">
                        <TextBlock x:Name="ComingSoon" Classes="muted" Text="{l:Loc Settings_ComingSoon}" TextWrapping="Wrap" />
                    </Border>
                    <ItemsControl ItemsSource="{Binding SelectedSection.Groups}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Spacing="24" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="s:SettingsGroup">
                                <StackPanel Spacing="8">
                                    <TextBlock Classes="groupTitle" Text="{Binding Title, Converter={x:Static views:UpperCaseConverter.Instance}}" />
                                    <Border Classes="card">
                                        <ItemsControl Classes="rows" ItemsSource="{Binding Rows}" />
                                    </Border>
                                    <TextBlock Classes="note" Text="{Binding Note}" IsVisible="{Binding HasNote}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Search results: matching rows grouped under their section -->
                <StackPanel x:Name="SearchResults" Spacing="24" IsVisible="{Binding IsSearching}">
                    <ItemsControl ItemsSource="{Binding Results}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Spacing="24" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="s:SettingsSearchHit">
                                <StackPanel Spacing="8">
                                    <Button Classes="back" Padding="4,2" HorizontalAlignment="Left"
                                            Command="{Binding $parent[views:SettingsView].((vm:SettingsViewModel)DataContext).OpenSectionCommand}"
                                            CommandParameter="{Binding Section}">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <Viewbox Classes="icon">
                                                <Path Classes="icon" Stroke="{DynamicResource AppAccentBrush}"
                                                      Data="{Binding Section.IconKey, Converter={x:Static views:ResourceKeyConverter.Instance}}" />
                                            </Viewbox>
                                            <TextBlock Classes="h2" Foreground="{DynamicResource AppAccentBrush}" Text="{Binding Section.Title}" />
                                        </StackPanel>
                                    </Button>
                                    <Border Classes="card" IsVisible="{Binding Rows.Count}">
                                        <ItemsControl Classes="rows" ItemsSource="{Binding Rows}" />
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="NoResults" Classes="muted" HorizontalAlignment="Center" Margin="0,40"
                               Text="{Binding NoResultsText}" IsVisible="{Binding HasNoResults}" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
