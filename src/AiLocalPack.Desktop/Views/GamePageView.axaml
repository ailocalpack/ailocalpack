<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AiLocalPack.Desktop.ViewModels"
             xmlns:gp="using:AiLocalPack.Desktop.ViewModels.GamePage"
             xmlns:views="using:AiLocalPack.Desktop.Views"
             xmlns:l="using:AiLocalPack.Desktop.Localization"
             x:Class="AiLocalPack.Desktop.Views.GamePageView"
             x:DataType="vm:GamePageViewModel">
    <!-- Design §3: hero header (backdrop from the cover's colors, cover, name, fact chips, installed pack block,
         primary action + caption), update banner, tab bar (Packs, Generation, Audio and Textures "soon") and the tab.
         When the header scrolls away, a copy of the tab bar sticks to the top with a mini cover, name and the action.
         A blocked game (§3a) keeps the header (grey cover, no action) and shows the red explanation instead of the tabs. -->
    <UserControl.Resources>
        <DataTemplate x:Key="TabStrip" x:DataType="vm:GamePageViewModel">
            <ItemsControl ItemsSource="{Binding Tabs}" AutomationProperties.Name="{l:Loc Game_Tabs_Label}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="gp:GameTabViewModel">
                        <Button Classes="pageTab" Classes.on="{Binding IsSelected}" Classes.soon="{Binding IsSoon}"
                                Command="{Binding SelectCommand}" AutomationProperties.Name="{Binding Label}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                <TextBlock Classes="counter" Classes.gen="{Binding IsGenCounter}" Text="{Binding Counter}"
                                           IsVisible="{Binding HasCounter}" VerticalAlignment="Center" />
                                <Border Classes="tabSoon" IsVisible="{Binding IsSoon}" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="3">
                                        <Viewbox Classes="icon" Width="11" Height="11">
                                            <Path Classes="icon" Data="{StaticResource IconSparkles}" />
                                        </Viewbox>
                                        <TextBlock Text="{Binding SoonText}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>
    </UserControl.Resources>

    <Panel>
        <ScrollViewer x:Name="Scroller">
            <StackPanel>
                <!-- Header -->
                <Panel x:Name="Hero">
                    <Panel Opacity="{DynamicResource HeroBackdropOpacity}" ClipToBounds="True" IsHitTestVisible="False">
                        <Border Background="{Binding BackdropBrush}" />
                        <Border Background="{Binding BackdropGlowBrush}" />
                        <Border Background="{Binding BackdropSecondGlowBrush}" />
                    </Panel>
                    <Border Background="{DynamicResource HeroFadeBrush}" IsHitTestVisible="False" />
                    <Grid Margin="24,24,24,20" ColumnDefinitions="132,*,Auto" ColumnSpacing="24">
                        <Border Classes="heroCover" Background="{Binding PlaceholderBrush}" VerticalAlignment="Bottom">
                            <Panel>
                                <Image Source="{Binding Cover}" Stretch="UniformToFill" IsVisible="{Binding HasCover}" />
                                <Image Source="{Binding Icon}" Stretch="Uniform" IsVisible="{Binding HasIcon}" Width="64" Height="64" />
                            </Panel>
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="10" VerticalAlignment="Center">
                            <TextBlock x:Name="GameTitle" Classes="heroName" Text="{Binding Name}" />
                            <WrapPanel x:Name="FactChips" ItemSpacing="6" LineSpacing="6">
                                <Border Classes="factChip" IsVisible="{Binding HasEngine}">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <Viewbox Classes="icon" Width="13" Height="13" IsVisible="{Binding HasEngineBrand}">
                                            <Path Classes="brand" Data="{Binding EngineBrandKey, Converter={x:Static views:ResourceKeyConverter.Instance}}" />
                                        </Viewbox>
                                        <Viewbox Classes="icon" Width="13" Height="13" IsVisible="{Binding !HasEngineBrand}">
                                            <Path Classes="icon" Data="{StaticResource IconBox}" />
                                        </Viewbox>
                                        <TextBlock Text="{Binding EngineText}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <Border Classes="factChip">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <Viewbox Classes="icon" Width="13" Height="13" IsVisible="{Binding IsSteam}">
                                            <Path Classes="brand" Data="{StaticResource BrandSteam}" />
                                        </Viewbox>
                                        <Viewbox Classes="icon" Width="13" Height="13" IsVisible="{Binding !IsSteam}">
                                            <Path Classes="icon" Data="{StaticResource IconHardDrive}" />
                                        </Viewbox>
                                        <TextBlock Text="{Binding StoreText}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <Border Classes="factChip" IsVisible="{Binding HasVersion}" ToolTip.Tip="{Binding VersionTip}">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <Viewbox Classes="icon" Width="13" Height="13"><Path Classes="icon" Data="{StaticResource IconTag}" /></Viewbox>
                                        <TextBlock Text="{Binding VersionText}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </WrapPanel>

                            <!-- Installed pack block (⋯: Re-apply, Show in Packs, Uninstall); while an install, re-apply or uninstall
                                 runs on the game it shows the progress instead (design §4a) -->
                            <Border x:Name="InstalledPack" Classes="installedPack" Classes.broken="{Binding IsInstalledBroken}"
                                    Classes.operating="{Binding IsOperating}" IsVisible="{Binding ShowInstalled}">
                                <DockPanel>
                                    <Viewbox DockPanel.Dock="Left" Classes="icon" Width="18" Height="18" Margin="0,0,12,0" VerticalAlignment="Center"
                                             IsVisible="{Binding !IsOperating}">
                                        <Panel>
                                            <Path Classes="icon" Data="{StaticResource IconCheck}" IsVisible="{Binding !IsInstalledBroken}" />
                                            <Path Classes="icon" Data="{StaticResource IconAlert}" IsVisible="{Binding IsInstalledBroken}" />
                                        </Panel>
                                    </Viewbox>
                                    <Viewbox DockPanel.Dock="Left" Classes="icon spin" Width="18" Height="18" Margin="0,0,12,0" VerticalAlignment="Center"
                                             IsVisible="{Binding IsOperating}">
                                        <Path Classes="icon" Data="{StaticResource IconLoader}" />
                                    </Viewbox>
                                    <Button x:Name="InstalledMenu" DockPanel.Dock="Right" Classes="installedMenu" Margin="10,0,0,0" VerticalAlignment="Center"
                                            IsVisible="{Binding ShowInstalledPack}" ToolTip.Tip="{l:Loc Game_Installed_Menu}"
                                            AutomationProperties.Name="{l:Loc Game_Installed_Menu}">
                                        <Viewbox Classes="icon" Width="18" Height="18"><Path Classes="icon" Data="{StaticResource IconMore}" /></Viewbox>
                                        <Button.Flyout>
                                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                <MenuItem x:Name="ReapplyItem" Header="{l:Loc Game_Installed_Reapply}" Command="{Binding ReapplyCommand}" />
                                                <MenuItem x:Name="ShowInPacksItem" Header="{l:Loc Game_Installed_ShowInPacks}" Command="{Binding ShowInPacksCommand}" />
                                                <Separator />
                                                <MenuItem x:Name="UninstallItem" Header="{l:Loc Game_Installed_Uninstall}" Command="{Binding UninstallCommand}" />
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                    <Panel>
                                        <StackPanel Spacing="1" IsVisible="{Binding ShowInstalledPack}">
                                            <TextBlock Classes="muted" FontSize="12" FontWeight="SemiBold" Text="{Binding InstalledLabel}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock FontWeight="Bold" Text="{Binding InstalledText}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel x:Name="InstallProgress" Spacing="1" IsVisible="{Binding IsOperating}">
                                            <TextBlock x:Name="OperationTitle" FontWeight="Bold" Text="{Binding OperationTitle}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock x:Name="OperationStep" Classes="muted" FontSize="12" Text="{Binding OperationStep}" TextTrimming="CharacterEllipsis" />
                                            <ProgressBar Classes="installProgress" Minimum="0" Maximum="100" Value="{Binding OperationPercent}" />
                                        </StackPanel>
                                    </Panel>
                                </DockPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Spacing="6" VerticalAlignment="Bottom" HorizontalAlignment="Right"
                                    IsVisible="{Binding HasPrimaryAction}">
                            <Button x:Name="PrimaryAction" Classes="accent primaryAction" Classes.gen="{Binding IsPrimaryGen}"
                                    HorizontalAlignment="Right" Command="{Binding PrimaryCommand}"
                                    AutomationProperties.Name="{Binding PrimaryText}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Viewbox Classes="icon" Width="18" Height="18" Classes.spin="{Binding IsPrimarySpinning}">
                                        <Viewbox.RenderTransform><RotateTransform /></Viewbox.RenderTransform>
                                        <Path Classes="icon" Data="{Binding PrimaryIcon, Converter={x:Static views:ResourceKeyConverter.Instance}}"
                                              Stroke="{Binding $parent[Button].Foreground}" />
                                    </Viewbox>
                                    <TextBlock Text="{Binding PrimaryText}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <TextBlock x:Name="PrimaryCaption" Classes="muted" FontSize="12" MaxWidth="260" TextAlignment="Right"
                                       TextWrapping="Wrap" HorizontalAlignment="Right" Text="{Binding PrimaryCaption}" />
                            <TextBlock x:Name="LaunchError" Foreground="{DynamicResource AppWarnBrush}" FontSize="12" MaxWidth="260" TextAlignment="Right"
                                       TextWrapping="Wrap" HorizontalAlignment="Right" Text="{Binding LaunchError}"
                                       IsVisible="{Binding HasLaunchError}" />
                        </StackPanel>
                    </Grid>
                </Panel>

                <!-- Update banner (task 33): incompatible / files put back / re-apply failed; the rating prompt (task 63) goes in the same place -->
                <Border x:Name="UpdateBanner" Classes="banner warn" Margin="24,0" IsVisible="{Binding ShowUpdateBanner}">
                    <DockPanel>
                        <Viewbox DockPanel.Dock="Left" Classes="icon" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center">
                            <Path Classes="icon" Data="{StaticResource IconAlert}" Stroke="{DynamicResource AppWarnBrush}" />
                        </Viewbox>
                        <Button DockPanel.Dock="Right" Classes="ghost sm" Margin="12,0,0,0" VerticalAlignment="Center"
                                Command="{Binding OpenGenerationCommand}" IsVisible="{Binding ShowBannerTranslate}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Viewbox Classes="icon" Width="14" Height="14">
                                    <Path Classes="icon" Data="{StaticResource IconSparkles}" Stroke="{Binding $parent[Button].Foreground}" />
                                </Viewbox>
                                <TextBlock Text="{l:Loc Game_Action_TranslateNew}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="BannerDetails" DockPanel.Dock="Right" Classes="ghost sm" Margin="8,0,0,0" VerticalAlignment="Center"
                                Command="{Binding ShowReapplyDetailsCommand}" IsVisible="{Binding ShowBannerDetails}"
                                Content="{l:Loc Install_Toast_Details}" />
                        <Button x:Name="BannerReapply" DockPanel.Dock="Right" Classes="ghost sm" Margin="12,0,0,0" VerticalAlignment="Center"
                                Command="{Binding ReapplyCommand}" IsVisible="{Binding ShowBannerReapply}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Viewbox Classes="icon" Width="14" Height="14">
                                    <Path Classes="icon" Data="{StaticResource IconRefresh}" Stroke="{Binding $parent[Button].Foreground}" />
                                </Viewbox>
                                <TextBlock Text="{l:Loc Game_Action_Reapply}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="UpdateBannerText" Text="{Binding UpdateBannerText}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </DockPanel>
                </Border>

                <!-- Blocked game (§3a): anti-cheat or studio opt-out, instead of the tabs -->
                <Border x:Name="BlockedPanel" Classes="blockedPanel" Margin="24,14,24,40" IsVisible="{Binding IsBlocked}">
                    <DockPanel>
                        <Viewbox DockPanel.Dock="Left" Classes="icon" Width="28" Height="28" Margin="0,2,16,0" VerticalAlignment="Top">
                            <Path Classes="icon" Data="{StaticResource IconBan}" Stroke="{DynamicResource AppBadBrush}" />
                        </Viewbox>
                        <StackPanel Spacing="6">
                            <TextBlock Classes="h2" FontSize="18" Text="{l:Loc Game_Blocked_Title}" TextWrapping="Wrap" />
                            <TextBlock x:Name="BlockedText" Classes="muted" Text="{Binding BlockedText}" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="2" Margin="0,4,0,0">
                                <TextBlock Classes="muted" Text="{l:Loc Game_Blocked_Mistake}" VerticalAlignment="Center" />
                                <Button x:Name="ReportButton" Classes="link" Command="{Binding ReportCommand}" VerticalAlignment="Center"
                                        ToolTip.Tip="{l:Loc Game_Blocked_Report_Tip}" AutomationProperties.Name="{l:Loc Game_Blocked_Report}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="{l:Loc Game_Blocked_Report}" VerticalAlignment="Center" />
                                        <Viewbox Classes="icon" Width="13" Height="13">
                                            <Path Classes="icon" Data="{StaticResource IconExternal}" Stroke="{Binding $parent[Button].Foreground}" />
                                        </Viewbox>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Tab bar (in the flow; the sticky copy below takes over once it scrolls under the top) -->
                <Border x:Name="TabBar" Margin="24,14,24,0" IsVisible="{Binding ShowTabs}" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource AppBorderBrush}">
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TabStrip}" />
                </Border>

                <!-- Tab content -->
                <Panel x:Name="TabContent" Margin="24,20,24,40" IsVisible="{Binding ShowTabs}">
                    <!-- Packs (§4): list, details, language and sort -->
                    <Panel x:Name="PacksPanel" IsVisible="{Binding IsPacksTab}">
                        <views:PacksTabView DataContext="{Binding Packs}" />
                    </Panel>

                    <!-- Generation (§6): start form (task 52), progress, review and result (tasks 53–55) -->
                    <Panel x:Name="GenerationPanel" IsVisible="{Binding IsGenerationTab}">
                        <views:GenerationTabView DataContext="{Binding Generation}" />
                    </Panel>

                    <!-- Audio / Textures: coming soon -->
                    <StackPanel x:Name="SoonPanel" IsVisible="{Binding IsSoonTab}" MaxWidth="520" Margin="0,32,0,0"
                                Spacing="10" HorizontalAlignment="Center">
                        <Border Classes="illustration">
                            <Viewbox Classes="icon" Width="40" Height="40">
                                <Path Classes="icon" Data="{Binding SoonIcon, Converter={x:Static views:ResourceKeyConverter.Instance}}"
                                      Stroke="{DynamicResource AppFaintBrush}" StrokeThickness="1.5" />
                            </Viewbox>
                        </Border>
                        <TextBlock x:Name="SoonTitle" Classes="h2" FontSize="19" Text="{Binding SoonTitle}" HorizontalAlignment="Center" />
                        <TextBlock Classes="muted" Text="{Binding SoonText}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </Panel>
            </StackPanel>
        </ScrollViewer>

        <!-- Sticky tab bar -->
        <Border x:Name="StickyBar" VerticalAlignment="Top" Background="{DynamicResource StickyBarBrush}" IsVisible="{Binding ShowStickyBar}">
            <Grid Margin="24,0" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource AppBorderBrush}" Grid.ColumnSpan="2" />
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TabStrip}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Classes="miniCover" Background="{Binding PlaceholderBrush}">
                        <Image Source="{Binding Cover}" Stretch="UniformToFill" IsVisible="{Binding HasCover}" />
                    </Border>
                    <TextBlock Text="{Binding Name}" FontWeight="Bold" VerticalAlignment="Center" MaxWidth="240" TextTrimming="CharacterEllipsis" />
                    <Button x:Name="StickyPrimaryAction" Classes="accent primaryAction sm" Classes.gen="{Binding IsPrimaryGen}"
                            Command="{Binding PrimaryCommand}" IsVisible="{Binding HasPrimaryAction}"
                            AutomationProperties.Name="{Binding PrimaryText}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Viewbox Classes="icon" Width="14" Height="14" Classes.spin="{Binding IsPrimarySpinning}">
                                <Viewbox.RenderTransform><RotateTransform /></Viewbox.RenderTransform>
                                <Path Classes="icon" Data="{Binding PrimaryIcon, Converter={x:Static views:ResourceKeyConverter.Instance}}"
                                      Stroke="{Binding $parent[Button].Foreground}" />
                            </Viewbox>
                            <TextBlock Text="{Binding PrimaryText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Panel>
</UserControl>
