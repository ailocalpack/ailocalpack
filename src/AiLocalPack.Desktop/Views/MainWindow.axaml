<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AiLocalPack.Desktop.ViewModels"
        xmlns:l="using:AiLocalPack.Desktop.Localization"
        xmlns:svc="using:AiLocalPack.Desktop.Services"
        xmlns:views="using:AiLocalPack.Desktop.Views"
        x:Class="AiLocalPack.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="ailocalpack"
        Width="1200" Height="760"
        MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen">
    <!-- Min size stays below 1280×800 (Steam Deck), so the app fits there with the title bar. -->
    <Window.KeyBindings>
        <KeyBinding Gesture="Escape" Command="{Binding EscapeCommand}" />
        <KeyBinding Gesture="Alt+Left" Command="{Binding GoBackCommand}" />
    </Window.KeyBindings>

    <Panel>
        <DockPanel x:Name="Main" IsEnabled="{Binding !HasDialog}">
            <Border x:Name="Chrome" DockPanel.Dock="Top" Height="52" Padding="20,0,12,0"
                    Background="{DynamicResource AppSurfaceBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Border Width="26" Height="26" CornerRadius="8" Background="{StaticResource AppLogoBrush}">
                            <TextBlock Text="al" Foreground="White" FontSize="12" FontWeight="ExtraBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Name="Logo" Text="ailocalpack" FontSize="15" FontWeight="ExtraBold" VerticalAlignment="Center" />
                        <Button x:Name="BackButton" Classes="back" Margin="12,0,0,0"
                                Content="{Binding BackLabel}"
                                Command="{Binding GoBackCommand}"
                                IsVisible="{Binding CanGoBack}"
                                AutomationProperties.Name="{Binding BackLabel}" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <TextBlock x:Name="StartupNote" Text="{l:Loc Chrome_CheckingForChanges}" IsVisible="{Binding Startup.IsBackgroundRunning}"
                                   FontSize="12" Foreground="{DynamicResource AppMutedBrush}" VerticalAlignment="Center" Margin="0,0,2,0" />
                        <!-- Activity arrives in task 38; until then 🔔 lists the startup checks (design §9). -->
                        <Button x:Name="ActivityButton" Classes="icon"
                                ToolTip.Tip="{l:Loc Chrome_Activity}" AutomationProperties.Name="{Binding ActivityName}">
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedRight" FlyoutPresenterClasses="startupChecks">
                                    <StackPanel x:Name="StartupChecks" Width="384" Spacing="2">
                                        <DockPanel Margin="10,8,10,4">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Startup.BackgroundSummary}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AppFaintBrush}" />
                                            <TextBlock Text="{l:Loc Startup_Checks_Title}" FontSize="13" FontWeight="Bold" />
                                        </DockPanel>
                                        <ItemsControl x:Name="StartupCheckList" ItemsSource="{Binding Startup.Background}" Focusable="False" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                            <Panel>
                                <Path Data="{StaticResource IconBell}" />
                                <Arc x:Name="ActivityRing" Classes="ring" Width="32" Height="32"
                                     IsVisible="{Binding Startup.IsBackgroundRunning}" />
                            </Panel>
                        </Button>
                        <Button x:Name="SettingsButton" Classes="icon" Classes.on="{Binding IsSettingsOpen}" Command="{Binding OpenSettingsCommand}"
                                ToolTip.Tip="{l:Loc Chrome_Settings}" AutomationProperties.Name="{l:Loc Chrome_Settings}">
                            <Path Data="{StaticResource IconSettings}" />
                        </Button>
                    </StackPanel>
                    <Panel />
                </DockPanel>
            </Border>

            <ContentControl x:Name="PageHost" Content="{Binding CurrentPage}" />
        </DockPanel>

        <!-- Toasts: bottom right, over the page (install done / failed, design §4a); off while a dialog is open -->
        <ItemsControl x:Name="ToastHost" ItemsSource="{Binding Toasts.Items}" IsEnabled="{Binding !HasDialog}"
                      HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0" Padding="40,40,20,20" ClipToBounds="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Spacing="10" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="svc:ToastViewModel">
                    <Border Classes="toast" Classes.ok="{Binding IsOk}" Classes.bad="{Binding IsBad}">
                        <DockPanel>
                            <Viewbox DockPanel.Dock="Left" Classes="icon" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Top">
                                <Path Classes="icon toastIcon" Data="{Binding Icon, Converter={x:Static views:ResourceKeyConverter.Instance}}" />
                            </Viewbox>
                            <Button DockPanel.Dock="Right" Classes="icon" Width="28" Height="28" Margin="8,-4,-6,0" VerticalAlignment="Top"
                                    Command="{Binding CloseCommand}" ToolTip.Tip="{l:Loc Install_Toast_Close}" AutomationProperties.Name="{l:Loc Install_Toast_Close}">
                                <Viewbox Classes="icon" Width="14" Height="14"><Path Classes="icon" Data="{StaticResource IconX}" /></Viewbox>
                            </Button>
                            <StackPanel Spacing="10">
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                <ItemsControl ItemsSource="{Binding Actions}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="svc:ToastButton">
                                            <Button Classes="sm" Classes.accent="{Binding IsPrimary}" Classes.ghost="{Binding !IsPrimary}"
                                                    Command="{Binding Command}" AutomationProperties.Name="{Binding Text}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <Viewbox Classes="icon" Width="14" Height="14" IsVisible="{Binding HasIcon}">
                                                        <Path Classes="icon" Data="{Binding Icon, Converter={x:Static views:ResourceKeyConverter.Instance}}"
                                                              Stroke="{Binding $parent[Button].Foreground}" />
                                                    </Viewbox>
                                                    <TextBlock Text="{Binding Text}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Modal dialog: scrim over the whole window (chrome included), the dialog's view in the middle -->
        <Border x:Name="DialogScrim" Classes="scrim" IsVisible="{Binding HasDialog}">
            <ContentControl x:Name="DialogHost" Content="{Binding Dialog}" Margin="24"
                            HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
    </Panel>
</Window>
