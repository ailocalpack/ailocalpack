<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:r="using:AiLocalPack.Desktop.Ratings"
             xmlns:l="using:AiLocalPack.Desktop.Localization"
             xmlns:views="using:AiLocalPack.Desktop.Views"
             x:Class="AiLocalPack.Desktop.Views.RatingSignInDialogView"
             x:DataType="r:RatingSignInDialogViewModel"
             Width="520">
    <!-- Task 63: GitHub sign-in on the first like or report; closes by itself once GitHub confirms. -->
    <Border Classes="dialog">
        <StackPanel Margin="24,20,20,20" Spacing="14">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Spacing="4">
                    <TextBlock x:Name="RatingSignInTitle" Classes="dialogTitle" FontSize="18" Text="{Binding TitleText}" TextWrapping="Wrap" />
                    <TextBlock Classes="muted" FontSize="13" Text="{Binding IntroText}" TextWrapping="Wrap" />
                </StackPanel>
                <Button x:Name="CloseButton" Grid.Column="1" Classes="icon" Command="{Binding CancelCommand}" VerticalAlignment="Top"
                        ToolTip.Tip="{l:Loc Publish_Close}" AutomationProperties.Name="{l:Loc Publish_Close}">
                    <Path Data="{StaticResource IconX}" />
                </Button>
            </Grid>

            <views:GitHubSignInView x:Name="DeviceFlow" DataContext="{Binding SignIn}" />
            <Button x:Name="SignInButton" Classes="accent" Command="{Binding StartSignInCommand}" IsVisible="{Binding ShowSignInButton}" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Viewbox Classes="icon" Width="16" Height="16">
                        <Path Classes="icon" Data="{StaticResource IconGitHub}" Stroke="{Binding $parent[Button].Foreground}" />
                    </Viewbox>
                    <TextBlock Text="{l:Loc Publish_SignIn_SignInButton}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,4,0,0">
                <TextBlock Classes="muted" FontSize="12" Text="{l:Loc Rating_SignIn_Hint}" TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button x:Name="CancelButton" Grid.Column="1" Classes="ghost" Command="{Binding CancelCommand}" Content="{l:Loc Publish_Cancel}" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
