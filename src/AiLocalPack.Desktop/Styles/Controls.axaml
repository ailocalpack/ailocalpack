<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
    </Style>

    <!-- Chrome icon button (🔔, ⚙) -->
    <Style Selector="Button.icon">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource AppMutedBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.icon:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppSurface2Brush}" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
    </Style>
    <Style Selector="Button.icon Path">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Stroke" Value="{Binding $parent[Button].Foreground}" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="StrokeJoin" Value="Round" />
    </Style>

    <!-- Back link in the chrome -->
    <Style Selector="Button.back">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource AppMutedBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="10,6" />
    </Style>
    <Style Selector="Button.back:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppSurface2Brush}" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
    </Style>

    <Style Selector="TextBlock.h1">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="TextBlock.muted">
        <Setter Property="Foreground" Value="{DynamicResource AppMutedBrush}" />
    </Style>

    <!-- Active chrome button (⚙ while Settings is open) -->
    <Style Selector="Button.icon.on /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppAccentSoftBrush}" />
    </Style>
    <Style Selector="Button.icon.on">
        <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
    </Style>

    <!-- Stroked 24×24 icon (Lucide geometry) scaled into a box: <Viewbox Classes="icon"><Path Classes="icon" Data="…" /></Viewbox> -->
    <Style Selector="Viewbox.icon">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Stretch" Value="Uniform" />
    </Style>
    <Style Selector="Path.icon">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Stretch" Value="None" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="StrokeJoin" Value="Round" />
    </Style>
    <!-- Filled 24×24 brand mark (Styles/BrandIcons.axaml) scaled the same way: <Viewbox Classes="icon"><Path Classes="brand" Data="…" /></Viewbox>;
         the fill follows the text colour unless set -->
    <Style Selector="Path.brand">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Stretch" Value="None" />
        <Setter Property="Fill" Value="{DynamicResource AppTextBrush}" />
    </Style>

    <!-- Card: grouped rows on a surface -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
    </Style>
    <Style Selector="TextBlock.groupTitle">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource AppFaintBrush}" />
        <Setter Property="Margin" Value="4,0" />
    </Style>
    <Style Selector="TextBlock.note">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource AppFaintBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="4,0" />
    </Style>

    <!-- Setting row: label + explanation left, control right; a divider between rows of a card -->
    <Style Selector="Border.settingRow">
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="MinHeight" Value="64" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
    </Style>
    <!-- A whole row that opens a page (Settings → About links): hover tint, focus ring from the button -->
    <Style Selector="Button.rowLink">
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="MinHeight" Value="64" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.rowLink:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppSurface2Brush}" />
    </Style>
    <Style Selector="ItemsControl.rows > ContentPresenter:nth-child(n+2) Border.settingRow">
        <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>
    <Style Selector="TextBlock.rowLabel">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.rowHelp">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource AppMutedBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.rowHelp.bad">
        <Setter Property="Foreground" Value="{DynamicResource AppBadBrush}" />
    </Style>
    <Style Selector="TextBlock.rowHelp.ok">
        <Setter Property="Foreground" Value="{DynamicResource AppOkBrush}" />
    </Style>
    <Style Selector="HyperlinkButton.inline">
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="ToggleSwitch.bare">
        <Setter Property="OnContent" Value="" />
        <Setter Property="OffContent" Value="" />
        <Setter Property="MinWidth" Value="0" />
    </Style>

    <!-- Search box with a magnifier -->
    <Style Selector="TextBox.search">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- Section list (Settings): 48 px items, accent-soft when selected -->
    <Style Selector="ListBox.sectionNav">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.sectionNav ListBoxItem">
        <Setter Property="Height" Value="48" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Foreground" Value="{DynamicResource AppMutedBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="ListBox.sectionNav ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppSurface2Brush}" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
    </Style>
    <Style Selector="ListBox.sectionNav ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppAccentSoftBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
    </Style>
    <Style Selector="ListBox.sectionNav ListBoxItem:selected Path.icon">
        <Setter Property="Stroke" Value="{DynamicResource AppAccentBrush}" />
    </Style>

    <!-- Count badge (amber = warning, .bad = error) and quiet hint -->
    <Style Selector="Border.badge">
        <Setter Property="MinWidth" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Padding" Value="7,0" />
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="Background" Value="{DynamicResource AppWarnBrush}" />
        <Setter Property="TextElement.Foreground" Value="#1a1205" />
        <Setter Property="TextElement.FontSize" Value="12" />
        <Setter Property="TextElement.FontWeight" Value="ExtraBold" />
    </Style>
    <Style Selector="Border.badge.bad">
        <Setter Property="Background" Value="{DynamicResource AppBadBrush}" />
        <Setter Property="TextElement.Foreground" Value="White" />
    </Style>
    <Style Selector="TextBlock.hint">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource AppFaintBrush}" />
    </Style>

    <!-- Segmented control: a ListBox with every option visible (theme) -->
    <Style Selector="ListBox.segmented">
        <Setter Property="Background" Value="{DynamicResource AppSurface2Brush}" />
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="Padding" Value="3" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2" /></ItemsPanelTemplate>
        </Setter>
    </Style>
    <Style Selector="ListBox.segmented ListBoxItem">
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource AppMutedBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ListBox.segmented ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
    </Style>
    <Style Selector="ListBox.segmented ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
    </Style>

    <!-- Secondary heading (section names in search results) -->
    <Style Selector="TextBlock.h2">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <!-- Toolbar button with a border (+ Folder, Settings → Libraries) -->
    <Style Selector="Button.ghost">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.accent">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ComboBox.toolbar">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- Keyboard shortcut hint (Ctrl F in the search box) -->
    <Style Selector="Border.kbd">
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Padding" Value="6,1" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderStrongBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextElement.FontSize" Value="11" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource AppFaintBrush}" />
    </Style>

    <!-- Info banner (scanning) -->
    <Style Selector="Border.banner">
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Background" Value="{DynamicResource AppAccentSoftBrush}" />
    </Style>

    <Style Selector="Border.banner.warn">
        <Setter Property="Background" Value="{DynamicResource AppWarnSoftBrush}" />
    </Style>

    <!-- Game page: why a blocked game has no packs (design §3a) -->
    <Style Selector="Border.blockedPanel">
        <Setter Property="Padding" Value="24,22" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="MaxWidth" Value="760" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Background" Value="{DynamicResource AppBadSoftBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="#4def6b6b" />
    </Style>
    <Style Selector="Button.icon.sm">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
    </Style>

    <!-- Library card: the whole card is one button; no button chrome, the cover lifts on hover -->
    <Style Selector="Button.gameCard">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
    </Style>
    <Style Selector="Button.gameCard:pointerover /template/ ContentPresenter, Button.gameCard:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.gameCard Border.cover">
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="BoxShadow" Value="0 6 18 0 #40000000" />
        <Setter Property="RenderTransform" Value="none" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.gameCard:pointerover Border.cover, Button.gameCard:focus-visible Border.cover">
        <Setter Property="RenderTransform" Value="translateY(-3px)" />
        <Setter Property="BoxShadow" Value="0 16 36 0 #73000000" />
    </Style>
    <Style Selector="Button.gameCard.blocked Image, Button.gameCard.blocked TextBlock.coverName">
        <Setter Property="Opacity" Value="0.35" />
    </Style>
    <Style Selector="Button.gameCard.blocked TextBlock.cardName">
        <Setter Property="Foreground" Value="{DynamicResource AppMutedBrush}" />
    </Style>
    <Style Selector="Button.gameCard.dimmed">
        <Setter Property="Opacity" Value="0.55" />
    </Style>
    <Style Selector="TextBlock.coverName">
        <Setter Property="Margin" Value="14" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="Foreground" Value="#f2ffffff" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
    </Style>
    <Style Selector="TextBlock.cardName">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock.cardMeta">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource AppMutedBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Status badge on a cover (top left): always icon + text, colored text on a solid plate; faded (.stale) while the
         pack list is the saved copy -->
    <Style Selector="Border.statusBadge">
        <Setter Property="Margin" Value="8" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Padding" Value="7,0,9,0" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Background" Value="{DynamicResource AppBadgeBrush}" />
        <Setter Property="TextElement.FontSize" Value="12" />
        <Setter Property="TextElement.FontWeight" Value="Bold" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource AppMutedBrush}" />
    </Style>
    <Style Selector="Border.statusBadge Path.icon">
        <Setter Property="Stroke" Value="{DynamicResource AppMutedBrush}" />
    </Style>
    <Style Selector="Border.statusBadge.stale">
        <Setter Property="Opacity" Value="0.75" />
    </Style>
    <Style Selector="Border.statusBadge.ok">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource AppOkBrush}" />
    </Style>
    <Style Selector="Border.statusBadge.ok Path.icon">
        <Setter Property="Stroke" Value="{DynamicResource AppOkBrush}" />
    </Style>
    <Style Selector="Border.statusBadge.accent">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource AppAccentBrush}" />
    </Style>
    <Style Selector="Border.statusBadge.accent Path.icon">
        <Setter Property="Stroke" Value="{DynamicResource AppAccentBrush}" />
    </Style>
    <Style Selector="Border.statusBadge.warn">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource AppWarnBrush}" />
    </Style>
    <Style Selector="Border.statusBadge.warn Path.icon">
        <Setter Property="Stroke" Value="{DynamicResource AppWarnBrush}" />
    </Style>
    <Style Selector="Border.statusBadge.gen">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource AppGenBrush}" />
    </Style>
    <Style Selector="Border.statusBadge.gen Path.icon">
        <Setter Property="Stroke" Value="{DynamicResource AppGenBrush}" />
    </Style>
    <Style Selector="Border.statusBadge.bad">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource AppBadBrush}" />
    </Style>
    <Style Selector="Border.statusBadge.bad Path.icon">
        <Setter Property="Stroke" Value="{DynamicResource AppBadBrush}" />
    </Style>

    <!-- Generation progress along the bottom of a cover; hidden while the quick action shows -->
    <Style Selector="ProgressBar.coverProgress">
        <Setter Property="Margin" Value="10" />
        <Setter Property="MinHeight" Value="5" />
        <Setter Property="Height" Value="5" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Foreground" Value="{DynamicResource AppGenBrush}" />
        <Setter Property="Background" Value="#40ffffff" />
    </Style>
    <Style Selector="ProgressBar.coverProgress.install">
        <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
    </Style>
    <Style Selector="ProgressBar.coverProgress.paused">
        <Setter Property="Opacity" Value="0.6" />
    </Style>
    <Style Selector="Button.gameCard:pointerover ProgressBar.coverProgress, Button.gameCard:focus-within ProgressBar.coverProgress">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <!-- Quick action over the bottom of a cover: only on hover or keyboard focus -->
    <Style Selector="Button.quick">
        <Setter Property="Margin" Value="8" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="IsVisible" Value="False" />
        <Setter Property="Background" Value="{DynamicResource AppBadgeBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
    </Style>
    <Style Selector="Button.gameCard:pointerover Button.quick.has, Button.gameCard:focus-within Button.quick.has">
        <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="Button.quick.primary">
        <Setter Property="Background" Value="{DynamicResource AppAccentFillBrush}" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.quick.warn">
        <Setter Property="Background" Value="{DynamicResource AppWarnBrush}" />
        <Setter Property="Foreground" Value="#1a1205" />
    </Style>
    <Style Selector="Button.quick.gen">
        <Setter Property="Background" Value="{DynamicResource AppGenBrush}" />
        <Setter Property="Foreground" Value="#06222a" />
    </Style>
    <!-- Hover / pressed: Fluent's own pointer-over fill is translucent and the label vanishes into the cover art, so every
         variant keeps an opaque fill (a step lighter for the plain one) and gets a thin ring. -->
    <Style Selector="Button.quick:pointerover /template/ ContentPresenter, Button.quick:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppSurface3Brush}" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.quick.primary:pointerover /template/ ContentPresenter, Button.quick.primary:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.quick.warn:pointerover /template/ ContentPresenter, Button.quick.warn:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppWarnBrush}" />
        <Setter Property="Foreground" Value="#1a1205" />
    </Style>
    <Style Selector="Button.quick.gen:pointerover /template/ ContentPresenter, Button.quick.gen:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppGenBrush}" />
        <Setter Property="Foreground" Value="#06222a" />
    </Style>

    <!-- Status filter chip: pill with a live count; the chosen one is raised and its count accent -->
    <Style Selector="Button.chip">
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="CornerRadius" Value="17" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource AppMutedBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.chip:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppSurface2Brush}" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
    </Style>
    <Style Selector="Button.chip.on">
        <Setter Property="Background" Value="{DynamicResource AppSurface3Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderStrongBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
    </Style>
    <Style Selector="Button.chip TextBlock.count">
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource AppFaintBrush}" />
    </Style>
    <Style Selector="Button.chip.on TextBlock.count">
        <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
    </Style>

    <!-- Skeleton block while the first scan runs -->
    <Style Selector="Border.skeleton">
        <Setter Property="Background" Value="{DynamicResource AppSurface2Brush}" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <!-- Modal dialog (add game): scrim over the window, card in the middle -->
    <Style Selector="Border.scrim">
        <Setter Property="Background" Value="#a6080a10" />
    </Style>
    <Style Selector="Border.dialog">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="BoxShadow" Value="0 24 64 0 #80000000" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Border.dialogFooter">
        <Setter Property="Padding" Value="24,14" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
    </Style>
    <Style Selector="TextBlock.dialogTitle">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!-- Notice in a dialog: icon + text on a tinted block (.neutral, .info, .warn, .bad) -->
    <Style Selector="Border.notice">
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Background" Value="{DynamicResource AppSurface2Brush}" />
    </Style>
    <Style Selector="Border.notice.info">
        <Setter Property="Background" Value="{DynamicResource AppAccentSoftBrush}" />
    </Style>
    <Style Selector="Border.notice.warn">
        <Setter Property="Background" Value="#26f0b44c" />
    </Style>
    <Style Selector="Border.notice.bad">
        <Setter Property="Background" Value="#26ef6b6b" />
    </Style>
    <Style Selector="Border.notice TextBlock">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Border.notice TextBlock.title">
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Border.notice TextBlock.sub">
        <Setter Property="Foreground" Value="{DynamicResource AppMutedBrush}" />
    </Style>

    <!-- Fact chip (engine, executable, size) -->
    <Style Selector="Border.fact">
        <Setter Property="Padding" Value="9,4" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="{DynamicResource AppSurface2Brush}" />
        <Setter Property="TextElement.FontSize" Value="12" />
    </Style>
    <Style Selector="Border.fact.warn">
        <Setter Property="Background" Value="#26f0b44c" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource AppWarnBrush}" />
    </Style>
    <Style Selector="Border.fact.bad">
        <Setter Property="Background" Value="#26ef6b6b" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource AppBadBrush}" />
    </Style>

    <!-- Text-only button (Other folder) -->
    <Style Selector="Button.link">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppAccentSoftBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
    </Style>

    <!-- Dashed drop zone (a Rectangle behind the content) -->
    <Style Selector="Rectangle.dropzone">
        <Setter Property="Stroke" Value="{DynamicResource AppBorderStrongBrush}" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="StrokeDashArray" Value="6,4" />
        <Setter Property="RadiusX" Value="14" />
        <Setter Property="RadiusY" Value="14" />
    </Style>
    <Style Selector="Rectangle.dropzone.active">
        <Setter Property="Stroke" Value="{DynamicResource AppAccentBrush}" />
        <Setter Property="Fill" Value="{DynamicResource AppAccentSoftBrush}" />
    </Style>

    <!-- Small row button (Open, Remove, Rescan in settings rows) -->
    <Style Selector="Button.sm">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.bare">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <!-- Rating (task 63): the like given, the verdict reported -->
    <Style Selector="Button.ghost.chosen">
        <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
        <Setter Property="Background" Value="{DynamicResource AppAccentSoftBrush}" />
    </Style>
    <!-- Confirming a destructive action (Remove) -->
    <Style Selector="Button.danger">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource AppBadBrush}" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.danger:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppBadBrush}" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.danger:pointerover">
        <Setter Property="Opacity" Value="0.9" />
    </Style>
    <!-- Square icon tile at the start of a settings row (Steam, a library folder, a game) -->
    <Style Selector="Border.rowPic">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Background" Value="{DynamicResource AppSurface2Brush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.rowPic.warn">
        <Setter Property="Background" Value="#26f0b44c" />
    </Style>
    <Style Selector="TextBlock.mono">
        <Setter Property="FontFamily" Value="Menlo, Consolas, DejaVu Sans Mono, monospace" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="TextBlock.struck">
        <Setter Property="TextDecorations" Value="Strikethrough" />
        <Setter Property="Foreground" Value="{DynamicResource AppMutedBrush}" />
    </Style>
    <Style Selector="TextBlock.error">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource AppBadBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- "Coming soon" pill -->
    <!-- Settings → AI agents: logo tile and status badge (icon + text; green ready, amber warning, accent busy / to do) -->
    <Style Selector="Border.agentLogo">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="TextElement.FontSize" Value="15" />
        <Setter Property="TextElement.FontWeight" Value="Bold" />
        <Setter Property="TextElement.Foreground" Value="White" />
    </Style>
    <Style Selector="Border.agentLogo Viewbox.icon">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
    </Style>
    <Style Selector="Border.agentLogo.small">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="TextElement.FontSize" Value="12" />
    </Style>
    <Style Selector="Border.agentLogo.small Viewbox.icon">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
    </Style>
    <Style Selector="Border.agentStatus">
        <Setter Property="Height" Value="22" />
        <Setter Property="Padding" Value="7,0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Background" Value="{DynamicResource AppSurface2Brush}" />
        <Setter Property="TextElement.FontSize" Value="11" />
        <Setter Property="TextElement.FontWeight" Value="Bold" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource AppMutedBrush}" />
    </Style>
    <Style Selector="Border.agentStatus Path.icon"><Setter Property="Stroke" Value="{DynamicResource AppMutedBrush}" /></Style>
    <Style Selector="Border.agentStatus.ok">
        <Setter Property="Background" Value="{DynamicResource AppOkSoftBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource AppOkBrush}" />
    </Style>
    <Style Selector="Border.agentStatus.ok Path.icon"><Setter Property="Stroke" Value="{DynamicResource AppOkBrush}" /></Style>
    <Style Selector="Border.agentStatus.warn">
        <Setter Property="Background" Value="{DynamicResource AppWarnSoftBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource AppWarnBrush}" />
    </Style>
    <Style Selector="Border.agentStatus.warn Path.icon"><Setter Property="Stroke" Value="{DynamicResource AppWarnBrush}" /></Style>
    <Style Selector="Border.agentStatus.accent">
        <Setter Property="Background" Value="{DynamicResource AppAccentSoftBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource AppAccentBrush}" />
    </Style>
    <Style Selector="Border.agentStatus.accent Path.icon"><Setter Property="Stroke" Value="{DynamicResource AppAccentBrush}" /></Style>
    <Style Selector="TextBlock.lead">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="21" />
    </Style>

    <Style Selector="Border.soonPill">
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Background" Value="{DynamicResource AppSurface2Brush}" />
        <Setter Property="TextElement.FontSize" Value="12" />
        <Setter Property="TextElement.FontWeight" Value="SemiBold" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource AppMutedBrush}" />
    </Style>

    <!-- Startup checklist row (splash details, startup checks under 🔔), design §9 -->
    <Style Selector="Border.startupStep">
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.startupStep.running">
        <Setter Property="Background" Value="{DynamicResource AppSurface2Brush}" />
    </Style>
    <Style Selector="Border.startupStep.waiting">
        <Setter Property="Opacity" Value="0.55" />
    </Style>
    <Style Selector="TextBlock.stepLabel">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.stepLabel.skipped">
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource AppFaintBrush}" />
    </Style>
    <Style Selector="TextBlock.stepDetail">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource AppMutedBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock.stepDetail.warn">
        <Setter Property="Foreground" Value="{DynamicResource AppWarnBrush}" />
    </Style>
    <Style Selector="Border.stepIcon">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="CornerRadius" Value="12" />
    </Style>

    <!-- Splash window -->
    <Style Selector="ProgressBar.splashBar">
        <Setter Property="MinHeight" Value="6" />
        <Setter Property="Height" Value="6" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Background" Value="{DynamicResource AppSurface3Brush}" />
        <Setter Property="Foreground" Value="{StaticResource AppLogoBrush}" />
    </Style>
    <Style Selector="Button.splashToggle">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource AppMutedBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.splashToggle:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppSurface2Brush}" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
    </Style>
    <!-- The ring around the big logo mark fades out as it grows -->
    <Style Selector="Border.breathe">
        <Style.Animations>
            <Animation Duration="0:0:2.2" IterationCount="Infinite" Easing="CubicEaseOut">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0.55" />
                    <Setter Property="ScaleTransform.ScaleX" Value="0.92" />
                    <Setter Property="ScaleTransform.ScaleY" Value="0.92" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="0" />
                    <Setter Property="ScaleTransform.ScaleX" Value="1.18" />
                    <Setter Property="ScaleTransform.ScaleY" Value="1.18" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- Startup checks under 🔔: "Checking for changes…" and a ring spinning around the bell -->
    <Style Selector="Arc.ring">
        <Setter Property="Stroke" Value="{DynamicResource AppGenBrush}" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="StartAngle" Value="-135" />
        <Setter Property="SweepAngle" Value="90" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Style.Animations>
            <Animation Duration="0:0:1" IterationCount="Infinite">
                <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0" /></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360" /></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- Activity panel under 🔔 (design §5) -->
    <Style Selector="FlyoutPresenter.activity">
        <Setter Property="Padding" Value="6,8,6,0" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="MaxWidth" Value="460" />
        <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderStrongBrush}" />
    </Style>
    <Style Selector="Border.bellBadge">
        <Setter Property="MinWidth" Value="17" />
        <Setter Property="Height" Value="17" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Margin" Value="0,-8,-12,0" />
        <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="Border.bellBadge.attention">
        <Setter Property="Background" Value="{DynamicResource AppWarnBrush}" />
    </Style>
    <Style Selector="Border.bellBadge TextBlock">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.bellBadge.attention TextBlock">
        <Setter Property="Foreground" Value="#1b1408" />
    </Style>
    <Style Selector="StackPanel.activitySection">
        <Setter Property="Margin" Value="10,10,10,6" />
    </Style>
    <Style Selector="TextBlock.sectionCount">
        <Setter Property="Foreground" Value="{DynamicResource AppMutedBrush}" />
    </Style>
    <Style Selector="Border.activityRow">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.activityRow:pointerover, Border.activityRow:focus-within">
        <Setter Property="Background" Value="{DynamicResource AppSurface2Brush}" />
    </Style>
    <Style Selector="Button.activityRowOpen">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
    </Style>
    <Style Selector="Button.activityRowOpen:pointerover /template/ ContentPresenter, Button.activityRowOpen:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
    </Style>
    <!-- A decision: a card with a tone stripe (amber decision, red error); icon + text carry the meaning too -->
    <Style Selector="Border.activityRow.decision">
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppWarnBrush}" />
        <Setter Property="BorderThickness" Value="4,1,1,1" />
    </Style>
    <Style Selector="Border.activityRow.decision.bad">
        <Setter Property="BorderBrush" Value="{DynamicResource AppBadBrush}" />
    </Style>
    <Style Selector="Border.activityRow.decision.paused">
        <Setter Property="BorderBrush" Value="{DynamicResource AppGenBrush}" />
    </Style>
    <Style Selector="Border.activityRow.paused Border.activityTone">
        <Setter Property="Background" Value="{DynamicResource AppGenSoftBrush}" />
    </Style>
    <Style Selector="Border.activityRow.paused Path.toneIcon">
        <Setter Property="Stroke" Value="{DynamicResource AppGenBrush}" />
    </Style>
    <Style Selector="Border.activityRow.decision:pointerover, Border.activityRow.decision:focus-within">
        <Setter Property="Background" Value="{DynamicResource AppSurface2Brush}" />
    </Style>
    <Style Selector="Border.activityThumb">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="48" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Border.activityTone">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="Margin" Value="0,0,-9,-6" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppSurfaceBrush}" />
        <Setter Property="Background" Value="{DynamicResource AppSurface2Brush}" />
    </Style>
    <Style Selector="Border.activityTone Path.toneIcon">
        <Setter Property="Stroke" Value="{DynamicResource AppMutedBrush}" />
    </Style>
    <Style Selector="Border.activityRow.attention Border.activityTone">
        <Setter Property="Background" Value="{DynamicResource AppWarnSoftBrush}" />
    </Style>
    <Style Selector="Border.activityRow.attention Path.toneIcon">
        <Setter Property="Stroke" Value="{DynamicResource AppWarnBrush}" />
    </Style>
    <Style Selector="Border.activityRow.bad Border.activityTone">
        <Setter Property="Background" Value="{DynamicResource AppBadSoftBrush}" />
    </Style>
    <Style Selector="Border.activityRow.bad Path.toneIcon">
        <Setter Property="Stroke" Value="{DynamicResource AppBadBrush}" />
    </Style>
    <Style Selector="Ellipse.unreadDot">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Fill" Value="{DynamicResource AppAccentBrush}" />
    </Style>
    <Style Selector="TextBlock.activityGame">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource AppMutedBrush}" />
    </Style>
    <Style Selector="TextBlock.activityTime">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource AppFaintBrush}" />
    </Style>
    <Style Selector="TextBlock.activityTitle">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.activityRow.unread TextBlock.activityTitle">
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Border.activityRow.read TextBlock.activityTitle">
        <Setter Property="Foreground" Value="{DynamicResource AppMutedBrush}" />
    </Style>
    <Style Selector="TextBlock.activityDetail">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource AppMutedBrush}" />
    </Style>
    <!-- ✕ on a feed row: only on hover or keyboard focus -->
    <Style Selector="Border.activityRow.ok Border.activityTone">
        <Setter Property="Background" Value="{DynamicResource AppOkSoftBrush}" />
    </Style>
    <Style Selector="Border.activityRow.ok Path.toneIcon">
        <Setter Property="Stroke" Value="{DynamicResource AppOkBrush}" />
    </Style>
    <Style Selector="Border.activityRow Button.hideOnRest">
        <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="Border.activityRow:pointerover Button.hideOnRest, Border.activityRow:focus-within Button.hideOnRest">
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Border.activityFooter">
        <Setter Property="Padding" Value="10,10" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
    </Style>
    <Style Selector="Border.activityEmptyIcon">
        <Setter Property="Width" Value="48" />
        <Setter Property="Height" Value="48" />
        <Setter Property="CornerRadius" Value="24" />
        <Setter Property="Background" Value="{DynamicResource AppSurface2Brush}" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <!-- GitHub Device Flow code (design §7–§8) and the account avatar -->
    <Style Selector="Border.deviceCode">
        <Setter Property="Background" Value="{DynamicResource AppSurface2Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="MaxWidth" Value="520" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="SelectableTextBlock.deviceCode">
        <Setter Property="FontFamily" Value="Menlo, Consolas, DejaVu Sans Mono, monospace" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LetterSpacing" Value="2" />
        <Setter Property="Margin" Value="0,0,24,0" />
    </Style>
    <Style Selector="Border.stepNumber">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Background" Value="{DynamicResource AppAccentSoftBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.stepNumber TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.avatar">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="Background" Value="{DynamicResource AppAccentSoftBrush}" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style Selector="Border.avatar TextBlock">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Spinner: a rotating loader icon -->
    <Style Selector="Viewbox.spin">
        <Style.Animations>
            <Animation Duration="0:0:1" IterationCount="Infinite">
                <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0" /></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360" /></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- Game page (design §3) -->
    <Style Selector="TextBlock.heroName">
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="LetterSpacing" Value="-0.5" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Border.heroCover">
        <Setter Property="Width" Value="132" />
        <Setter Property="Height" Value="198" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="BoxShadow" Value="0 10 30 0 #66000000" />
    </Style>
    <Style Selector="Border.miniCover">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="39" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <!-- Fact chip (engine, store, version) -->
    <Style Selector="Border.factChip">
        <Setter Property="Height" Value="26" />
        <Setter Property="Padding" Value="9,0" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="Background" Value="{DynamicResource AppSurface2Brush}" />
        <Setter Property="TextElement.FontSize" Value="12" />
        <Setter Property="TextElement.FontWeight" Value="SemiBold" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource AppMutedBrush}" />
    </Style>
    <Style Selector="Border.factChip Path.icon">
        <Setter Property="Stroke" Value="{DynamicResource AppMutedBrush}" />
    </Style>
    <Style Selector="Border.factChip Path.brand">
        <Setter Property="Fill" Value="{DynamicResource AppMutedBrush}" />
    </Style>
    <!-- Installed pack block -->
    <Style Selector="Border.installedPack">
        <Setter Property="MaxWidth" Value="460" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Background" Value="{DynamicResource AppOkSoftBrush}" />
    </Style>
    <Style Selector="Border.installedPack.broken">
        <Setter Property="Background" Value="{DynamicResource AppWarnSoftBrush}" />
    </Style>
    <Style Selector="Border.installedPack Path.icon">
        <Setter Property="Stroke" Value="{DynamicResource AppOkBrush}" />
    </Style>
    <Style Selector="Border.installedPack.broken Path.icon">
        <Setter Property="Stroke" Value="{DynamicResource AppWarnBrush}" />
    </Style>
    <!-- While installing / uninstalling: accent tint, spinner, "step N of M", the step and a bar (design §4a) -->
    <Style Selector="Border.installedPack.operating">
        <Setter Property="Background" Value="{DynamicResource AppAccentSoftBrush}" />
        <Setter Property="MinWidth" Value="340" />
    </Style>
    <Style Selector="Border.installedPack.operating Path.icon">
        <Setter Property="Stroke" Value="{DynamicResource AppAccentBrush}" />
    </Style>
    <Style Selector="ProgressBar.installProgress">
        <Setter Property="MinHeight" Value="4" />
        <Setter Property="Height" Value="4" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
        <Setter Property="Background" Value="{DynamicResource AppBorderBrush}" />
    </Style>
    <Style Selector="Button.installedMenu">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.installedMenu Path.icon">
        <Setter Property="Stroke" Value="{DynamicResource AppMutedBrush}" />
    </Style>

    <!-- Toasts: bottom right of the window, over the page (design §4a) -->
    <Style Selector="Border.toast">
        <Setter Property="Width" Value="380" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BoxShadow" Value="0 12 32 0 #66000000" />
    </Style>
    <Style Selector="Border.toast Path.toastIcon">
        <Setter Property="Stroke" Value="{DynamicResource AppMutedBrush}" />
    </Style>
    <Style Selector="Border.toast.ok Path.toastIcon">
        <Setter Property="Stroke" Value="{DynamicResource AppOkBrush}" />
    </Style>
    <Style Selector="Border.toast.bad">
        <Setter Property="BorderBrush" Value="{DynamicResource AppBadBrush}" />
    </Style>
    <Style Selector="Border.toast.bad Path.toastIcon">
        <Setter Property="Stroke" Value="{DynamicResource AppBadBrush}" />
    </Style>

    <!-- Install confirmation: one line per risk; alpha / probably compatible in amber -->
    <Style Selector="Border.riskLine">
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Background" Value="{DynamicResource AppSurface2Brush}" />
    </Style>
    <Style Selector="Border.riskLine Path.icon">
        <Setter Property="Stroke" Value="{DynamicResource AppMutedBrush}" />
    </Style>
    <Style Selector="Border.riskLine.warn">
        <Setter Property="Background" Value="{DynamicResource AppWarnSoftBrush}" />
    </Style>
    <Style Selector="Border.riskLine.warn Path.icon">
        <Setter Property="Stroke" Value="{DynamicResource AppWarnBrush}" />
    </Style>
    <Style Selector="TextBox.log">
        <Setter Property="FontFamily" Value="Menlo, Consolas, DejaVu Sans Mono, monospace" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="MaxHeight" Value="200" />
    </Style>
    <!-- Primary action: large accent button; teal while generating -->
    <Style Selector="Button.primaryAction">
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.primaryAction.sm">
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <!-- Tab bar -->
    <Style Selector="Button.pageTab">
        <Setter Property="Height" Value="46" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="CornerRadius" Value="8,8,0,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0,0,0,2" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource AppMutedBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.pageTab:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppSurface2Brush}" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.pageTab.on">
        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
    </Style>
    <Style Selector="Button.pageTab.on:pointerover /template/ ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
    </Style>
    <Style Selector="Button.pageTab.soon">
        <Setter Property="Foreground" Value="{DynamicResource AppFaintBrush}" />
    </Style>
    <Style Selector="Button.pageTab TextBlock.counter">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource AppFaintBrush}" />
    </Style>
    <Style Selector="Button.pageTab.on TextBlock.counter">
        <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
    </Style>
    <Style Selector="Button.pageTab TextBlock.counter.gen">
        <Setter Property="Foreground" Value="{DynamicResource AppGenBrush}" />
    </Style>
    <Style Selector="Border.tabSoon">
        <Setter Property="Height" Value="20" />
        <Setter Property="Padding" Value="7,0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Background" Value="{DynamicResource AppSurface2Brush}" />
        <Setter Property="TextElement.FontSize" Value="11" />
        <Setter Property="TextElement.FontWeight" Value="Bold" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource AppFaintBrush}" />
    </Style>
    <Style Selector="Border.tabSoon Path.icon">
        <Setter Property="Stroke" Value="{DynamicResource AppFaintBrush}" />
    </Style>
    <!-- Coming-soon / empty illustration -->
    <Style Selector="Border.illustration">
        <Setter Property="Width" Value="96" />
        <Setter Property="Height" Value="96" />
        <Setter Property="CornerRadius" Value="26" />
        <Setter Property="Background" Value="{DynamicResource AppSurface2Brush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <!-- Packs tab (design §4): toolbar, list rows, details panel -->
    <Style Selector="Button.langPicker">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.langPicker Path.icon">
        <Setter Property="Stroke" Value="{DynamicResource AppMutedBrush}" />
    </Style>
    <Style Selector="Button.langItem">
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.langItem.on">
        <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Button.langItem TextBlock.count">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource AppFaintBrush}" />
    </Style>
    <Style Selector="TextBlock.capsLabel">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="LetterSpacing" Value="0.6" />
        <Setter Property="Foreground" Value="{DynamicResource AppFaintBrush}" />
    </Style>
    <Style Selector="Button.packRow">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.packRow:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppSurface2Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
    </Style>
    <Style Selector="Button.packRow.on">
        <Setter Property="Background" Value="{DynamicResource AppAccentSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
    </Style>
    <Style Selector="Button.packRow.on:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppAccentSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
    </Style>
    <Style Selector="Button.packRow.dim TextBlock.packTitle">
        <Setter Property="Foreground" Value="{DynamicResource AppMutedBrush}" />
    </Style>
    <Style Selector="TextBlock.packMeta">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource AppMutedBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- Icon + text in a status tone: .ok (verified, compatible), .warn (alpha, probably), .bad (incompatible), .muted -->
    <Style Selector="StackPanel.tone TextBlock">
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="StackPanel.tone.ok TextBlock"><Setter Property="Foreground" Value="{DynamicResource AppOkBrush}" /></Style>
    <Style Selector="StackPanel.tone.ok Path.icon"><Setter Property="Stroke" Value="{DynamicResource AppOkBrush}" /></Style>
    <Style Selector="StackPanel.tone.warn TextBlock"><Setter Property="Foreground" Value="{DynamicResource AppWarnBrush}" /></Style>
    <Style Selector="StackPanel.tone.warn Path.icon"><Setter Property="Stroke" Value="{DynamicResource AppWarnBrush}" /></Style>
    <Style Selector="StackPanel.tone.bad TextBlock"><Setter Property="Foreground" Value="{DynamicResource AppBadBrush}" /></Style>
    <Style Selector="StackPanel.tone.bad Path.icon"><Setter Property="Stroke" Value="{DynamicResource AppBadBrush}" /></Style>
    <Style Selector="StackPanel.tone.muted TextBlock"><Setter Property="Foreground" Value="{DynamicResource AppFaintBrush}" /></Style>
    <Style Selector="StackPanel.tone.muted Path.icon"><Setter Property="Stroke" Value="{DynamicResource AppFaintBrush}" /></Style>
    <Style Selector="StackPanel.likes TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource AppMutedBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="StackPanel.likes Path.icon"><Setter Property="Stroke" Value="{DynamicResource AppMutedBrush}" /></Style>
    <!-- Installed tag on a row (green), amber when an update broke the pack -->
    <Style Selector="Border.packTag">
        <Setter Property="Height" Value="22" />
        <Setter Property="Padding" Value="7,0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Background" Value="{DynamicResource AppOkSoftBrush}" />
        <Setter Property="TextElement.FontSize" Value="11" />
        <Setter Property="TextElement.FontWeight" Value="Bold" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource AppOkBrush}" />
    </Style>
    <Style Selector="Border.packTag Path.icon"><Setter Property="Stroke" Value="{DynamicResource AppOkBrush}" /></Style>
    <Style Selector="Border.packTag.warn">
        <Setter Property="Background" Value="{DynamicResource AppWarnSoftBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource AppWarnBrush}" />
    </Style>
    <Style Selector="Border.packTag.warn Path.icon"><Setter Property="Stroke" Value="{DynamicResource AppWarnBrush}" /></Style>
    <Style Selector="Border.packTag.installing">
        <Setter Property="Background" Value="{DynamicResource AppAccentSoftBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource AppAccentBrush}" />
    </Style>
    <Style Selector="Border.packTag.installing Path.icon"><Setter Property="Stroke" Value="{DynamicResource AppAccentBrush}" /></Style>
    <!-- Packs → Mine (task 55): a muted tag until tried, teal while creating -->
    <Style Selector="Border.packTag.muted">
        <Setter Property="Background" Value="{DynamicResource AppSurface3Brush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource AppMutedBrush}" />
    </Style>
    <Style Selector="Border.packTag.muted Path.icon"><Setter Property="Stroke" Value="{DynamicResource AppMutedBrush}" /></Style>
    <Style Selector="Border.packTag.gen">
        <Setter Property="Background" Value="{DynamicResource AppGenSoftBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource AppGenBrush}" />
    </Style>
    <Style Selector="Border.packTag.gen Path.icon"><Setter Property="Stroke" Value="{DynamicResource AppGenBrush}" /></Style>
    <Style Selector="Border.packDetails">
        <Setter Property="Padding" Value="20,18" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <!-- "Your rating" under the installed pack's actions (task 63) -->
    <Style Selector="Border.ratingBlock">
        <Setter Property="Padding" Value="0,12,0,0" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>
    <Style Selector="Border.ratingBlock TextBlock.bad">
        <Setter Property="Foreground" Value="{DynamicResource AppBadBrush}" />
    </Style>
    <!-- Tinted compatibility box: green / amber / red; neutral while checking -->
    <Style Selector="Border.compatBox">
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Background" Value="{DynamicResource AppSurface2Brush}" />
        <Setter Property="TextElement.FontSize" Value="13" />
    </Style>
    <Style Selector="Border.compatBox Path.icon"><Setter Property="Stroke" Value="{DynamicResource AppFaintBrush}" /></Style>
    <Style Selector="Border.compatBox.ok"><Setter Property="Background" Value="{DynamicResource AppOkSoftBrush}" /></Style>
    <Style Selector="Border.compatBox.ok Path.icon"><Setter Property="Stroke" Value="{DynamicResource AppOkBrush}" /></Style>
    <Style Selector="Border.compatBox.warn"><Setter Property="Background" Value="{DynamicResource AppWarnSoftBrush}" /></Style>
    <Style Selector="Border.compatBox.warn Path.icon"><Setter Property="Stroke" Value="{DynamicResource AppWarnBrush}" /></Style>
    <Style Selector="Border.compatBox.bad"><Setter Property="Background" Value="{DynamicResource AppBadSoftBrush}" /></Style>
    <Style Selector="Border.compatBox.bad Path.icon"><Setter Property="Stroke" Value="{DynamicResource AppBadBrush}" /></Style>
    <Style Selector="TextBlock.kvLabel">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource AppMutedBrush}" />
        <Setter Property="Margin" Value="0,0,18,0" />
    </Style>
    <Style Selector="TextBlock.kvValue">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="ProgressBar.coverage">
        <Setter Property="MinWidth" Value="90" />
        <Setter Property="Width" Value="90" />
        <Setter Property="Height" Value="4" />
        <Setter Property="MinHeight" Value="4" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Foreground" Value="{DynamicResource AppOkBrush}" />
        <Setter Property="Background" Value="{DynamicResource AppSurface3Brush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="StackPanel.staleList">
        <Setter Property="Opacity" Value="0.78" />
    </Style>

    <!-- Generation tab (design §6): five-step header, centred card, estimate tiles, agent cards, checks -->
    <Style Selector="Border.genStepIcon">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="CornerRadius" Value="15" />
        <Setter Property="Background" Value="{DynamicResource AppSurface3Brush}" />
    </Style>
    <Style Selector="Border.genStepIcon Path.icon"><Setter Property="Stroke" Value="{DynamicResource AppMutedBrush}" /></Style>
    <Style Selector="Border.genStepIcon.done"><Setter Property="Background" Value="{DynamicResource AppOkSoftBrush}" /></Style>
    <Style Selector="Border.genStepIcon.done Path.icon"><Setter Property="Stroke" Value="{DynamicResource AppOkBrush}" /></Style>
    <Style Selector="Border.genStepIcon.running"><Setter Property="Background" Value="{DynamicResource AppGenBrush}" /></Style>
    <Style Selector="Border.genStepIcon.running Path.icon"><Setter Property="Stroke" Value="#06222a" /></Style>
    <Style Selector="Border.genStepIcon.current"><Setter Property="Background" Value="{DynamicResource AppWarnSoftBrush}" /></Style>
    <Style Selector="Border.genStepIcon.current Path.icon"><Setter Property="Stroke" Value="{DynamicResource AppWarnBrush}" /></Style>
    <Style Selector="Border.genStepIcon.paused"><Setter Property="Background" Value="{DynamicResource AppGenSoftBrush}" /></Style>
    <Style Selector="Border.genStepIcon.paused Path.icon"><Setter Property="Stroke" Value="{DynamicResource AppGenBrush}" /></Style>
    <Style Selector="Border.genStepIcon.failed"><Setter Property="Background" Value="{DynamicResource AppBadSoftBrush}" /></Style>
    <Style Selector="Border.genStepIcon.failed Path.icon"><Setter Property="Stroke" Value="{DynamicResource AppBadBrush}" /></Style>
    <Style Selector="Border.genStepLine">
        <Setter Property="Height" Value="2" />
        <Setter Property="Background" Value="{DynamicResource AppBorderStrongBrush}" />
    </Style>
    <Style Selector="Border.genStepLine.done"><Setter Property="Background" Value="{DynamicResource AppOkBrush}" /><Setter Property="Opacity" Value="0.55" /></Style>
    <Style Selector="TextBlock.genStepName">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource AppMutedBrush}" />
    </Style>
    <Style Selector="TextBlock.genStepName.reached"><Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" /></Style>
    <Style Selector="Border.genCard">
        <Setter Property="Padding" Value="24,22" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="TextBlock.genTitle">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="LetterSpacing" Value="-0.3" />
    </Style>
    <Style Selector="Border.genTile">
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Background" Value="{DynamicResource AppSurface2Brush}" />
    </Style>
    <Style Selector="TextBlock.genTileValue">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="LetterSpacing" Value="-0.4" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="Border.genAgent">
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.genAgent.on">
        <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
        <Setter Property="Background" Value="{DynamicResource AppAccentSoftBrush}" />
    </Style>
    <Style Selector="TextBlock.faint">
        <Setter Property="Foreground" Value="{DynamicResource AppFaintBrush}" />
    </Style>
    <Style Selector="StackPanel.genStatus">
        <Setter Property="TextElement.FontSize" Value="13" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource AppMutedBrush}" />
    </Style>
    <Style Selector="StackPanel.genStatus Path.icon"><Setter Property="Stroke" Value="{DynamicResource AppMutedBrush}" /></Style>
    <Style Selector="StackPanel.genStatus.ok"><Setter Property="TextElement.Foreground" Value="{DynamicResource AppOkBrush}" /></Style>
    <Style Selector="StackPanel.genStatus.ok Path.icon"><Setter Property="Stroke" Value="{DynamicResource AppOkBrush}" /></Style>
    <Style Selector="StackPanel.genStatus.bad Path.icon"><Setter Property="Stroke" Value="{DynamicResource AppBadBrush}" /></Style>
    <Style Selector="StackPanel.genCheck">
        <Setter Property="TextElement.FontSize" Value="13" />
    </Style>
    <Style Selector="StackPanel.genCheck Path.icon"><Setter Property="Stroke" Value="{DynamicResource AppMutedBrush}" /></Style>
    <Style Selector="StackPanel.genCheck.ok Path.icon"><Setter Property="Stroke" Value="{DynamicResource AppOkBrush}" /></Style>
    <Style Selector="StackPanel.genCheck.bad"><Setter Property="TextElement.Foreground" Value="{DynamicResource AppMutedBrush}" /></Style>
    <Style Selector="StackPanel.genCheck.bad Path.icon"><Setter Property="Stroke" Value="{DynamicResource AppBadBrush}" /></Style>
    <Style Selector="StackPanel.genCheck.warning Path.icon"><Setter Property="Stroke" Value="{DynamicResource AppWarnBrush}" /></Style>
    <Style Selector="Border.genFoot">
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
        <Setter Property="Padding" Value="0,16,0,0" />
    </Style>
    <Style Selector="TextBlock.genPercent">
        <Setter Property="FontSize" Value="52" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="LetterSpacing" Value="-2" />
    </Style>
    <Style Selector="ProgressBar.genProgress">
        <Setter Property="Height" Value="12" />
        <Setter Property="MinHeight" Value="12" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Foreground" Value="{DynamicResource AppGenBrush}" />
        <Setter Property="Background" Value="{DynamicResource AppSurface3Brush}" />
    </Style>
    <!-- Generation progress (task 53, design §6b) -->
    <Style Selector="ProgressBar.genProgress.paused">
        <Setter Property="Opacity" Value="0.55" />
    </Style>
    <Style Selector="Border.genBanner">
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{DynamicResource AppGenSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppGenBrush}" />
    </Style>
    <Style Selector="Border.genBanner Path.bannerIcon"><Setter Property="Stroke" Value="{DynamicResource AppGenBrush}" /></Style>
    <Style Selector="Border.genBanner.warn">
        <Setter Property="Background" Value="{DynamicResource AppWarnSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppWarnBrush}" />
    </Style>
    <Style Selector="Border.genBanner.warn Path.bannerIcon"><Setter Property="Stroke" Value="{DynamicResource AppWarnBrush}" /></Style>
    <Style Selector="Border.genBanner.bad">
        <Setter Property="Background" Value="{DynamicResource AppBadSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBadBrush}" />
    </Style>
    <Style Selector="Border.genBanner.bad Path.bannerIcon"><Setter Property="Stroke" Value="{DynamicResource AppBadBrush}" /></Style>
    <!-- Generation result (task 55, design §6d) -->
    <Style Selector="Border.genDoneIcon">
        <Setter Property="Width" Value="52" />
        <Setter Property="Height" Value="52" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Background" Value="{DynamicResource AppOkSoftBrush}" />
    </Style>
    <Style Selector="Border.genBanner.share">
        <Setter Property="Background" Value="{DynamicResource AppAccentSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
    </Style>
    <Style Selector="Border.genBanner.share Path.bannerIcon"><Setter Property="Stroke" Value="{DynamicResource AppAccentBrush}" /></Style>
    <!-- Publish strip states (task 61, design §7): sending / CI running teal (the plain genBanner), failed red, published green -->
    <Style Selector="Border.genBanner.ok">
        <Setter Property="Background" Value="{DynamicResource AppOkSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppOkBrush}" />
    </Style>
    <Style Selector="Border.genBanner.ok Path.bannerIcon"><Setter Property="Stroke" Value="{DynamicResource AppOkBrush}" /></Style>
    <Style Selector="StackPanel.publishStep Path.icon"><Setter Property="Stroke" Value="{DynamicResource AppMutedBrush}" /></Style>
    <Style Selector="StackPanel.publishStep TextBlock"><Setter Property="Foreground" Value="{DynamicResource AppMutedBrush}" /></Style>
    <Style Selector="StackPanel.publishStep.done Path.icon"><Setter Property="Stroke" Value="{DynamicResource AppOkBrush}" /></Style>
    <Style Selector="StackPanel.publishStep.done TextBlock"><Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" /></Style>
    <Style Selector="StackPanel.publishStep.current Path.icon"><Setter Property="Stroke" Value="{DynamicResource AppGenBrush}" /></Style>
    <Style Selector="StackPanel.publishStep.current TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.meterBox">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppOkBrush}" />
    </Style>
    <Style Selector="Border.meterBox.on"><Setter Property="Background" Value="{DynamicResource AppOkBrush}" /></Style>
    <Style Selector="Border.meterBox Path.icon"><Setter Property="Stroke" Value="White" /></Style>
    <Style Selector="Border.recommended">
        <Setter Property="Padding" Value="7,1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="{DynamicResource AppAccentSoftBrush}" />
    </Style>
    <Style Selector="Border.recommended TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
    </Style>
    <Style Selector="TextBlock.resultValue">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Path.resultIcon"><Setter Property="Stroke" Value="{DynamicResource AppAccentBrush}" /></Style>
    <Style Selector="Path.resultIcon.ok"><Setter Property="Stroke" Value="{DynamicResource AppOkBrush}" /></Style>
    <Style Selector="Path.resultIcon.warn"><Setter Property="Stroke" Value="{DynamicResource AppWarnBrush}" /></Style>
    <!-- Teal (generation) buttons: the accent theme paints its template, so the template is restyled too -->
    <Style Selector="Button.genAction, Button.primaryAction.gen">
        <Setter Property="Background" Value="{DynamicResource AppGenBrush}" />
        <Setter Property="Foreground" Value="#0d1015" />
    </Style>
    <Style Selector="Button.genAction /template/ ContentPresenter#PART_ContentPresenter, Button.primaryAction.gen /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppGenBrush}" />
        <Setter Property="Foreground" Value="#0d1015" />
    </Style>
    <Style Selector="Button.genAction:pointerover, Button.primaryAction.gen:pointerover">
        <Setter Property="Opacity" Value="0.9" />
    </Style>
    <!-- Glossary review (task 54): a term left without a translation -->
    <Style Selector="TextBox.invalid">
        <Setter Property="BorderBrush" Value="{DynamicResource AppBadBrush}" />
    </Style>
    <Style Selector="Border.genBox">
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Background" Value="{DynamicResource AppSurface2Brush}" />
    </Style>
    <Style Selector="TextBlock.genKey">
        <Setter Property="FontFamily" Value="Menlo, Consolas, DejaVu Sans Mono, monospace" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource AppFaintBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="Border.genWarnTag">
        <Setter Property="Padding" Value="6,1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Background" Value="{DynamicResource AppWarnSoftBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource AppWarnBrush}" />
        <Setter Property="TextElement.FontSize" Value="11" />
        <Setter Property="TextElement.FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.genWarnTag Path.icon"><Setter Property="Stroke" Value="{DynamicResource AppWarnBrush}" /></Style>
    <Style Selector="Path.genWarnIcon"><Setter Property="Stroke" Value="{DynamicResource AppWarnBrush}" /></Style>
    <Style Selector="Ellipse.genLiveDot">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
        <Setter Property="Fill" Value="{DynamicResource AppGenBrush}" />
        <Style.Animations>
            <Animation Duration="0:0:1.4" IterationCount="Infinite">
                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
                <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.3" /></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="ProgressBar.genLimit">
        <Setter Property="Height" Value="6" />
        <Setter Property="MinHeight" Value="6" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Foreground" Value="{DynamicResource AppGenBrush}" />
        <Setter Property="Background" Value="{DynamicResource AppSurface3Brush}" />
    </Style>
    <Style Selector="ProgressBar.genLimit.reached">
        <Setter Property="Foreground" Value="{DynamicResource AppWarnBrush}" />
    </Style>
</Styles>
