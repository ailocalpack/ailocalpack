<!-- ailocalpack theme on top of Fluent: neutral surfaces, one accent, dark + light (tokens from design/drafts). -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0d1015" />
            <SolidColorBrush x:Key="AppSurfaceBrush" Color="#151922" />
            <SolidColorBrush x:Key="AppSurface2Brush" Color="#1c2230" />
            <SolidColorBrush x:Key="AppBorderBrush" Color="#14ffffff" />
            <SolidColorBrush x:Key="AppTextBrush" Color="#e9edf4" />
            <SolidColorBrush x:Key="AppMutedBrush" Color="#9aa4b6" />
            <SolidColorBrush x:Key="AppAccentBrush" Color="#7b8cff" />
            <SolidColorBrush x:Key="AppAccentFillBrush" Color="#5566f0" />
            <SolidColorBrush x:Key="AppAccentSoftBrush" Color="#297b8cff" />
            <SolidColorBrush x:Key="AppSurface3Brush" Color="#252c3c" />
            <SolidColorBrush x:Key="AppBorderStrongBrush" Color="#29ffffff" />
            <SolidColorBrush x:Key="AppFaintBrush" Color="#6b7487" />
            <SolidColorBrush x:Key="AppWarnBrush" Color="#f0b44c" />
            <SolidColorBrush x:Key="AppBadBrush" Color="#ef6b6b" />
            <SolidColorBrush x:Key="AppHighlightBrush" Color="#4df0b44c" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#f4f6fa" />
            <SolidColorBrush x:Key="AppSurfaceBrush" Color="#ffffff" />
            <SolidColorBrush x:Key="AppSurface2Brush" Color="#eef1f6" />
            <SolidColorBrush x:Key="AppBorderBrush" Color="#170f172a" />
            <SolidColorBrush x:Key="AppTextBrush" Color="#141a26" />
            <SolidColorBrush x:Key="AppMutedBrush" Color="#556075" />
            <SolidColorBrush x:Key="AppAccentBrush" Color="#4152e0" />
            <SolidColorBrush x:Key="AppAccentFillBrush" Color="#4152e0" />
            <SolidColorBrush x:Key="AppAccentSoftBrush" Color="#1a4152e0" />
            <SolidColorBrush x:Key="AppSurface3Brush" Color="#e2e7ef" />
            <SolidColorBrush x:Key="AppBorderStrongBrush" Color="#2e0f172a" />
            <SolidColorBrush x:Key="AppFaintBrush" Color="#7d879a" />
            <SolidColorBrush x:Key="AppWarnBrush" Color="#9a6200" />
            <SolidColorBrush x:Key="AppBadBrush" Color="#c23434" />
            <SolidColorBrush x:Key="AppHighlightBrush" Color="#4dc48000" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <LinearGradientBrush x:Key="AppLogoBrush" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="#5566f0" />
        <GradientStop Offset="1" Color="#9a5cf0" />
    </LinearGradientBrush>

    <!-- Lucide icons (ISC), drawn as strokes -->
    <StreamGeometry x:Key="IconBell">M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9 M10.3 21a1.94 1.94 0 0 0 3.4 0</StreamGeometry>
    <StreamGeometry x:Key="IconSettings">M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z M15 12a3 3 0 1 1-6 0a3 3 0 0 1 6 0z</StreamGeometry>
    <StreamGeometry x:Key="IconSearch">M19 11a8 8 0 1 1-16 0a8 8 0 0 1 16 0z M21 21l-4.3-4.3</StreamGeometry>
    <StreamGeometry x:Key="IconSliders">M4 21v-7 M4 10V3 M12 21v-9 M12 8V3 M20 21v-5 M20 12V3 M2 14h4 M10 8h4 M18 16h4</StreamGeometry>
    <StreamGeometry x:Key="IconFolder">M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2z</StreamGeometry>
    <StreamGeometry x:Key="IconBot">M12 8V4H8 M6 8h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2z M2 14h2 M20 14h2 M15 13v2 M9 13v2</StreamGeometry>
    <StreamGeometry x:Key="IconGitHub">M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65S8.93 17.38 9 18v4 M9 18c-4.51 2-5-2-7-2</StreamGeometry>
    <StreamGeometry x:Key="IconHardDrive">M22 12H2 M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z M6 16h.01 M10 16h.01</StreamGeometry>
    <StreamGeometry x:Key="IconInfo">M22 12a10 10 0 1 1-20 0a10 10 0 0 1 20 0z M12 16v-4 M12 8h.01</StreamGeometry>
</ResourceDictionary>
