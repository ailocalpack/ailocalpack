<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AiLocalPack.Desktop.ViewModels"
             xmlns:views="using:AiLocalPack.Desktop.Views"
             xmlns:add="using:AiLocalPack.Desktop.ViewModels.AddGame"
             xmlns:dialogs="using:AiLocalPack.Desktop.Dialogs"
             xmlns:startup="using:AiLocalPack.Desktop.Startup"
             x:Class="AiLocalPack.Desktop.App"
             RequestedThemeVariant="Default">
    <!-- RequestedThemeVariant="Default" follows the OS theme, live; SettingsApplier sets it from Settings → General → Theme. -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://AiLocalPack/Styles/Theme.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Light" Accent="#4152e0" RegionColor="#ffffff" />
                <ColorPaletteResources x:Key="Dark" Accent="#5566f0" RegionColor="#151922" />
            </FluentTheme.Palettes>
        </FluentTheme>
        <StyleInclude Source="avares://AiLocalPack/Styles/Controls.axaml" />
    </Application.Styles>

    <!-- View-model-first navigation: each page view model maps to its view here (no reflection). -->
    <Application.DataTemplates>
        <DataTemplate DataType="vm:LibraryViewModel"><views:LibraryView /></DataTemplate>
        <DataTemplate DataType="vm:GamePageViewModel"><views:GamePageView /></DataTemplate>
        <DataTemplate DataType="vm:SettingsViewModel"><views:SettingsView /></DataTemplate>
        <!-- Dialogs, shown over the window by IDialogService -->
        <DataTemplate DataType="add:AddGameDialogViewModel"><views:AddGameDialogView /></DataTemplate>
        <DataTemplate DataType="dialogs:ConfirmDialogViewModel"><views:ConfirmDialogView /></DataTemplate>
        <!-- Startup checklist rows (splash details, startup checks under the bell) -->
        <DataTemplate DataType="startup:StartupStep"><views:StartupStepView /></DataTemplate>
    </Application.DataTemplates>
</Application>
