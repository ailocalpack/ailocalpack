<Project>
  <PropertyGroup>
    <!-- Allows pinning vulnerable transitive dependencies to patched versions below -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="UI">
    <PackageVersion Include="Avalonia" Version="12.1.5" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.5" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.5" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.5" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- Linux notifications over D-Bus: the same library and version Avalonia.FreeDesktop brings in -->
    <PackageVersion Include="Tmds.DBus.Protocol" Version="0.94.1" />
  </ItemGroup>

  <ItemGroup Label="Hosting and logging">
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup Label="CLI">
    <PackageVersion Include="System.CommandLine" Version="2.0.14" />
  </ItemGroup>

  <ItemGroup Label="Game formats">
    <PackageVersion Include="AssetsTools.NET" Version="3.0.5" />
    <PackageVersion Include="AssetsTools.NET.MonoCecil" Version="3.0.4" />
    <PackageVersion Include="CUE4Parse" Version="1.2.2.202611" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="Avalonia.Headless" Version="12.1.5" />
    <PackageVersion Include="JsonSchema.Net" Version="9.6.0" />
  </ItemGroup>

  <!-- Transitive dependency pins (security fixes) -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Bcl.Memory" Version="9.0.14" />
  </ItemGroup>
</Project>
